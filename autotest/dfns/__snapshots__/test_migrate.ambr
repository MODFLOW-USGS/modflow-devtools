  type = "keyword"
  
  [children.prt-nam.children.prt-dis.blocks.options.grb_filerecord]
  block = "options"
  reader = "urword"
  optional = true
  type = "record"
  
  [children.prt-nam.children.prt-dis.blocks.options.grb_filerecord.children.grb6]
  block = "options"
  description = "keyword to specify that record corresponds to a binary grid file."
  reader = "urword"
  optional = false
  longname = "grb keyword"
  type = "keyword"
  
  [children.prt-nam.children.prt-dis.blocks.options.grb_filerecord.children.fileout]
  block = "options"
  description = "keyword to specify that an output filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.prt-nam.children.prt-dis.blocks.options.grb_filerecord.children.grb6_filename]
  block = "options"
