  type = "record temperature fileout temperaturefile"
  reader = "urword"
  optional = true
  tagged = true
  mf6internal = "tempfilerec"
  
  [options.temperatureprintrecord]
  block = "options"
  type = "record temperature print_format formatrecord"
  reader = "urword"
  optional = true
  mf6internal = "tempprintrec"
  
  [period]
  transient_block = true
  
  [period.saverecord]
  block = "period"
  type = "record save rtype ocsetting"
  reader = "urword"
  optional = true
  tagged = false
  
  [period.printrecord]
  block = "period"
  type = "record print rtype ocsetting"
  reader = "urword"
  optional = true
  tagged = false
  
