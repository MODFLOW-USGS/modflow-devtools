        "fields": {
          "filein": {
            "block": "options",
            "type": "keyword",
            "reader": "urword",
            "optional": false,
            "longname": "file keyword",
            "description": "keyword to specify that an input filename is expected next.",
            "in_record": true,
            "tagged": true
          },
          "obs6": {
            "block": "options",
            "type": "keyword",
            "reader": "urword",
            "optional": false,
