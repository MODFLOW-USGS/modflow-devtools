                  "reader": "urword",
                  "optional": true,
                  "type": "record",
                  "children": {
                    "obs6": {
                      "block": "options",
                      "description": "keyword to specify that record corresponds to an observations file.",
                      "reader": "urword",
                      "optional": false,
                      "longname": "obs keyword",
                      "type": "keyword"
                    },
                    "filein": {
