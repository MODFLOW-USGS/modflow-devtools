          "key": "tas_filerecord",
          "val": "timearrayseries",
          "abbr": "tas",
          "param": "tas_array"
        }
      },
      "obs_filerecord": {
        "block": "options",
        "type": "record",
        "reader": "urword",
        "optional": true,
        "tagged": true,
        "fields": {
          "filein": {
            "block": "options",
            "type": "keyword",
            "reader": "urword",
            "optional": false,
            "longname": "file keyword",
            "description": "keyword to specify that an input filename is expected next.",
            "in_record": true,
            "tagged": true
          },
          "obs6": {
            "block": "options",
            "type": "keyword",
            "reader": "urword",
            "optional": false,
            "longname": "obs keyword",
            "description": "keyword to specify that record corresponds to an observations file.",
            "in_record": true,
            "tagged": true
          },
          "obs6_filename": {
            "block": "options",
            "type": "string",
