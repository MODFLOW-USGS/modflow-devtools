  [children.olf-nam.children.olf-dis2d]
  name = "olf-dis2d"
  schema_version = "1.2"
  parent = "olf-nam"
  advanced = false
  multi = false
  ftype = "DIS2D"
  
  [children.olf-nam.children.olf-dis2d.blocks.options.length_units]
  block = "options"
  description = "is the length units used for this model.  Values can be 'FEET', 'METERS', or 'CENTIMETERS'.  If not specified, the default is 'UNKNOWN'."
  reader = "urword"
  optional = true
  longname = "model length units"
  type = "string"
  
  [children.olf-nam.children.olf-dis2d.blocks.options.nogrb]
  block = "options"
  description = "keyword to deactivate writing of the binary grid file."
  reader = "urword"
  optional = true
  longname = "do not write binary grid file"
  type = "keyword"
  
  [children.olf-nam.children.olf-dis2d.blocks.options.grb_filerecord]
  block = "options"
  reader = "urword"
  optional = true
  type = "record"
  
  [children.olf-nam.children.olf-dis2d.blocks.options.grb_filerecord.children.grb6]
  block = "options"
  description = "keyword to specify that record corresponds to a binary grid file."
  reader = "urword"
  optional = false
  longname = "grb keyword"
  type = "keyword"
  
  [children.olf-nam.children.olf-dis2d.blocks.options.grb_filerecord.children.fileout]
  block = "options"
  description = "keyword to specify that an output filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.olf-nam.children.olf-dis2d.blocks.options.grb_filerecord.children.grb6_filename]
  block = "options"
  description = "defines a binary grid output file. If this option is not provided, the output file will have the same name as the discretization input file, plus extension '.grb'."
  reader = "urword"
  optional = false
  longname = "file name of GRB information"
  type = "string"
  
  [children.olf-nam.children.olf-dis2d.blocks.options.grb6]
  block = "options"
  description = "keyword to specify that record corresponds to a binary grid file."
  reader = "urword"
  optional = false
  longname = "grb keyword"
  type = "keyword"
  
  [children.olf-nam.children.olf-dis2d.blocks.options.fileout]
  block = "options"
  description = "keyword to specify that an output filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.olf-nam.children.olf-dis2d.blocks.options.grb6_filename]
  block = "options"
  description = "defines a binary grid output file. If this option is not provided, the output file will have the same name as the discretization input file, plus extension '.grb'."
  reader = "urword"
  optional = false
  longname = "file name of GRB information"
  type = "string"
  
  [children.olf-nam.children.olf-dis2d.blocks.options.xorigin]
  block = "options"
  description = "x-position of the lower-left corner of the model grid.  A default value of zero is assigned if not specified.  The value for XORIGIN does not affect the model simulation, but it is written to the binary grid file so that postprocessors can locate the grid in space."
  reader = "urword"
  optional = true
  longname = "x-position of the model grid origin"
  type = "double"
  
  [children.olf-nam.children.olf-dis2d.blocks.options.yorigin]
  block = "options"
  description = "y-position of the lower-left corner of the model grid.  If not specified, then a default value equal to zero is used.  The value for YORIGIN does not affect the model simulation, but it is written to the binary grid file so that postprocessors can locate the grid in space."
  reader = "urword"
  optional = true
  longname = "y-position of the model grid origin"
  type = "double"
  
  [children.olf-nam.children.olf-dis2d.blocks.options.angrot]
  block = "options"
  description = "counter-clockwise rotation angle (in degrees) of the lower-left corner of the model grid.  If not specified, then a default value of 0.0 is assigned.  The value for ANGROT does not affect the model simulation, but it is written to the binary grid file so that postprocessors can locate the grid in space."
  reader = "urword"
  optional = true
  longname = "rotation angle"
  type = "double"
  
  [children.olf-nam.children.olf-dis2d.blocks.options.export_array_ascii]
  block = "options"
  description = "keyword that specifies input griddata arrays should be written to layered ascii output files."
  reader = "urword"
  optional = true
  mf6internal = "export_ascii"
  longname = "export array variables to layered ascii files."
  type = "keyword"
  
  [children.olf-nam.children.olf-dis2d.blocks.options.crs]
  shape = "lenbigline"
  block = "options"
  description = "is a real-world coordinate reference system (CRS) for the model, for example, an EPSG integer code (e.g. 26915), authority string (i.e. epsg:26915), or Open Geospatial Consortium Well-Known Text (WKT) specification. Limited to 5000 characters. The entry for CRS does not affect the model simulation, but it is written to the binary grid file so that postprocessors can locate the grid in space."
  reader = "urword"
  optional = true
  developmode = true
  longname = "CRS user input string"
  type = "string"
  
  [children.olf-nam.children.olf-dis2d.blocks.dimensions.nrow]
  block = "dimensions"
  description = "is the number of rows in the model grid."
  default = "2"
  reader = "urword"
  optional = false
  longname = "number of rows"
  type = "integer"
  
  [children.olf-nam.children.olf-dis2d.blocks.dimensions.ncol]
  block = "dimensions"
  description = "is the number of columns in the model grid."
  default = "2"
  reader = "urword"
  optional = false
  longname = "number of columns"
  type = "integer"
  
  [children.olf-nam.children.olf-dis2d.blocks.griddata.delr]
  shape = "(ncol)"
  block = "griddata"
  description = "is the column spacing in the row direction."
  default = "1.0"
  reader = "readarray"
  longname = "spacing along a row"
  type = "double"
  
  [children.olf-nam.children.olf-dis2d.blocks.griddata.delc]
  shape = "(nrow)"
  block = "griddata"
  description = "is the row spacing in the column direction."
  default = "1.0"
  reader = "readarray"
  longname = "spacing along a column"
  type = "double"
  
  [children.olf-nam.children.olf-dis2d.blocks.griddata.bottom]
  shape = "(ncol, nrow)"
  block = "griddata"
  description = "is the bottom elevation for each cell."
  default = "0."
  reader = "readarray"
  layered = false
  longname = "cell bottom elevation"
  type = "double"
  
  [children.olf-nam.children.olf-dis2d.blocks.griddata.idomain]
  shape = "(ncol, nrow)"
  block = "griddata"
  description = "is an optional array that characterizes the existence status of a cell.  If the IDOMAIN array is not specified, then all model cells exist within the solution.  If the IDOMAIN value for a cell is 0, the cell does not exist in the simulation.  Input and output values will be read and written for the cell, but internal to the program, the cell is excluded from the solution.  If the IDOMAIN value for a cell is 1, the cell exists in the simulation.  If the IDOMAIN value for a cell is -1, the cell does not exist in the simulation.  Furthermore, the first existing cell above will be connected to the first existing cell below.  This type of cell is referred to as a 'vertical pass through' cell."
  reader = "readarray"
  layered = false
  optional = true
  longname = "idomain existence array"
  type = "integer"
  
  [children.olf-nam.children.olf-cxs]
  name = "olf-cxs"
  schema_version = "1.2"
  parent = "olf-nam"
  advanced = false
  multi = false
  ftype = "CXS"
  
  [children.olf-nam.children.olf-cxs.blocks.options.print_input]
  block = "options"
  description = "keyword to indicate that the list of stream reach information will be written to the listing file immediately after it is read."
  reader = "urword"
  optional = true
  longname = "print input to listing file"
  mf6internal = "iprpak"
  type = "keyword"
  
  [children.olf-nam.children.olf-cxs.blocks.dimensions.nsections]
  block = "dimensions"
  description = "integer value specifying the number of cross sections that will be defined.  There must be NSECTIONS entries in the PACKAGEDATA block."
  reader = "urword"
  optional = false
  longname = "number of reaches"
  type = "integer"
  
  [children.olf-nam.children.olf-cxs.blocks.dimensions.npoints]
  block = "dimensions"
  description = "integer value specifying the total number of cross-section points defined for all reaches.  There must be NPOINTS entries in the CROSSSECTIONDATA block."
  reader = "urword"
  optional = false
  longname = "total number of points defined for all reaches"
  type = "integer"
  
  [children.olf-nam.children.olf-cxs.blocks.packagedata.packagedata]
  shape = "(nsections)"
  block = "packagedata"
  reader = "urword"
  type = "list"
  
  [children.olf-nam.children.olf-cxs.blocks.packagedata.packagedata.children.packagedata]
  shape = "(nsections)"
  block = "packagedata"
  reader = "urword"
  type = "record"
  
  [children.olf-nam.children.olf-cxs.blocks.packagedata.packagedata.children.packagedata.children.idcxs]
  block = "packagedata"
  description = "integer value that defines the cross section number associated with the specified PACKAGEDATA data on the line. IDCXS must be greater than zero and less than or equal to NSECTIONS. Information must be specified for every section or the program will terminate with an error.  The program will also terminate with an error if information for a section is specified more than once."
  reader = "urword"
  longname = "reach number for this entry"
  numeric_index = true
  type = "integer"
  
  [children.olf-nam.children.olf-cxs.blocks.packagedata.packagedata.children.packagedata.children.nxspoints]
  block = "packagedata"
  description = "integer value that defines the number of points used to define the define the shape of a section.  NXSPOINTS must be greater than zero or the program will terminate with an error.  NXSPOINTS defines the number of points that must be entered for the reach in the CROSSSECTIONDATA block.  The sum of NXSPOINTS for all sections must equal the NPOINTS dimension."
  reader = "urword"
  longname = "number of points used to define cross section"
  type = "integer"
  
  [children.olf-nam.children.olf-cxs.blocks.packagedata.idcxs]
  block = "packagedata"
  description = "integer value that defines the cross section number associated with the specified PACKAGEDATA data on the line. IDCXS must be greater than zero and less than or equal to NSECTIONS. Information must be specified for every section or the program will terminate with an error.  The program will also terminate with an error if information for a section is specified more than once."
  reader = "urword"
  longname = "reach number for this entry"
  numeric_index = true
  type = "integer"
  
  [children.olf-nam.children.olf-cxs.blocks.packagedata.nxspoints]
  block = "packagedata"
  description = "integer value that defines the number of points used to define the define the shape of a section.  NXSPOINTS must be greater than zero or the program will terminate with an error.  NXSPOINTS defines the number of points that must be entered for the reach in the CROSSSECTIONDATA block.  The sum of NXSPOINTS for all sections must equal the NPOINTS dimension."
  reader = "urword"
  longname = "number of points used to define cross section"
  type = "integer"
  
  [children.olf-nam.children.olf-cxs.blocks.crosssectiondata.crosssectiondata]
  shape = "(npoints)"
  block = "crosssectiondata"
  reader = "urword"
  type = "list"
  
  [children.olf-nam.children.olf-cxs.blocks.crosssectiondata.crosssectiondata.children.crosssectiondata]
  shape = "(npoints)"
  block = "crosssectiondata"
  reader = "urword"
  type = "record"
  
  [children.olf-nam.children.olf-cxs.blocks.crosssectiondata.crosssectiondata.children.crosssectiondata.children.xfraction]
  block = "crosssectiondata"
  description = "real value that defines the station (x) data for the cross-section as a fraction of the width (WIDTH) of the reach. XFRACTION must be greater than or equal to zero but can be greater than one. XFRACTION values can be used to decrease or increase the width of a reach from the specified reach width (WIDTH)."
  reader = "urword"
  longname = "fractional width"
  type = "double"
  
  [children.olf-nam.children.olf-cxs.blocks.crosssectiondata.crosssectiondata.children.crosssectiondata.children.height]
  block = "crosssectiondata"
  description = "real value that is the height relative to the top of the lowest elevation of the streambed (ELEVATION) and corresponding to the station data on the same line. HEIGHT must be greater than or equal to zero and at least one cross-section height must be equal to zero."
  reader = "urword"
  longname = "depth"
  type = "double"
  
  [children.olf-nam.children.olf-cxs.blocks.crosssectiondata.crosssectiondata.children.crosssectiondata.children.manfraction]
  block = "crosssectiondata"
  description = "real value that defines the Manning's roughness coefficient data for the cross-section as a fraction of the Manning's roughness coefficient for the reach (MANNINGSN) and corresponding to the station data on the same line. MANFRACTION must be greater than zero. MANFRACTION is applied from the XFRACTION value on the same line to the XFRACTION value on the next line."
  reader = "urword"
  optional = false
  longname = "Manning's roughness coefficient"
  type = "double"
  
  [children.olf-nam.children.olf-cxs.blocks.crosssectiondata.xfraction]
  block = "crosssectiondata"
  description = "real value that defines the station (x) data for the cross-section as a fraction of the width (WIDTH) of the reach. XFRACTION must be greater than or equal to zero but can be greater than one. XFRACTION values can be used to decrease or increase the width of a reach from the specified reach width (WIDTH)."
  reader = "urword"
  longname = "fractional width"
  type = "double"
  
  [children.olf-nam.children.olf-cxs.blocks.crosssectiondata.height]
  block = "crosssectiondata"
  description = "real value that is the height relative to the top of the lowest elevation of the streambed (ELEVATION) and corresponding to the station data on the same line. HEIGHT must be greater than or equal to zero and at least one cross-section height must be equal to zero."
  reader = "urword"
  longname = "depth"
  type = "double"
  
  [children.olf-nam.children.olf-cxs.blocks.crosssectiondata.manfraction]
  block = "crosssectiondata"
  description = "real value that defines the Manning's roughness coefficient data for the cross-section as a fraction of the Manning's roughness coefficient for the reach (MANNINGSN) and corresponding to the station data on the same line. MANFRACTION must be greater than zero. MANFRACTION is applied from the XFRACTION value on the same line to the XFRACTION value on the next line."
  reader = "urword"
  optional = false
  longname = "Manning's roughness coefficient"
  type = "double"
  
  [children.olf-nam.children.olf-pcp]
  name = "olf-pcp"
  schema_version = "1.2"
  parent = "olf-nam"
  advanced = false
  multi = true
  ftype = "PCP"
  
  [children.olf-nam.children.olf-pcp.blocks.options.auxiliary]
  shape = "(naux)"
  block = "options"
  description = "defines an array of one or more auxiliary variable names.  There is no limit on the number of auxiliary variables that can be provided on this line; however, lists of information provided in subsequent blocks must have a column of data for each auxiliary variable name defined here.   The number of auxiliary variables detected on this line determines the value for naux.  Comments cannot be provided anywhere on this line as they will be interpreted as auxiliary variable names.  Auxiliary variables may not be used by the package, but they will be available for use by other parts of the program.  The program will terminate with an error if auxiliary variables are specified on more than one line in the options block."
  reader = "urword"
  optional = true
  longname = "keyword to specify aux variables"
  type = "string"
  
  [children.olf-nam.children.olf-pcp.blocks.options.auxmultname]
  block = "options"
  description = "name of auxiliary variable to be used as multiplier of precipitation."
  reader = "urword"
  optional = true
  longname = "name of auxiliary variable for multiplier"
  type = "string"
  
  [children.olf-nam.children.olf-pcp.blocks.options.boundnames]
  block = "options"
  description = "keyword to indicate that boundary names may be provided with the list of precipitation cells."
  reader = "urword"
  optional = true
  type = "keyword"
  
  [children.olf-nam.children.olf-pcp.blocks.options.print_input]
  block = "options"
  description = "keyword to indicate that the list of precipitation information will be written to the listing file immediately after it is read."
  reader = "urword"
  optional = true
  longname = "print input to listing file"
  mf6internal = "iprpak"
  type = "keyword"
  
  [children.olf-nam.children.olf-pcp.blocks.options.print_flows]
  block = "options"
  description = "keyword to indicate that the list of precipitation flow rates will be printed to the listing file for every stress period time step in which 'BUDGET PRINT' is specified in Output Control.  If there is no Output Control option and 'PRINT_FLOWS' is specified, then flow rates are printed for the last time step of each stress period."
  reader = "urword"
  optional = true
  longname = "print precipitation rates to listing file"
  mf6internal = "iprflow"
  type = "keyword"
  
  [children.olf-nam.children.olf-pcp.blocks.options.save_flows]
  block = "options"
  description = "keyword to indicate that precipitation flow terms will be written to the file specified with 'BUDGET FILEOUT' in Output Control."
  reader = "urword"
  optional = true
  longname = "save precipitation to budget file"
  mf6internal = "ipakcb"
  type = "keyword"
  
  [children.olf-nam.children.olf-pcp.blocks.options.ts_filerecord]
  block = "options"
  reader = "urword"
  optional = true
  type = "record"
  
  [children.olf-nam.children.olf-pcp.blocks.options.ts_filerecord.children.ts6]
  block = "options"
  description = "keyword to specify that record corresponds to a time-series file."
  reader = "urword"
  optional = false
  longname = "head keyword"
  type = "keyword"
  
  [children.olf-nam.children.olf-pcp.blocks.options.ts_filerecord.children.filein]
  block = "options"
  description = "keyword to specify that an input filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.olf-nam.children.olf-pcp.blocks.options.ts_filerecord.children.ts6_filename]
  block = "options"
  description = "defines a time-series file defining time series that can be used to assign time-varying values. See the 'Time-Variable Input' section for instructions on using the time-series capability."
  reader = "urword"
  optional = false
  longname = "file name of time series information"
  type = "string"
  
  [children.olf-nam.children.olf-pcp.blocks.options.ts6]
  block = "options"
  description = "keyword to specify that record corresponds to a time-series file."
  reader = "urword"
  optional = false
  longname = "head keyword"
  type = "keyword"
  
  [children.olf-nam.children.olf-pcp.blocks.options.filein]
  block = "options"
  description = "keyword to specify that an input filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.olf-nam.children.olf-pcp.blocks.options.ts6_filename]
  block = "options"
  description = "defines a time-series file defining time series that can be used to assign time-varying values. See the 'Time-Variable Input' section for instructions on using the time-series capability."
  reader = "urword"
  optional = false
  longname = "file name of time series information"
  type = "string"
  
  [children.olf-nam.children.olf-pcp.blocks.options.obs_filerecord]
  block = "options"
  reader = "urword"
  optional = true
  type = "record"
  
  [children.olf-nam.children.olf-pcp.blocks.options.obs_filerecord.children.obs6]
  block = "options"
  description = "keyword to specify that record corresponds to an observations file."
  reader = "urword"
  optional = false
  longname = "obs keyword"
  type = "keyword"
  
  [children.olf-nam.children.olf-pcp.blocks.options.obs_filerecord.children.filein]
  block = "options"
  description = "keyword to specify that an input filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.olf-nam.children.olf-pcp.blocks.options.obs_filerecord.children.obs6_filename]
  block = "options"
  description = "name of input file to define observations for the PCP package. See the 'Observation utility' section for instructions for preparing observation input files. Table {#2} lists observation type(s) supported by the PCP package."
  reader = "urword"
  optional = false
  longname = "obs6 input filename"
  type = "string"
  
  [children.olf-nam.children.olf-pcp.blocks.options.obs6]
  block = "options"
  description = "keyword to specify that record corresponds to an observations file."
  reader = "urword"
  optional = false
  longname = "obs keyword"
  type = "keyword"
  
  [children.olf-nam.children.olf-pcp.blocks.options.obs6_filename]
  block = "options"
  description = "name of input file to define observations for the PCP package. See the 'Observation utility' section for instructions for preparing observation input files. Table {#2} lists observation type(s) supported by the PCP package."
  reader = "urword"
  optional = false
  longname = "obs6 input filename"
  type = "string"
  
  [children.olf-nam.children.olf-pcp.blocks.dimensions.maxbound]
  block = "dimensions"
  description = "integer value specifying the maximum number of precipitation cells that will be specified for use during any stress period."
  reader = "urword"
  optional = false
  longname = "maximum number of precipitation cells"
  type = "integer"
  
  [children.olf-nam.children.olf-pcp.blocks.period.iper]
  shape = "(nper, nnodes)"
  block = "period"
  description = "integer value specifying the starting stress period number for which the data specified in the PERIOD block apply.  IPER must be less than or equal to NPER in the TDIS Package and greater than zero.  The IPER value assigned to a stress period block must be greater than the IPER value assigned for the previous PERIOD block.  The information specified in the PERIOD block will continue to apply for all subsequent stress periods, unless the program encounters another PERIOD block."
  block_variable = true
  reader = "urword"
  optional = false
  longname = "stress period number"
  type = "integer"
  
  [children.olf-nam.children.olf-pcp.blocks.period.stress_period_data]
  shape = "(nper, nnodes)"
  block = "period"
  reader = "urword"
  mf6internal = "spd"
  type = "list"
  
  [children.olf-nam.children.olf-pcp.blocks.period.stress_period_data.children.stress_period_data]
  shape = "(maxbound)"
  block = "period"
  reader = "urword"
  mf6internal = "spd"
  type = "record"
  
  [children.olf-nam.children.olf-pcp.blocks.period.stress_period_data.children.stress_period_data.children.cellid]
  shape = "(ncelldim)"
  block = "period"
  description = "is the cell identifier, and depends on the type of grid that is used for the simulation.  For a structured grid that uses the DIS input file, CELLID is the layer, row, and column.   For a grid that uses the DISV input file, CELLID is the layer and CELL2D number.  If the model uses the unstructured discretization (DISU) input file, CELLID is the node number for the cell."
  reader = "urword"
  longname = "cell identifier"
  type = "integer"
  
  [children.olf-nam.children.olf-pcp.blocks.period.stress_period_data.children.stress_period_data.children.precipitation]
  block = "period"
  description = "is the precipitation flux rate ($LT^{-1}$).  This rate is multiplied inside the program by the surface area of the cell to calculate the volumetric precipitation rate. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "precipitation rate"
  type = "double"
  
  [children.olf-nam.children.olf-pcp.blocks.period.stress_period_data.children.stress_period_data.children.aux]
  shape = "(naux)"
  block = "period"
  description = "represents the values of the auxiliary variables for each precipitation. The values of auxiliary variables must be present for each precipitation. The values must be specified in the order of the auxiliary variables specified in the OPTIONS block.  If the package supports time series and the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  optional = true
  time_series = true
  longname = "auxiliary variables"
  mf6internal = "auxvar"
  type = "double"
  
  [children.olf-nam.children.olf-pcp.blocks.period.stress_period_data.children.stress_period_data.children.boundname]
  block = "period"
  description = "name of the precipitation cell.  BOUNDNAME is an ASCII character variable that can contain as many as 40 characters.  If BOUNDNAME contains spaces in it, then the entire name must be enclosed within single quotes."
  reader = "urword"
  optional = true
  longname = "precipitation name"
  type = "string"
  
  [children.olf-nam.children.olf-pcp.blocks.period.precipitation]
  shape = "(nper, nnodes)"
  block = "period"
  description = "is the precipitation flux rate ($LT^{-1}$).  This rate is multiplied inside the program by the surface area of the cell to calculate the volumetric precipitation rate. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "precipitation rate"
  type = "double"
  
  [children.olf-nam.children.olf-pcp.blocks.period.aux]
  shape = "(nper, nnodes, naux)"
  block = "period"
  description = "represents the values of the auxiliary variables for each precipitation. The values of auxiliary variables must be present for each precipitation. The values must be specified in the order of the auxiliary variables specified in the OPTIONS block.  If the package supports time series and the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  optional = true
  time_series = true
  longname = "auxiliary variables"
  mf6internal = "auxvar"
  type = "double"
  
  [children.olf-nam.children.olf-pcp.blocks.period.boundname]
  shape = "(nper, nnodes)"
  block = "period"
  description = "name of the precipitation cell.  BOUNDNAME is an ASCII character variable that can contain as many as 40 characters.  If BOUNDNAME contains spaces in it, then the entire name must be enclosed within single quotes."
  reader = "urword"
  optional = true
  longname = "precipitation name"
  type = "string"
  
  [children.olf-nam.children.olf-disv1d]
  name = "olf-disv1d"
  schema_version = "1.2"
  parent = "olf-nam"
  advanced = false
  multi = false
  ftype = "DISV1D"
  
  [children.olf-nam.children.olf-disv1d.blocks.options.length_units]
  block = "options"
  description = "is the length units used for this model.  Values can be 'FEET', 'METERS', or 'CENTIMETERS'.  If not specified, the default is 'UNKNOWN'."
  reader = "urword"
  optional = true
  longname = "model length units"
  type = "string"
  
  [children.olf-nam.children.olf-disv1d.blocks.options.nogrb]
  block = "options"
  description = "keyword to deactivate writing of the binary grid file."
  reader = "urword"
  optional = true
  longname = "do not write binary grid file"
  type = "keyword"
  
  [children.olf-nam.children.olf-disv1d.blocks.options.grb_filerecord]
  block = "options"
  reader = "urword"
  optional = true
  type = "record"
  
  [children.olf-nam.children.olf-disv1d.blocks.options.grb_filerecord.children.grb6]
  block = "options"
  description = "keyword to specify that record corresponds to a binary grid file."
  reader = "urword"
  optional = false
  longname = "grb keyword"
  type = "keyword"
  
  [children.olf-nam.children.olf-disv1d.blocks.options.grb_filerecord.children.fileout]
  block = "options"
  description = "keyword to specify that an output filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.olf-nam.children.olf-disv1d.blocks.options.grb_filerecord.children.grb6_filename]
  block = "options"
  description = "defines a binary grid output file. If this option is not provided, the output file will have the same name as the discretization input file, plus extension '.grb'."
  reader = "urword"
  optional = false
  longname = "file name of GRB information"
  type = "string"
  
  [children.olf-nam.children.olf-disv1d.blocks.options.grb6]
  block = "options"
  description = "keyword to specify that record corresponds to a binary grid file."
  reader = "urword"
  optional = false
  longname = "grb keyword"
  type = "keyword"
  
  [children.olf-nam.children.olf-disv1d.blocks.options.fileout]
  block = "options"
  description = "keyword to specify that an output filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.olf-nam.children.olf-disv1d.blocks.options.grb6_filename]
  block = "options"
  description = "defines a binary grid output file. If this option is not provided, the output file will have the same name as the discretization input file, plus extension '.grb'."
  reader = "urword"
  optional = false
  longname = "file name of GRB information"
  type = "string"
  
  [children.olf-nam.children.olf-disv1d.blocks.options.xorigin]
  block = "options"
  description = "x-position of the origin used for model grid vertices.  This value should be provided in a real-world coordinate system.  A default value of zero is assigned if not specified.  The value for XORIGIN does not affect the model simulation, but it is written to the binary grid file so that postprocessors can locate the grid in space."
  reader = "urword"
  optional = true
  longname = "x-position origin of the model grid coordinate system"
  type = "double"
  
  [children.olf-nam.children.olf-disv1d.blocks.options.yorigin]
  block = "options"
  description = "y-position of the origin used for model grid vertices.  This value should be provided in a real-world coordinate system.  If not specified, then a default value equal to zero is used.  The value for YORIGIN does not affect the model simulation, but it is written to the binary grid file so that postprocessors can locate the grid in space."
  reader = "urword"
  optional = true
  longname = "y-position origin of the model grid coordinate system"
  type = "double"
  
  [children.olf-nam.children.olf-disv1d.blocks.options.angrot]
  block = "options"
  description = "counter-clockwise rotation angle (in degrees) of the model grid coordinate system relative to a real-world coordinate system.  If not specified, then a default value of 0.0 is assigned.  The value for ANGROT does not affect the model simulation, but it is written to the binary grid file so that postprocessors can locate the grid in space."
  reader = "urword"
  optional = true
  longname = "rotation angle"
  type = "double"
  
  [children.olf-nam.children.olf-disv1d.blocks.options.export_array_ascii]
  block = "options"
  description = "keyword that specifies input griddata arrays should be written to layered ascii output files."
  reader = "urword"
  optional = true
  mf6internal = "export_ascii"
  longname = "export array variables to layered ascii files."
  type = "keyword"
  
  [children.olf-nam.children.olf-disv1d.blocks.options.crs]
  shape = "lenbigline"
  block = "options"
  description = "is a real-world coordinate reference system (CRS) for the model, for example, an EPSG integer code (e.g. 26915), authority string (i.e. epsg:26915), or Open Geospatial Consortium Well-Known Text (WKT) specification. Limited to 5000 characters. The entry for CRS does not affect the model simulation, but it is written to the binary grid file so that postprocessors can locate the grid in space."
  reader = "urword"
  optional = true
  developmode = true
  longname = "CRS user input string"
  type = "string"
  
  [children.olf-nam.children.olf-disv1d.blocks.dimensions.nodes]
  block = "dimensions"
  description = "is the number of linear cells."
  reader = "urword"
  optional = false
  longname = "number of linear features"
  type = "integer"
  
  [children.olf-nam.children.olf-disv1d.blocks.dimensions.nvert]
  block = "dimensions"
  description = "is the total number of (x, y, z) vertex pairs used to characterize the model grid."
  reader = "urword"
  optional = true
  longname = "number of columns"
  type = "integer"
  
  [children.olf-nam.children.olf-disv1d.blocks.griddata.length]
  shape = "(nodes)"
  block = "griddata"
  description = "length for each one-dimensional cell"
  reader = "readarray"
  layered = false
  longname = "length"
  type = "double"
  
  [children.olf-nam.children.olf-disv1d.blocks.griddata.width]
  shape = "(nodes)"
  block = "griddata"
  description = "real value that defines the width for each one-dimensional cell. WIDTH must be greater than zero.  If the Cross Section (CXS) Package is used, then the WIDTH value will be multiplied by the specified cross section x-fraction values."
  reader = "readarray"
  layered = false
  longname = "width"
  type = "double"
  
  [children.olf-nam.children.olf-disv1d.blocks.griddata.bottom]
  shape = "(nodes)"
  block = "griddata"
  description = "bottom elevation for the one-dimensional cell."
  reader = "readarray"
  layered = false
  longname = "bottom elevation for the one-dimensional cell"
  type = "double"
  
  [children.olf-nam.children.olf-disv1d.blocks.griddata.idomain]
  shape = "(nodes)"
  block = "griddata"
  description = "is an optional array that characterizes the existence status of a cell.  If the IDOMAIN array is not specified, then all model cells exist within the solution.  If the IDOMAIN value for a cell is 0, the cell does not exist in the simulation.  Input and output values will be read and written for the cell, but internal to the program, the cell is excluded from the solution.  If the IDOMAIN value for a cell is 1, the cell exists in the simulation."
  reader = "readarray"
  layered = false
  optional = true
  longname = "idomain existence array"
  type = "integer"
  
  [children.olf-nam.children.olf-disv1d.blocks.vertices.vertices]
  shape = "(nvert)"
  block = "vertices"
  reader = "urword"
  optional = false
  longname = "vertices data"
  type = "list"
  
  [children.olf-nam.children.olf-disv1d.blocks.vertices.vertices.children.vertices]
  shape = "(nvert)"
  block = "vertices"
  reader = "urword"
  optional = false
  longname = "vertices data"
  type = "record"
  
  [children.olf-nam.children.olf-disv1d.blocks.vertices.vertices.children.vertices.children.iv]
  block = "vertices"
  description = "is the vertex number.  Records in the VERTICES block must be listed in consecutive order from 1 to NVERT."
  reader = "urword"
  optional = false
  longname = "vertex number"
  numeric_index = true
  type = "integer"
  
  [children.olf-nam.children.olf-disv1d.blocks.vertices.vertices.children.vertices.children.xv]
  block = "vertices"
  description = "is the x-coordinate for the vertex."
  reader = "urword"
  optional = false
  longname = "x-coordinate for vertex"
  type = "double"
  
  [children.olf-nam.children.olf-disv1d.blocks.vertices.vertices.children.vertices.children.yv]
  block = "vertices"
  description = "is the y-coordinate for the vertex."
  reader = "urword"
  optional = false
  longname = "y-coordinate for vertex"
  type = "double"
  
  [children.olf-nam.children.olf-disv1d.blocks.vertices.iv]
  block = "vertices"
  description = "is the vertex number.  Records in the VERTICES block must be listed in consecutive order from 1 to NVERT."
  reader = "urword"
  optional = false
  longname = "vertex number"
  numeric_index = true
  type = "integer"
  
  [children.olf-nam.children.olf-disv1d.blocks.vertices.xv]
  block = "vertices"
  description = "is the x-coordinate for the vertex."
  reader = "urword"
  optional = false
  longname = "x-coordinate for vertex"
  type = "double"
  
  [children.olf-nam.children.olf-disv1d.blocks.vertices.yv]
  block = "vertices"
  description = "is the y-coordinate for the vertex."
  reader = "urword"
  optional = false
  longname = "y-coordinate for vertex"
  type = "double"
  
  [children.olf-nam.children.olf-disv1d.blocks.cell2d.cell2d]
  shape = "(nodes)"
  block = "cell2d"
  reader = "urword"
  optional = false
  longname = "cell2d data"
  type = "list"
  
  [children.olf-nam.children.olf-disv1d.blocks.cell2d.cell2d.children.cell2d]
  shape = "(nodes)"
  block = "cell2d"
  reader = "urword"
  optional = false
  longname = "cell2d data"
  type = "record"
  
  [children.olf-nam.children.olf-disv1d.blocks.cell2d.cell2d.children.cell2d.children.icell2d]
  block = "cell2d"
  description = "is the cell2d number.  Records in the cell2d block must be listed in consecutive order from the first to the last."
  reader = "urword"
  optional = false
  longname = "cell2d number"
  numeric_index = true
  type = "integer"
  
  [children.olf-nam.children.olf-disv1d.blocks.cell2d.cell2d.children.cell2d.children.fdc]
  block = "cell2d"
  description = "is the fractional distance to the cell center. FDC is relative to the first vertex in the ICVERT array. In most cases FDC should be 0.5, which would place the center of the line segment that defines the cell. If the value of FDC is 1, the cell center would located at the last vertex. FDC values of 0 and 1 can be used to place the node at either end of the cell which can be useful for cells with boundary conditions."
  reader = "urword"
  optional = false
  longname = "fractional distance to the cell center"
  type = "double"
  
  [children.olf-nam.children.olf-disv1d.blocks.cell2d.cell2d.children.cell2d.children.ncvert]
  block = "cell2d"
  description = "is the number of vertices required to define the cell.  There may be a different number of vertices for each cell."
  reader = "urword"
  optional = false
  longname = "number of cell vertices"
  type = "integer"
  
  [children.olf-nam.children.olf-disv1d.blocks.cell2d.cell2d.children.cell2d.children.icvert]
  shape = "(ncvert)"
  block = "cell2d"
  description = "is an array of integer values containing vertex numbers (in the VERTICES block) used to define the cell.  Vertices must be listed in the order that defines the line representing the cell.  Cells that are connected must share vertices. The bottom elevation of the cell is calculated using the ZV of the first and last vertex point and FDC."
  reader = "urword"
  optional = false
  longname = "number of cell vertices"
  numeric_index = true
  type = "integer"
  
  [children.olf-nam.children.olf-disv1d.blocks.cell2d.icell2d]
  block = "cell2d"
  description = "is the cell2d number.  Records in the cell2d block must be listed in consecutive order from the first to the last."
  reader = "urword"
  optional = false
  longname = "cell2d number"
  numeric_index = true
  type = "integer"
  
  [children.olf-nam.children.olf-disv1d.blocks.cell2d.fdc]
  block = "cell2d"
  description = "is the fractional distance to the cell center. FDC is relative to the first vertex in the ICVERT array. In most cases FDC should be 0.5, which would place the center of the line segment that defines the cell. If the value of FDC is 1, the cell center would located at the last vertex. FDC values of 0 and 1 can be used to place the node at either end of the cell which can be useful for cells with boundary conditions."
  reader = "urword"
  optional = false
  longname = "fractional distance to the cell center"
  type = "double"
  
  [children.olf-nam.children.olf-disv1d.blocks.cell2d.ncvert]
  block = "cell2d"
  description = "is the number of vertices required to define the cell.  There may be a different number of vertices for each cell."
  reader = "urword"
  optional = false
  longname = "number of cell vertices"
  type = "integer"
  
  [children.olf-nam.children.olf-disv1d.blocks.cell2d.icvert]
  shape = "(ncvert)"
  block = "cell2d"
  description = "is an array of integer values containing vertex numbers (in the VERTICES block) used to define the cell.  Vertices must be listed in the order that defines the line representing the cell.  Cells that are connected must share vertices. The bottom elevation of the cell is calculated using the ZV of the first and last vertex point and FDC."
  reader = "urword"
  optional = false
  longname = "number of cell vertices"
  numeric_index = true
  type = "integer"
  
  [children.olf-nam.children.olf-ic]
  name = "olf-ic"
  schema_version = "1.2"
  parent = "olf-nam"
  advanced = false
  multi = false
  ftype = "IC"
  
  [children.olf-nam.children.olf-ic.blocks.options.export_array_ascii]
  block = "options"
  description = "keyword that specifies input griddata arrays should be written to layered ascii output files."
  reader = "urword"
  optional = true
  mf6internal = "export_ascii"
  longname = "export array variables to layered ascii files."
  type = "keyword"
  
  [children.olf-nam.children.olf-ic.blocks.griddata.strt]
  shape = "(nodes)"
  block = "griddata"
  description = "is the initial (starting) stage---that is, stage at the beginning of the OLF Model simulation.  STRT must be specified for all OLF Model simulations. One value is read for every model reach."
  default = "0.0"
  reader = "readarray"
  layered = true
  longname = "starting concentration"
  type = "double"
  
  [children.olf-nam.children.olf-dfw]
  name = "olf-dfw"
  schema_version = "1.2"
  parent = "olf-nam"
  advanced = false
  multi = false
  ftype = "DFW"
  
  [children.olf-nam.children.olf-dfw.blocks.options.central_in_space]
  block = "options"
  description = "keyword to indicate conductance should be calculated using central-in-space weighting instead of the default upstream weighting approach.  This option should be used with caution as it does not work well unless all of the stream reaches are saturated.  With this option, there is no way for water to flow into a dry reach from connected reaches."
  reader = "urword"
  optional = true
  longname = "use central in space weighting"
  mf6internal = "icentral"
  type = "keyword"
  
  [children.olf-nam.children.olf-dfw.blocks.options.length_conversion]
  block = "options"
  description = "real value that is used to convert user-specified Manning's roughness coefficients from meters to model length units. LENGTH_CONVERSION should be set to 3.28081, 1.0, and 100.0 when using length units (LENGTH_UNITS) of feet, meters, or centimeters in the simulation, respectively. LENGTH_CONVERSION does not need to be specified if LENGTH_UNITS are meters."
  reader = "urword"
  optional = true
  longname = "length conversion factor"
  mf6internal = "lengthconv"
  type = "double"
  
  [children.olf-nam.children.olf-dfw.blocks.options.time_conversion]
  block = "options"
  description = "real value that is used to convert user-specified Manning's roughness coefficients from seconds to model time units. TIME_CONVERSION should be set to 1.0, 60.0, 3,600.0, 86,400.0, and 31,557,600.0 when using time units (TIME_UNITS) of seconds, minutes, hours, days, or years in the simulation, respectively. TIME_CONVERSION does not need to be specified if TIME_UNITS are seconds."
  reader = "urword"
  optional = true
  longname = "time conversion factor"
  mf6internal = "timeconv"
  type = "double"
  
  [children.olf-nam.children.olf-dfw.blocks.options.save_flows]
  block = "options"
  description = "keyword to indicate that budget flow terms will be written to the file specified with 'BUDGET SAVE FILE' in Output Control."
  reader = "urword"
  optional = true
  longname = "keyword to save DFW flows"
  mf6internal = "ipakcb"
  type = "keyword"
  
  [children.olf-nam.children.olf-dfw.blocks.options.print_flows]
  block = "options"
  description = "keyword to indicate that calculated flows between cells will be printed to the listing file for every stress period time step in which 'BUDGET PRINT' is specified in Output Control. If there is no Output Control option and 'PRINT_FLOWS' is specified, then flow rates are printed for the last time step of each stress period.  This option can produce extremely large list files because all cell-by-cell flows are printed.  It should only be used with the DFW Package for models that have a small number of cells."
  reader = "urword"
  optional = true
  longname = "keyword to print DFW flows to listing file"
  mf6internal = "iprflow"
  type = "keyword"
  
  [children.olf-nam.children.olf-dfw.blocks.options.save_velocity]
  block = "options"
  description = "keyword to indicate that x, y, and z components of velocity will be calculated at cell centers and written to the budget file, which is specified with 'BUDGET SAVE FILE' in Output Control.  If this option is activated, then additional information may be required in the discretization packages and the GWF Exchange package (if GWF models are coupled).  Specifically, ANGLDEGX must be specified in the CONNECTIONDATA block of the DISU Package; ANGLDEGX must also be specified for the GWF Exchange as an auxiliary variable."
  reader = "urword"
  optional = true
  longname = "keyword to save velocity"
  mf6internal = "isavvelocity"
  type = "keyword"
  
  [children.olf-nam.children.olf-dfw.blocks.options.obs_filerecord]
  block = "options"
  reader = "urword"
  optional = true
  type = "record"
  
  [children.olf-nam.children.olf-dfw.blocks.options.obs_filerecord.children.obs6]
  block = "options"
  description = "keyword to specify that record corresponds to an observations file."
  reader = "urword"
  optional = false
  longname = "obs keyword"
  type = "keyword"
  
  [children.olf-nam.children.olf-dfw.blocks.options.obs_filerecord.children.filein]
  block = "options"
  description = "keyword to specify that an input filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.olf-nam.children.olf-dfw.blocks.options.obs_filerecord.children.obs6_filename]
  block = "options"
  description = "name of input file to define observations for the DFW package. See the 'Observation utility' section for instructions for preparing observation input files. Table {#2} lists observation type(s) supported by the DFW package."
  reader = "urword"
  optional = false
  longname = "obs6 input filename"
  type = "string"
  
  [children.olf-nam.children.olf-dfw.blocks.options.obs6]
  block = "options"
  description = "keyword to specify that record corresponds to an observations file."
  reader = "urword"
  optional = false
  longname = "obs keyword"
  type = "keyword"
  
