          "abbr": "ts",
          "param": "timeseries",
          "description": "xxx"
        }
      },
      "obs_filerecord": {
        "block": "options",
        "type": "record",
        "reader": "urword",
        "optional": true,
        "tagged": true,
        "fields": {
          "filein": {
            "block": "options",
            "type": "keyword",
            "reader": "urword",
            "optional": false,
