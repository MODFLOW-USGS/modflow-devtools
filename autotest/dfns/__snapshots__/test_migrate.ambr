          in_record: true
          tagged: true
        budgetfile:
          block: options
          type: string
          reader: urword
          optional: false
          longname: file keyword
          description: name of the binary output file to write budget information.
          preserve_case: true
          in_record: true
          tagged: false
    budgetcsv_filerecord:
      block: options
      type: record
      reader: urword
      optional: true
      tagged: true
      fields:
        fileout:
          block: options
          type: keyword
          reader: urword
