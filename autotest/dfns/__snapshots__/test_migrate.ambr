  type = "string"
  
  [children.gwe-nam.children.gwe-uze.blocks.options.budgetcsv_filerecord]
  block = "options"
  reader = "urword"
  optional = true
  type = "record"
  
  [children.gwe-nam.children.gwe-uze.blocks.options.budgetcsv_filerecord.children.budgetcsv]
