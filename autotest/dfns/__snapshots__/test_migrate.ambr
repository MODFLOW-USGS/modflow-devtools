  reader = "urword"
  optional = false
  longname = "budget keyword"
  type = "keyword"
  
  [children.gwe-nam.children.gwe-mve.blocks.options.fileout]
  block = "options"
  description = "keyword to specify that an output filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.gwe-nam.children.gwe-mve.blocks.options.budgetfile]
  block = "options"
