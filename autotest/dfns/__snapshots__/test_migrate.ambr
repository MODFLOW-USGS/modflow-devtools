  [children.gwf-nam.children.gwf-uzf.blocks.options.package_convergence_filerecord.children.package_convergence_filename]
  block = "options"
  description = "name of the comma spaced values output file to write package convergence information."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "string"
  
  [children.gwf-nam.children.gwf-uzf.blocks.options.package_convergence]
  block = "options"
  description = "keyword to specify that record corresponds to the package convergence comma spaced values file."
  reader = "urword"
  optional = false
  longname = "package_convergence keyword"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-uzf.blocks.options.package_convergence_filename]
  block = "options"
  description = "name of the comma spaced values output file to write package convergence information."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "string"
  
  [children.gwf-nam.children.gwf-uzf.blocks.options.ts_filerecord]
  block = "options"
  reader = "urword"
  optional = true
  type = "record"
  
  [children.gwf-nam.children.gwf-uzf.blocks.options.ts_filerecord.children.ts6]
  block = "options"
  description = "keyword to specify that record corresponds to a time-series file."
  reader = "urword"
  optional = false
  longname = "head keyword"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-uzf.blocks.options.ts_filerecord.children.filein]
  block = "options"
  description = "keyword to specify that an input filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-uzf.blocks.options.ts_filerecord.children.ts6_filename]
  block = "options"
  description = "defines a time-series file defining time series that can be used to assign time-varying values. See the 'Time-Variable Input' section for instructions on using the time-series capability."
  reader = "urword"
  optional = false
  longname = "file name of time series information"
  type = "string"
  
  [children.gwf-nam.children.gwf-uzf.blocks.options.ts6]
  block = "options"
  description = "keyword to specify that record corresponds to a time-series file."
  reader = "urword"
  optional = false
  longname = "head keyword"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-uzf.blocks.options.filein]
  block = "options"
  description = "keyword to specify that an input filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-uzf.blocks.options.ts6_filename]
  block = "options"
  description = "defines a time-series file defining time series that can be used to assign time-varying values. See the 'Time-Variable Input' section for instructions on using the time-series capability."
  reader = "urword"
  optional = false
  longname = "file name of time series information"
  type = "string"
  
  [children.gwf-nam.children.gwf-uzf.blocks.options.obs_filerecord]
  block = "options"
  reader = "urword"
  optional = true
  type = "record"
  
  [children.gwf-nam.children.gwf-uzf.blocks.options.obs_filerecord.children.obs6]
  block = "options"
  description = "keyword to specify that record corresponds to an observations file."
  reader = "urword"
  optional = false
  longname = "obs keyword"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-uzf.blocks.options.obs_filerecord.children.filein]
  block = "options"
  description = "keyword to specify that an input filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-uzf.blocks.options.obs_filerecord.children.obs6_filename]
  block = "options"
  description = "name of input file to define observations for the UZF package. See the 'Observation utility' section for instructions for preparing observation input files. Table {#2} lists observation type(s) supported by the UZF package."
  reader = "urword"
  optional = false
  longname = "obs6 input filename"
  type = "string"
  
  [children.gwf-nam.children.gwf-uzf.blocks.options.obs6]
  block = "options"
  description = "keyword to specify that record corresponds to an observations file."
  reader = "urword"
  optional = false
  longname = "obs keyword"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-uzf.blocks.options.obs6_filename]
  block = "options"
  description = "name of input file to define observations for the UZF package. See the 'Observation utility' section for instructions for preparing observation input files. Table {#2} lists observation type(s) supported by the UZF package."
  reader = "urword"
  optional = false
  longname = "obs6 input filename"
  type = "string"
  
  [children.gwf-nam.children.gwf-uzf.blocks.options.mover]
  block = "options"
  description = "keyword to indicate that this instance of the UZF Package can be used with the Water Mover (MVR) Package.  When the MOVER option is specified, additional memory is allocated within the package to store the available, provided, and received water."
  reader = "urword"
  optional = true
  type = "keyword"
  
  [children.gwf-nam.children.gwf-uzf.blocks.options.simulate_et]
  block = "options"
  description = "keyword specifying that ET in the unsaturated (UZF) and saturated zones (GWF) will be simulated. ET can be simulated in the UZF cell and not the GWF cell by omitting keywords LINEAR_GWET and SQUARE_GWET."
  reader = "urword"
  optional = true
  type = "keyword"
  
  [children.gwf-nam.children.gwf-uzf.blocks.options.linear_gwet]
  block = "options"
  description = "keyword specifying that groundwater ET will be simulated using the original ET formulation of MODFLOW-2005."
  reader = "urword"
  optional = true
  longname = "use linear evapotranspiration"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-uzf.blocks.options.square_gwet]
  block = "options"
  description = "keyword specifying that groundwater ET will be simulated by assuming a constant ET rate for groundwater levels between land surface (TOP) and land surface minus the ET extinction depth (TOP-EXTDP). Groundwater ET is smoothly reduced from the PET rate to zero over a nominal interval at TOP-EXTDP."
  reader = "urword"
  optional = true
  longname = "use square evapotranspiration"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-uzf.blocks.options.simulate_gwseep]
  block = "options"
  description = "keyword specifying that groundwater discharge (GWSEEP) to land surface will be simulated. Groundwater discharge is nonzero when groundwater head is greater than land surface.  This option is no longer recommended; a better approach is to use the Drain Package with discharge scaling as a way to handle seepage to land surface.  The Drain Package with discharge scaling is described in Chapter 3 of the Supplemental Technical Information."
  reader = "urword"
  optional = true
  deprecated = "6.5.0"
  longname = "activate seepage"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-uzf.blocks.options.unsat_etwc]
  block = "options"
  description = "keyword specifying that ET in the unsaturated zone will be simulated as a function of the specified PET rate while the water content (THETA) is greater than the ET extinction water content (EXTWC)."
  reader = "urword"
  optional = true
  longname = "use PET for theta greater than extwc"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-uzf.blocks.options.unsat_etae]
  block = "options"
  description = "keyword specifying that ET in the unsaturated zone will be simulated using a capillary pressure based formulation. Capillary pressure is calculated using the Brooks-Corey retention function."
  reader = "urword"
  optional = true
  longname = "use root potential"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-uzf.blocks.dimensions.nuzfcells]
  block = "dimensions"
  description = "is the number of UZF cells.  More than one UZF cell can be assigned to a GWF cell; however, only one GWF cell can be assigned to a single UZF cell. If more than one UZF cell is assigned to a GWF cell, then an auxiliary variable should be used to reduce the surface area of the UZF cell with the AUXMULTNAME option."
  reader = "urword"
  optional = false
  longname = "number of UZF cells"
  type = "integer"
  
  [children.gwf-nam.children.gwf-uzf.blocks.dimensions.ntrailwaves]
  block = "dimensions"
  description = "is the number of trailing waves.  A recommended value of 7 can be used for NTRAILWAVES.  This value can be increased to lower mass balance error in the unsaturated zone."
  default = "7"
  reader = "urword"
  optional = false
  longname = "number of trailing waves"
  type = "integer"
  
  [children.gwf-nam.children.gwf-uzf.blocks.dimensions.nwavesets]
  block = "dimensions"
  description = "is the number of wave sets.  A recommended value of 40 can be used for NWAVESETS.  This value can be increased if more waves are required to resolve variations in water content within the unsaturated zone."
  default = "40"
  reader = "urword"
  optional = false
  longname = "number of wave sets"
  type = "integer"
  
  [children.gwf-nam.children.gwf-uzf.blocks.packagedata.packagedata]
  shape = "(nuzfcells)"
  block = "packagedata"
  reader = "urword"
  type = "list"
  
  [children.gwf-nam.children.gwf-uzf.blocks.packagedata.packagedata.children.packagedata]
  shape = "(nuzfcells)"
  block = "packagedata"
  reader = "urword"
  type = "record"
  
  [children.gwf-nam.children.gwf-uzf.blocks.packagedata.packagedata.children.packagedata.children.ifno]
  block = "packagedata"
  description = "integer value that defines the feature (UZF object) number associated with the specified PACKAGEDATA data on the line. IFNO must be greater than zero and less than or equal to NUZFCELLS.  UZF information must be specified for every UZF cell or the program will terminate with an error.  The program will also terminate with an error if information for a UZF cell is specified more than once."
  reader = "urword"
  longname = "uzf id number for this entry"
  numeric_index = true
  type = "integer"
  
  [children.gwf-nam.children.gwf-uzf.blocks.packagedata.packagedata.children.packagedata.children.cellid]
  shape = "(ncelldim)"
  block = "packagedata"
  description = "is the cell identifier, and depends on the type of grid that is used for the simulation.  For a structured grid that uses the DIS input file, CELLID is the layer, row, and column.   For a grid that uses the DISV input file, CELLID is the layer and CELL2D number.  If the model uses the unstructured discretization (DISU) input file, CELLID is the node number for the cell."
  reader = "urword"
  longname = "cell identifier"
  type = "integer"
  
  [children.gwf-nam.children.gwf-uzf.blocks.packagedata.packagedata.children.packagedata.children.landflag]
  block = "packagedata"
  description = "integer value set to one for land surface cells indicating that boundary conditions can be applied and data can be specified in the PERIOD block. A value of 0 specifies a non-land surface cell."
  reader = "urword"
  longname = "land flag"
  type = "integer"
  
  [children.gwf-nam.children.gwf-uzf.blocks.packagedata.packagedata.children.packagedata.children.ivertcon]
  block = "packagedata"
  description = "integer value set to specify underlying UZF cell that receives water flowing to bottom of cell. If unsaturated zone flow reaches the water table before the cell bottom, then water is added to the GWF cell instead of flowing to the underlying UZF cell. A value of 0 indicates the UZF cell is not connected to an underlying UZF cell."
  reader = "urword"
  longname = "vertical connection flag"
  numeric_index = true
  type = "integer"
  
  [children.gwf-nam.children.gwf-uzf.blocks.packagedata.packagedata.children.packagedata.children.surfdep]
  block = "packagedata"
  description = "is the surface depression depth of the UZF cell."
  reader = "urword"
  longname = "surface depression depth"
  type = "double"
  
  [children.gwf-nam.children.gwf-uzf.blocks.packagedata.packagedata.children.packagedata.children.vks]
  block = "packagedata"
  description = "is the saturated vertical hydraulic conductivity of the UZF cell.  This value is used with the Brooks-Corey function and the simulated water content to calculate the partially saturated hydraulic conductivity."
  reader = "urword"
  longname = "vertical saturated hydraulic conductivity"
  type = "double"
  
  [children.gwf-nam.children.gwf-uzf.blocks.packagedata.packagedata.children.packagedata.children.thtr]
  block = "packagedata"
  description = "is the residual (irreducible) water content of the UZF cell.  This residual water is not available to plants and will not drain into underlying aquifer cells."
  reader = "urword"
  longname = "residual water content"
  type = "double"
  
  [children.gwf-nam.children.gwf-uzf.blocks.packagedata.packagedata.children.packagedata.children.thts]
  block = "packagedata"
  description = "is the saturated water content of the UZF cell.  The values for saturated and residual water content should be set in a manner that is consistent with the specific yield value specified in the Storage Package.  The saturated water content must be greater than the residual content."
  reader = "urword"
  longname = "saturated water content"
  type = "double"
  
  [children.gwf-nam.children.gwf-uzf.blocks.packagedata.packagedata.children.packagedata.children.thti]
  block = "packagedata"
  description = "is the initial water content of the UZF cell.  The value must be greater than or equal to the residual water content and less than or equal to the saturated water content."
  reader = "urword"
  longname = "initial water content"
  type = "double"
  
  [children.gwf-nam.children.gwf-uzf.blocks.packagedata.packagedata.children.packagedata.children.eps]
  block = "packagedata"
  description = "is the exponent used in the Brooks-Corey function.  The Brooks-Corey function is used by UZF to calculated hydraulic conductivity under partially saturated conditions as a function of water content and the user-specified saturated hydraulic conductivity."
  reader = "urword"
  longname = "Brooks-Corey exponent"
  type = "double"
  
  [children.gwf-nam.children.gwf-uzf.blocks.packagedata.packagedata.children.packagedata.children.boundname]
  block = "packagedata"
  description = "name of the UZF cell cell.  BOUNDNAME is an ASCII character variable that can contain as many as 40 characters.  If BOUNDNAME contains spaces in it, then the entire name must be enclosed within single quotes."
  reader = "urword"
  optional = true
  longname = "well name"
  type = "string"
  
  [children.gwf-nam.children.gwf-uzf.blocks.packagedata.ifno]
  block = "packagedata"
  description = "integer value that defines the feature (UZF object) number associated with the specified PACKAGEDATA data on the line. IFNO must be greater than zero and less than or equal to NUZFCELLS.  UZF information must be specified for every UZF cell or the program will terminate with an error.  The program will also terminate with an error if information for a UZF cell is specified more than once."
  reader = "urword"
  longname = "uzf id number for this entry"
  numeric_index = true
  type = "integer"
  
  [children.gwf-nam.children.gwf-uzf.blocks.packagedata.cellid]
  shape = "(ncelldim)"
  block = "packagedata"
  description = "is the cell identifier, and depends on the type of grid that is used for the simulation.  For a structured grid that uses the DIS input file, CELLID is the layer, row, and column.   For a grid that uses the DISV input file, CELLID is the layer and CELL2D number.  If the model uses the unstructured discretization (DISU) input file, CELLID is the node number for the cell."
  reader = "urword"
  longname = "cell identifier"
  type = "integer"
  
  [children.gwf-nam.children.gwf-uzf.blocks.packagedata.landflag]
  block = "packagedata"
  description = "integer value set to one for land surface cells indicating that boundary conditions can be applied and data can be specified in the PERIOD block. A value of 0 specifies a non-land surface cell."
  reader = "urword"
  longname = "land flag"
  type = "integer"
  
  [children.gwf-nam.children.gwf-uzf.blocks.packagedata.ivertcon]
  block = "packagedata"
  description = "integer value set to specify underlying UZF cell that receives water flowing to bottom of cell. If unsaturated zone flow reaches the water table before the cell bottom, then water is added to the GWF cell instead of flowing to the underlying UZF cell. A value of 0 indicates the UZF cell is not connected to an underlying UZF cell."
  reader = "urword"
  longname = "vertical connection flag"
  numeric_index = true
  type = "integer"
  
  [children.gwf-nam.children.gwf-uzf.blocks.packagedata.surfdep]
  block = "packagedata"
  description = "is the surface depression depth of the UZF cell."
  reader = "urword"
  longname = "surface depression depth"
  type = "double"
  
  [children.gwf-nam.children.gwf-uzf.blocks.packagedata.vks]
  block = "packagedata"
  description = "is the saturated vertical hydraulic conductivity of the UZF cell.  This value is used with the Brooks-Corey function and the simulated water content to calculate the partially saturated hydraulic conductivity."
  reader = "urword"
  longname = "vertical saturated hydraulic conductivity"
  type = "double"
  
  [children.gwf-nam.children.gwf-uzf.blocks.packagedata.thtr]
  block = "packagedata"
  description = "is the residual (irreducible) water content of the UZF cell.  This residual water is not available to plants and will not drain into underlying aquifer cells."
  reader = "urword"
  longname = "residual water content"
  type = "double"
  
  [children.gwf-nam.children.gwf-uzf.blocks.packagedata.thts]
  block = "packagedata"
  description = "is the saturated water content of the UZF cell.  The values for saturated and residual water content should be set in a manner that is consistent with the specific yield value specified in the Storage Package.  The saturated water content must be greater than the residual content."
  reader = "urword"
  longname = "saturated water content"
  type = "double"
  
  [children.gwf-nam.children.gwf-uzf.blocks.packagedata.thti]
  block = "packagedata"
  description = "is the initial water content of the UZF cell.  The value must be greater than or equal to the residual water content and less than or equal to the saturated water content."
  reader = "urword"
  longname = "initial water content"
  type = "double"
  
  [children.gwf-nam.children.gwf-uzf.blocks.packagedata.eps]
  block = "packagedata"
  description = "is the exponent used in the Brooks-Corey function.  The Brooks-Corey function is used by UZF to calculated hydraulic conductivity under partially saturated conditions as a function of water content and the user-specified saturated hydraulic conductivity."
  reader = "urword"
  longname = "Brooks-Corey exponent"
  type = "double"
  
  [children.gwf-nam.children.gwf-uzf.blocks.packagedata.boundname]
  block = "packagedata"
  description = "name of the UZF cell cell.  BOUNDNAME is an ASCII character variable that can contain as many as 40 characters.  If BOUNDNAME contains spaces in it, then the entire name must be enclosed within single quotes."
  reader = "urword"
  optional = true
  longname = "well name"
  type = "string"
  
  [children.gwf-nam.children.gwf-uzf.blocks.period.iper]
  shape = "(nper)"
  block = "period"
  description = "integer value specifying the starting stress period number for which the data specified in the PERIOD block apply.  IPER must be less than or equal to NPER in the TDIS Package and greater than zero.  The IPER value assigned to a stress period block must be greater than the IPER value assigned for the previous PERIOD block.  The information specified in the PERIOD block will continue to apply for all subsequent stress periods, unless the program encounters another PERIOD block."
  block_variable = true
  reader = "urword"
  optional = false
  longname = "stress period number"
  type = "integer"
  
  [children.gwf-nam.children.gwf-uzf.blocks.period.perioddata]
  shape = "(nper)"
  block = "period"
  reader = "urword"
  type = "list"
  
  [children.gwf-nam.children.gwf-uzf.blocks.period.perioddata.children.perioddata]
  block = "period"
  reader = "urword"
  type = "record"
  
  [children.gwf-nam.children.gwf-uzf.blocks.period.perioddata.children.perioddata.children.ifno]
  block = "packagedata"
  description = "integer value that defines the feature (UZF object) number associated with the specified PACKAGEDATA data on the line. IFNO must be greater than zero and less than or equal to NUZFCELLS.  UZF information must be specified for every UZF cell or the program will terminate with an error.  The program will also terminate with an error if information for a UZF cell is specified more than once."
  reader = "urword"
  longname = "uzf id number for this entry"
  numeric_index = true
  type = "integer"
  
  [children.gwf-nam.children.gwf-uzf.blocks.period.perioddata.children.perioddata.children.finf]
  block = "period"
  description = "real or character value that defines the applied infiltration rate of the UZF cell ($LT^{-1}$). If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  time_series = true
  reader = "urword"
  longname = "infiltration rate"
  type = "string"
  
  [children.gwf-nam.children.gwf-uzf.blocks.period.perioddata.children.perioddata.children.pet]
  block = "period"
  description = "real or character value that defines the potential evapotranspiration rate of the UZF cell and specified GWF cell. Evapotranspiration is first removed from the unsaturated zone and any remaining potential evapotranspiration is applied to the saturated zone. If IVERTCON is greater than zero then residual potential evapotranspiration not satisfied in the UZF cell is applied to the underlying UZF and GWF cells. PET is always specified, but is only used if SIMULATE_ET is specified in the OPTIONS block. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "potential ET rate"
  type = "string"
  
  [children.gwf-nam.children.gwf-uzf.blocks.period.perioddata.children.perioddata.children.extdp]
  block = "period"
  description = "real or character value that defines the evapotranspiration extinction depth of the UZF cell. If IVERTCON is greater than zero and EXTDP extends below the GWF cell bottom then remaining potential evapotranspiration is applied to the underlying UZF and GWF cells. EXTDP is always specified, but is only used if SIMULATE_ET is specified in the OPTIONS block. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "extinction depth"
  type = "string"
  
  [children.gwf-nam.children.gwf-uzf.blocks.period.perioddata.children.perioddata.children.extwc]
  block = "period"
  description = "real or character value that defines the evapotranspiration extinction water content of the UZF cell. EXTWC is always specified, but is only used if SIMULATE_ET and UNSAT_ETWC are specified in the OPTIONS block. The evapotranspiration rate from the unsaturated zone will be set to zero when the calculated water content is at or less than this value.  The value for EXTWC cannot be less than the residual water content, and if it is specified as being less than the residual water content it is set to the residual water content. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "extinction water content"
  type = "string"
  
  [children.gwf-nam.children.gwf-uzf.blocks.period.perioddata.children.perioddata.children.ha]
  block = "period"
  description = "real or character value that defines the air entry potential (head) of the UZF cell. HA is always specified, but is only used if SIMULATE_ET and UNSAT_ETAE are specified in the OPTIONS block. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  time_series = true
  reader = "urword"
  longname = "air entry potential"
  type = "string"
  
  [children.gwf-nam.children.gwf-uzf.blocks.period.perioddata.children.perioddata.children.hroot]
  block = "period"
  description = "real or character value that defines the root potential (head) of the UZF cell. HROOT is always specified, but is only used if SIMULATE_ET and UNSAT_ETAE are specified in the OPTIONS block. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "root potential"
  type = "string"
  
  [children.gwf-nam.children.gwf-uzf.blocks.period.perioddata.children.perioddata.children.rootact]
  block = "period"
  description = "real or character value that defines the root activity function of the UZF cell. ROOTACT is the length of roots in a given volume of soil divided by that volume. Values range from 0 to about 3 $cm^{-2}$, depending on the plant community and its stage of development. ROOTACT is always specified, but is only used if SIMULATE_ET and UNSAT_ETAE are specified in the OPTIONS block. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "root activity function"
  type = "string"
  
  [children.gwf-nam.children.gwf-uzf.blocks.period.perioddata.children.perioddata.children.aux]
  shape = "(naux)"
  block = "period"
  description = "represents the values of the auxiliary variables for each UZF. The values of auxiliary variables must be present for each UZF. The values must be specified in the order of the auxiliary variables specified in the OPTIONS block.  If the package supports time series and the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  optional = true
  longname = "auxiliary variables"
  type = "double"
  
  [children.gwf-nam.children.gwf-uzf.blocks.period.ifno]
  shape = "(nper)"
  block = "period"
  description = "integer value that defines the feature (UZF object) number associated with the specified PERIOD data on the line."
  reader = "urword"
  longname = "UZF id number"
  numeric_index = true
  type = "integer"
  
  [children.gwf-nam.children.gwf-uzf.blocks.period.finf]
  shape = "(nper)"
  block = "period"
  description = "real or character value that defines the applied infiltration rate of the UZF cell ($LT^{-1}$). If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  time_series = true
  reader = "urword"
  longname = "infiltration rate"
  type = "string"
  
  [children.gwf-nam.children.gwf-uzf.blocks.period.pet]
  shape = "(nper)"
  block = "period"
  description = "real or character value that defines the potential evapotranspiration rate of the UZF cell and specified GWF cell. Evapotranspiration is first removed from the unsaturated zone and any remaining potential evapotranspiration is applied to the saturated zone. If IVERTCON is greater than zero then residual potential evapotranspiration not satisfied in the UZF cell is applied to the underlying UZF and GWF cells. PET is always specified, but is only used if SIMULATE_ET is specified in the OPTIONS block. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "potential ET rate"
  type = "string"
  
  [children.gwf-nam.children.gwf-uzf.blocks.period.extdp]
  shape = "(nper)"
  block = "period"
  description = "real or character value that defines the evapotranspiration extinction depth of the UZF cell. If IVERTCON is greater than zero and EXTDP extends below the GWF cell bottom then remaining potential evapotranspiration is applied to the underlying UZF and GWF cells. EXTDP is always specified, but is only used if SIMULATE_ET is specified in the OPTIONS block. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "extinction depth"
  type = "string"
  
  [children.gwf-nam.children.gwf-uzf.blocks.period.extwc]
  shape = "(nper)"
  block = "period"
  description = "real or character value that defines the evapotranspiration extinction water content of the UZF cell. EXTWC is always specified, but is only used if SIMULATE_ET and UNSAT_ETWC are specified in the OPTIONS block. The evapotranspiration rate from the unsaturated zone will be set to zero when the calculated water content is at or less than this value.  The value for EXTWC cannot be less than the residual water content, and if it is specified as being less than the residual water content it is set to the residual water content. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "extinction water content"
  type = "string"
  
  [children.gwf-nam.children.gwf-uzf.blocks.period.ha]
  shape = "(nper)"
  block = "period"
  description = "real or character value that defines the air entry potential (head) of the UZF cell. HA is always specified, but is only used if SIMULATE_ET and UNSAT_ETAE are specified in the OPTIONS block. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  time_series = true
  reader = "urword"
  longname = "air entry potential"
  type = "string"
  
  [children.gwf-nam.children.gwf-uzf.blocks.period.hroot]
  shape = "(nper)"
  block = "period"
  description = "real or character value that defines the root potential (head) of the UZF cell. HROOT is always specified, but is only used if SIMULATE_ET and UNSAT_ETAE are specified in the OPTIONS block. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "root potential"
  type = "string"
  
  [children.gwf-nam.children.gwf-uzf.blocks.period.rootact]
  shape = "(nper)"
  block = "period"
  description = "real or character value that defines the root activity function of the UZF cell. ROOTACT is the length of roots in a given volume of soil divided by that volume. Values range from 0 to about 3 $cm^{-2}$, depending on the plant community and its stage of development. ROOTACT is always specified, but is only used if SIMULATE_ET and UNSAT_ETAE are specified in the OPTIONS block. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "root activity function"
  type = "string"
  
  [children.gwf-nam.children.gwf-uzf.blocks.period.aux]
  shape = "(nper, naux)"
  block = "period"
  description = "represents the values of the auxiliary variables for each UZF. The values of auxiliary variables must be present for each UZF. The values must be specified in the order of the auxiliary variables specified in the OPTIONS block.  If the package supports time series and the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  optional = true
  longname = "auxiliary variables"
  type = "double"
  
  [children.gwf-nam.children.gwf-riv]
  name = "gwf-riv"
  schema_version = "1.2"
  parent = "gwf-nam"
  advanced = false
  multi = true
  ftype = "RIV"
  
  [children.gwf-nam.children.gwf-riv.blocks.options.auxiliary]
  shape = "(naux)"
  block = "options"
  description = "defines an array of one or more auxiliary variable names.  There is no limit on the number of auxiliary variables that can be provided on this line; however, lists of information provided in subsequent blocks must have a column of data for each auxiliary variable name defined here.   The number of auxiliary variables detected on this line determines the value for naux.  Comments cannot be provided anywhere on this line as they will be interpreted as auxiliary variable names.  Auxiliary variables may not be used by the package, but they will be available for use by other parts of the program.  The program will terminate with an error if auxiliary variables are specified on more than one line in the options block."
  reader = "urword"
  optional = true
  longname = "keyword to specify aux variables"
  type = "string"
  
  [children.gwf-nam.children.gwf-riv.blocks.options.auxmultname]
  block = "options"
  description = "name of auxiliary variable to be used as multiplier of riverbed conductance."
  reader = "urword"
  optional = true
  longname = "name of auxiliary variable for multiplier"
  type = "string"
  
  [children.gwf-nam.children.gwf-riv.blocks.options.boundnames]
  block = "options"
  description = "keyword to indicate that boundary names may be provided with the list of river cells."
  reader = "urword"
  optional = true
  type = "keyword"
  
  [children.gwf-nam.children.gwf-riv.blocks.options.print_input]
  block = "options"
  description = "keyword to indicate that the list of river information will be written to the listing file immediately after it is read."
  reader = "urword"
  optional = true
  longname = "print input to listing file"
  mf6internal = "iprpak"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-riv.blocks.options.print_flows]
  block = "options"
  description = "keyword to indicate that the list of river flow rates will be printed to the listing file for every stress period time step in which 'BUDGET PRINT' is specified in Output Control.  If there is no Output Control option and 'PRINT_FLOWS' is specified, then flow rates are printed for the last time step of each stress period."
  reader = "urword"
  optional = true
  longname = "print calculated flows to listing file"
  mf6internal = "iprflow"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-riv.blocks.options.save_flows]
  block = "options"
  description = "keyword to indicate that river flow terms will be written to the file specified with 'BUDGET FILEOUT' in Output Control."
  reader = "urword"
  optional = true
  longname = "save RIV flows to budget file"
  mf6internal = "ipakcb"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-riv.blocks.options.ts_filerecord]
  block = "options"
  reader = "urword"
  optional = true
  type = "record"
  
  [children.gwf-nam.children.gwf-riv.blocks.options.ts_filerecord.children.ts6]
  block = "options"
  description = "keyword to specify that record corresponds to a time-series file."
  reader = "urword"
  optional = false
  longname = "head keyword"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-riv.blocks.options.ts_filerecord.children.filein]
  block = "options"
  description = "keyword to specify that an input filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-riv.blocks.options.ts_filerecord.children.ts6_filename]
  block = "options"
  description = "defines a time-series file defining time series that can be used to assign time-varying values. See the 'Time-Variable Input' section for instructions on using the time-series capability."
  reader = "urword"
  optional = false
  longname = "file name of time series information"
  type = "string"
  
  [children.gwf-nam.children.gwf-riv.blocks.options.ts6]
  block = "options"
  description = "keyword to specify that record corresponds to a time-series file."
  reader = "urword"
  optional = false
  longname = "head keyword"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-riv.blocks.options.filein]
  block = "options"
  description = "keyword to specify that an input filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-riv.blocks.options.ts6_filename]
  block = "options"
  description = "defines a time-series file defining time series that can be used to assign time-varying values. See the 'Time-Variable Input' section for instructions on using the time-series capability."
  reader = "urword"
  optional = false
  longname = "file name of time series information"
  type = "string"
  
  [children.gwf-nam.children.gwf-riv.blocks.options.obs_filerecord]
  block = "options"
  reader = "urword"
  optional = true
  type = "record"
  
  [children.gwf-nam.children.gwf-riv.blocks.options.obs_filerecord.children.obs6]
  block = "options"
  description = "keyword to specify that record corresponds to an observations file."
  reader = "urword"
  optional = false
  longname = "obs keyword"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-riv.blocks.options.obs_filerecord.children.filein]
  block = "options"
  description = "keyword to specify that an input filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-riv.blocks.options.obs_filerecord.children.obs6_filename]
  block = "options"
  description = "name of input file to define observations for the RIV package. See the 'Observation utility' section for instructions for preparing observation input files. Table {#2} lists observation type(s) supported by the RIV package."
  reader = "urword"
  optional = false
  longname = "obs6 input filename"
  type = "string"
  
  [children.gwf-nam.children.gwf-riv.blocks.options.obs6]
  block = "options"
  description = "keyword to specify that record corresponds to an observations file."
  reader = "urword"
  optional = false
  longname = "obs keyword"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-riv.blocks.options.obs6_filename]
  block = "options"
  description = "name of input file to define observations for the RIV package. See the 'Observation utility' section for instructions for preparing observation input files. Table {#2} lists observation type(s) supported by the RIV package."
  reader = "urword"
  optional = false
  longname = "obs6 input filename"
  type = "string"
  
  [children.gwf-nam.children.gwf-riv.blocks.options.mover]
  block = "options"
  description = "keyword to indicate that this instance of the River Package can be used with the Water Mover (MVR) Package.  When the MOVER option is specified, additional memory is allocated within the package to store the available, provided, and received water."
  reader = "urword"
  optional = true
  type = "keyword"
  
  [children.gwf-nam.children.gwf-riv.blocks.dimensions.maxbound]
  block = "dimensions"
  description = "integer value specifying the maximum number of rivers cells that will be specified for use during any stress period."
  reader = "urword"
  optional = false
  longname = "maximum number of rivers"
  type = "integer"
  
  [children.gwf-nam.children.gwf-riv.blocks.period.iper]
  shape = "(nper, nnodes)"
  block = "period"
  description = "integer value specifying the starting stress period number for which the data specified in the PERIOD block apply.  IPER must be less than or equal to NPER in the TDIS Package and greater than zero.  The IPER value assigned to a stress period block must be greater than the IPER value assigned for the previous PERIOD block.  The information specified in the PERIOD block will continue to apply for all subsequent stress periods, unless the program encounters another PERIOD block."
  block_variable = true
  reader = "urword"
  optional = false
  longname = "stress period number"
  type = "integer"
  
  [children.gwf-nam.children.gwf-riv.blocks.period.stress_period_data]
  shape = "(nper, nnodes)"
  block = "period"
  reader = "urword"
  mf6internal = "spd"
  type = "list"
  
  [children.gwf-nam.children.gwf-riv.blocks.period.stress_period_data.children.stress_period_data]
  shape = "(maxbound)"
  block = "period"
  reader = "urword"
  mf6internal = "spd"
  type = "record"
  
  [children.gwf-nam.children.gwf-riv.blocks.period.stress_period_data.children.stress_period_data.children.cellid]
  shape = "(ncelldim)"
  block = "period"
  description = "is the cell identifier, and depends on the type of grid that is used for the simulation.  For a structured grid that uses the DIS input file, CELLID is the layer, row, and column.   For a grid that uses the DISV input file, CELLID is the layer and CELL2D number.  If the model uses the unstructured discretization (DISU) input file, CELLID is the node number for the cell."
  reader = "urword"
  longname = "cell identifier"
  type = "integer"
  
  [children.gwf-nam.children.gwf-riv.blocks.period.stress_period_data.children.stress_period_data.children.stage]
  block = "period"
  description = "is the head in the river. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "river stage"
  type = "double"
  
  [children.gwf-nam.children.gwf-riv.blocks.period.stress_period_data.children.stress_period_data.children.cond]
  block = "period"
  description = "is the riverbed hydraulic conductance. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "river conductance"
  type = "double"
  
  [children.gwf-nam.children.gwf-riv.blocks.period.stress_period_data.children.stress_period_data.children.rbot]
  block = "period"
  description = "is the elevation of the bottom of the riverbed.  If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "river bottom elevation"
  type = "double"
  
  [children.gwf-nam.children.gwf-riv.blocks.period.stress_period_data.children.stress_period_data.children.aux]
  shape = "(naux)"
  block = "period"
  description = "represents the values of the auxiliary variables for each river. The values of auxiliary variables must be present for each river. The values must be specified in the order of the auxiliary variables specified in the OPTIONS block.  If the package supports time series and the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  optional = true
  time_series = true
  longname = "auxiliary variables"
  mf6internal = "auxvar"
  type = "double"
  
  [children.gwf-nam.children.gwf-riv.blocks.period.stress_period_data.children.stress_period_data.children.boundname]
  block = "period"
  description = "name of the river cell.  BOUNDNAME is an ASCII character variable that can contain as many as 40 characters.  If BOUNDNAME contains spaces in it, then the entire name must be enclosed within single quotes."
  reader = "urword"
  optional = true
  longname = "river name"
  type = "string"
  
  [children.gwf-nam.children.gwf-riv.blocks.period.stage]
  shape = "(nper, nnodes)"
  block = "period"
  description = "is the head in the river. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "river stage"
  type = "double"
  
  [children.gwf-nam.children.gwf-riv.blocks.period.cond]
  shape = "(nper, nnodes)"
  block = "period"
  description = "is the riverbed hydraulic conductance. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "river conductance"
  type = "double"
  
  [children.gwf-nam.children.gwf-riv.blocks.period.rbot]
  shape = "(nper, nnodes)"
  block = "period"
  description = "is the elevation of the bottom of the riverbed.  If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "river bottom elevation"
  type = "double"
  
  [children.gwf-nam.children.gwf-riv.blocks.period.aux]
  shape = "(nper, nnodes, naux)"
  block = "period"
  description = "represents the values of the auxiliary variables for each river. The values of auxiliary variables must be present for each river. The values must be specified in the order of the auxiliary variables specified in the OPTIONS block.  If the package supports time series and the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  optional = true
  time_series = true
  longname = "auxiliary variables"
  mf6internal = "auxvar"
  type = "double"
  
  [children.gwf-nam.children.gwf-riv.blocks.period.boundname]
  shape = "(nper, nnodes)"
  block = "period"
  description = "name of the river cell.  BOUNDNAME is an ASCII character variable that can contain as many as 40 characters.  If BOUNDNAME contains spaces in it, then the entire name must be enclosed within single quotes."
  reader = "urword"
  optional = true
  longname = "river name"
  type = "string"
  
  [children.gwf-nam.children.gwf-ic]
  name = "gwf-ic"
  schema_version = "1.2"
  parent = "gwf-nam"
  advanced = false
  multi = false
  ftype = "IC"
  
  [children.gwf-nam.children.gwf-ic.blocks.options.export_array_ascii]
  block = "options"
  description = "keyword that specifies input griddata arrays should be written to layered ascii output files."
  reader = "urword"
  optional = true
  mf6internal = "export_ascii"
  longname = "export array variables to layered ascii files."
  type = "keyword"
  
  [children.gwf-nam.children.gwf-ic.blocks.options.export_array_netcdf]
  block = "options"
  description = "keyword that specifies input gridded arrays should be written to the model output NetCDF file with attributes that support using the generated file as a MODFLOW 6 simulation input.  This option only has an effect when an output model NetCDF file is configured and the simulation is run in VALIDATE mode, otherwise it is ignored."
  reader = "urword"
  optional = true
  mf6internal = "export_nc"
  longname = "export array variables to netcdf output files."
  extended = true
  type = "keyword"
  
  [children.gwf-nam.children.gwf-ic.blocks.griddata.strt]
  shape = "(nodes)"
  block = "griddata"
  description = "is the initial (starting) head---that is, head at the beginning of the GWF Model simulation.  STRT must be specified for all simulations, including steady-state simulations. One value is read for every model cell. For simulations in which the first stress period is steady state, the values used for STRT generally do not affect the simulation (exceptions may occur if cells go dry and (or) rewet). The execution time, however, will be less if STRT includes hydraulic heads that are close to the steady-state solution.  A head value lower than the cell bottom can be provided if a cell should start as dry."
  default = "1.0"
  reader = "readarray"
  layered = true
  netcdf = true
  longname = "starting head"
  type = "double"
  
  [children.gwf-nam.children.gwf-disv]
  name = "gwf-disv"
  schema_version = "1.2"
  parent = "gwf-nam"
  advanced = false
  multi = false
  ftype = "DISV"
  subcomponents = [
      "utl-ncf",
  ]
  
  [children.gwf-nam.children.gwf-disv.blocks.options.length_units]
  block = "options"
  description = "is the length units used for this model.  Values can be 'FEET', 'METERS', or 'CENTIMETERS'.  If not specified, the default is 'UNKNOWN'."
  reader = "urword"
  optional = true
  longname = "model length units"
  type = "string"
  
  [children.gwf-nam.children.gwf-disv.blocks.options.nogrb]
  block = "options"
  description = "keyword to deactivate writing of the binary grid file."
  reader = "urword"
  optional = true
  longname = "do not write binary grid file"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-disv.blocks.options.grb_filerecord]
  block = "options"
  reader = "urword"
  optional = true
