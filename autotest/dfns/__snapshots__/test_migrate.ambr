  [children.gwe-nam.children.gwe-dis.blocks.dimensions.nlay]
  block = "dimensions"
  description = "is the number of layers in the model grid."
  default = "1"
  reader = "urword"
  optional = false
  longname = "number of layers"
  type = "integer"
  
  [children.gwe-nam.children.gwe-dis.blocks.dimensions.nrow]
  block = "dimensions"
  description = "is the number of rows in the model grid."
  default = "2"
  reader = "urword"
  optional = false
  longname = "number of rows"
  type = "integer"
  
  [children.gwe-nam.children.gwe-dis.blocks.dimensions.ncol]
  block = "dimensions"
  description = "is the number of columns in the model grid."
  default = "2"
  reader = "urword"
  optional = false
  longname = "number of columns"
  type = "integer"
  
  [children.gwe-nam.children.gwe-dis.blocks.griddata.delr]
  shape = "(ncol)"
  block = "griddata"
  description = "is the column spacing in the row direction."
  default = "1.0"
  reader = "readarray"
  netcdf = true
  longname = "spacing along a row"
  type = "double"
  
  [children.gwe-nam.children.gwe-dis.blocks.griddata.delc]
  shape = "(nrow)"
  block = "griddata"
  description = "is the row spacing in the column direction."
  default = "1.0"
  reader = "readarray"
  netcdf = true
  longname = "spacing along a column"
  type = "double"
  
  [children.gwe-nam.children.gwe-dis.blocks.griddata.top]
  shape = "(ncol, nrow)"
  block = "griddata"
  description = "is the top elevation for each cell in the top model layer."
  default = "1.0"
  reader = "readarray"
  netcdf = true
  longname = "cell top elevation"
  type = "double"
  
  [children.gwe-nam.children.gwe-dis.blocks.griddata.botm]
  shape = "(ncol, nrow, nlay)"
  block = "griddata"
  description = "is the bottom elevation for each cell."
  default = "0."
  reader = "readarray"
  layered = true
  netcdf = true
  longname = "cell bottom elevation"
  type = "double"
  
  [children.gwe-nam.children.gwe-dis.blocks.griddata.idomain]
  shape = "(ncol, nrow, nlay)"
  block = "griddata"
  description = "is an optional array that characterizes the existence status of a cell.  If the IDOMAIN array is not specified, then all model cells exist within the solution.  If the IDOMAIN value for a cell is 0, the cell does not exist in the simulation.  Input and output values will be read and written for the cell, but internal to the program, the cell is excluded from the solution.  If the IDOMAIN value for a cell is 1, the cell exists in the simulation.  If the IDOMAIN value for a cell is -1, the cell does not exist in the simulation.  Furthermore, the first existing cell above will be connected to the first existing cell below.  This type of cell is referred to as a 'vertical pass through' cell."
  reader = "readarray"
  layered = true
  netcdf = true
  optional = true
  longname = "idomain existence array"
  type = "integer"
  
  [children.gwe-nam.children.gwe-lke]
  name = "gwe-lke"
  schema_version = "1.2"
  parent = "gwe-nam"
  advanced = false
  multi = true
  ftype = "LKE"
  
  [children.gwe-nam.children.gwe-lke.blocks.options.flow_package_name]
  block = "options"
  description = "keyword to specify the name of the corresponding flow package.  If not specified, then the corresponding flow package must have the same name as this advanced transport package (the name associated with this package in the GWE name file)."
  reader = "urword"
  optional = true
  longname = "keyword to specify name of corresponding flow package"
  type = "string"
  
  [children.gwe-nam.children.gwe-lke.blocks.options.auxiliary]
  shape = "(naux)"
  block = "options"
  description = "defines an array of one or more auxiliary variable names.  There is no limit on the number of auxiliary variables that can be provided on this line; however, lists of information provided in subsequent blocks must have a column of data for each auxiliary variable name defined here.   The number of auxiliary variables detected on this line determines the value for naux.  Comments cannot be provided anywhere on this line as they will be interpreted as auxiliary variable names.  Auxiliary variables may not be used by the package, but they will be available for use by other parts of the program.  The program will terminate with an error if auxiliary variables are specified on more than one line in the options block."
  reader = "urword"
  optional = true
  longname = "keyword to specify aux variables"
  type = "string"
  
  [children.gwe-nam.children.gwe-lke.blocks.options.flow_package_auxiliary_name]
  block = "options"
  description = "keyword to specify the name of an auxiliary variable in the corresponding flow package.  If specified, then the simulated temperatures from this advanced transport package will be copied into the auxiliary variable specified with this name.  Note that the flow package must have an auxiliary variable with this name or the program will terminate with an error.  If the flows for this advanced transport package are read from a file, then this option will have no effect."
  reader = "urword"
  optional = true
  longname = "keyword to specify name of temperature auxiliary variable in flow package"
  type = "string"
  
  [children.gwe-nam.children.gwe-lke.blocks.options.boundnames]
  block = "options"
  description = "keyword to indicate that boundary names may be provided with the list of lake cells."
  reader = "urword"
  optional = true
  type = "keyword"
  
  [children.gwe-nam.children.gwe-lke.blocks.options.print_input]
  block = "options"
  description = "keyword to indicate that the list of lake information will be written to the listing file immediately after it is read."
  reader = "urword"
  optional = true
  longname = "print input to listing file"
  type = "keyword"
  
  [children.gwe-nam.children.gwe-lke.blocks.options.print_temperature]
  block = "options"
  description = "keyword to indicate that the list of lake {#2} will be printed to the listing file for every stress period in which 'TEMPERATURE PRINT' is specified in Output Control.  If there is no Output Control option and PRINT_{#3} is specified, then {#2} are printed for the last time step of each stress period."
  reader = "urword"
  optional = true
  longname = "print calculated temperatures to listing file"
  type = "keyword"
  
  [children.gwe-nam.children.gwe-lke.blocks.options.print_flows]
  block = "options"
  description = "keyword to indicate that the list of lake flow rates will be printed to the listing file for every stress period time step in which 'BUDGET PRINT' is specified in Output Control.  If there is no Output Control option and 'PRINT_FLOWS' is specified, then flow rates are printed for the last time step of each stress period."
  reader = "urword"
  optional = true
  longname = "print calculated flows to listing file"
  type = "keyword"
  
  [children.gwe-nam.children.gwe-lke.blocks.options.save_flows]
  block = "options"
  description = "keyword to indicate that lake flow terms will be written to the file specified with 'BUDGET FILEOUT' in Output Control."
  reader = "urword"
  optional = true
  longname = "save lake flows to budget file"
  type = "keyword"
  
