  shape = "(naux)"
  block = "period"
  description = "represents the values of the auxiliary variables for each general-head boundary. The values of auxiliary variables must be present for each general-head boundary. The values must be specified in the order of the auxiliary variables specified in the OPTIONS block.  If the package supports time series and the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  optional = true
  time_series = true
  longname = "auxiliary variables"
  mf6internal = "auxvar"
  type = "double"
  
  [children.gwf-nam.children.gwf-ghb.blocks.period.stress_period_data.children.stress_period_data.children.boundname]
  block = "period"
  description = "name of the general-head boundary cell.  BOUNDNAME is an ASCII character variable that can contain as many as 40 characters.  If BOUNDNAME contains spaces in it, then the entire name must be enclosed within single quotes."
  reader = "urword"
  optional = true
  longname = "general-head boundary name"
  type = "string"
  
  [children.gwf-nam.children.gwf-ghb.blocks.period.bhead]
  shape = "(nper, nnodes)"
  block = "period"
  description = "is the boundary head. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "boundary head"
  type = "double"
  
  [children.gwf-nam.children.gwf-ghb.blocks.period.cond]
  shape = "(nper, nnodes)"
  block = "period"
  description = "is the hydraulic conductance of the interface between the aquifer cell and the boundary. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "boundary conductance"
  type = "double"
  
  [children.gwf-nam.children.gwf-ghb.blocks.period.aux]
  shape = "(nper, nnodes, naux)"
  block = "period"
  description = "represents the values of the auxiliary variables for each general-head boundary. The values of auxiliary variables must be present for each general-head boundary. The values must be specified in the order of the auxiliary variables specified in the OPTIONS block.  If the package supports time series and the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  optional = true
  time_series = true
  longname = "auxiliary variables"
  mf6internal = "auxvar"
  type = "double"
  
  [children.gwf-nam.children.gwf-ghb.blocks.period.boundname]
  shape = "(nper, nnodes)"
  block = "period"
  description = "name of the general-head boundary cell.  BOUNDNAME is an ASCII character variable that can contain as many as 40 characters.  If BOUNDNAME contains spaces in it, then the entire name must be enclosed within single quotes."
  reader = "urword"
  optional = true
  longname = "general-head boundary name"
  type = "string"
  
  [children.gwf-nam.children.gwf-vsc]
  name = "gwf-vsc"
  schema_version = "1.2"
  parent = "gwf-nam"
  advanced = false
  multi = false
  ftype = "VSC"
  
  [children.gwf-nam.children.gwf-vsc.blocks.options.viscref]
  block = "options"
  description = "fluid reference viscosity used in the equation of state.  This value is set to 1.0 if not specified as an option."
  default = "1.0"
  reader = "urword"
  optional = true
  longname = "reference viscosity"
  type = "double"
  
  [children.gwf-nam.children.gwf-vsc.blocks.options.temperature_species_name]
  block = "options"
  description = "string used to identify the auxspeciesname in PACKAGEDATA that corresponds to the temperature species.  There can be only one occurrence of this temperature species name in the PACKAGEDATA block or the program will terminate with an error.  This value has no effect if viscosity does not depend on temperature."
  reader = "urword"
  optional = true
  mf6internal = "temp_specname"
  longname = "auxspeciesname that corresponds to temperature"
  type = "string"
  
  [children.gwf-nam.children.gwf-vsc.blocks.options.thermal_formulation]
  block = "options"
  description = "may be used for specifying which viscosity formulation to use for the temperature species. Can be either LINEAR or NONLINEAR. The LINEAR viscosity formulation is the default."
  reader = "urword"
  optional = true
  valid = "linear nonlinear"
  mf6internal = "thermal_form"
  longname = "keyword to specify viscosity formulation for the temperature species"
  type = "string"
  
  [children.gwf-nam.children.gwf-vsc.blocks.options.thermal_a2]
  block = "options"
  description = "is an empirical parameter specified by the user for calculating viscosity using a nonlinear formulation.  If A2 is not specified, a default value of 10.0 is assigned (Voss, 1984)."
  default = "10."
  reader = "urword"
  optional = true
  longname = "coefficient used in nonlinear viscosity function"
  type = "double"
  
  [children.gwf-nam.children.gwf-vsc.blocks.options.thermal_a3]
  block = "options"
  description = "is an empirical parameter specified by the user for calculating viscosity using a nonlinear formulation.  If A3 is not specified, a default value of 248.37 is assigned (Voss, 1984)."
  default = "248.37"
  reader = "urword"
  optional = true
  longname = "coefficient used in nonlinear viscosity function"
  type = "double"
  
  [children.gwf-nam.children.gwf-vsc.blocks.options.thermal_a4]
  block = "options"
  description = "is an empirical parameter specified by the user for calculating viscosity using a nonlinear formulation.  If A4 is not specified, a default value of 133.15 is assigned (Voss, 1984)."
  default = "133.15"
  reader = "urword"
  optional = true
  longname = "coefficient used in nonlinear viscosity function"
  type = "double"
  
  [children.gwf-nam.children.gwf-vsc.blocks.options.viscosity_filerecord]
  block = "options"
  reader = "urword"
  optional = true
  mf6internal = "viscosity_fr"
  type = "record"
  
  [children.gwf-nam.children.gwf-vsc.blocks.options.viscosity_filerecord.children.viscosity]
  block = "options"
  description = "keyword to specify that record corresponds to viscosity."
  reader = "urword"
  optional = false
  longname = "viscosity keyword"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-vsc.blocks.options.viscosity_filerecord.children.fileout]
  block = "options"
  description = "keyword to specify that an output filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-vsc.blocks.options.viscosity_filerecord.children.viscosityfile]
  block = "options"
  description = "name of the binary output file to write viscosity information.  The viscosity file has the same format as the head file.  Viscosity values will be written to the viscosity file whenever heads are written to the binary head file.  The settings for controlling head output are contained in the Output Control option."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "string"
  
  [children.gwf-nam.children.gwf-vsc.blocks.options.viscosity]
  block = "options"
  description = "keyword to specify that record corresponds to viscosity."
  reader = "urword"
  optional = false
  longname = "viscosity keyword"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-vsc.blocks.options.fileout]
  block = "options"
  description = "keyword to specify that an output filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-vsc.blocks.options.viscosityfile]
  block = "options"
  description = "name of the binary output file to write viscosity information.  The viscosity file has the same format as the head file.  Viscosity values will be written to the viscosity file whenever heads are written to the binary head file.  The settings for controlling head output are contained in the Output Control option."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "string"
  
  [children.gwf-nam.children.gwf-vsc.blocks.dimensions.nviscspecies]
  block = "dimensions"
  description = "number of species used in the viscosity equation of state.  If either concentrations or temperature (or both) are used to update viscosity then nviscspecies needs to be at least one."
  reader = "urword"
  optional = false
  longname = "number of species used in viscosity equation of state"
  type = "integer"
  
  [children.gwf-nam.children.gwf-vsc.blocks.packagedata.packagedata]
  shape = "(nviscspecies)"
  block = "packagedata"
  reader = "urword"
  type = "list"
  
  [children.gwf-nam.children.gwf-vsc.blocks.packagedata.packagedata.children.packagedata]
  shape = "(nviscspecies)"
  block = "packagedata"
  reader = "urword"
  type = "record"
  
  [children.gwf-nam.children.gwf-vsc.blocks.packagedata.packagedata.children.packagedata.children.iviscspec]
  block = "packagedata"
  description = "integer value that defines the species number associated with the specified PACKAGEDATA data entered on each line. IVISCSPECIES must be greater than zero and less than or equal to NVISCSPECIES. Information must be specified for each of the NVISCSPECIES species or the program will terminate with an error.  The program will also terminate with an error if information for a species is specified more than once."
  reader = "urword"
  longname = "species number for this entry"
  numeric_index = true
  type = "integer"
  
  [children.gwf-nam.children.gwf-vsc.blocks.packagedata.packagedata.children.packagedata.children.dviscdc]
  block = "packagedata"
  description = "real value that defines the slope of the line defining the linear relationship between viscosity and temperature or between viscosity and concentration, depending on the type of species entered on each line.  If the value of AUXSPECIESNAME entered on a line corresponds to TEMPERATURE_SPECIES_NAME (in the OPTIONS block), this value will be used when VISCOSITY_FUNC is equal to LINEAR (the default) in the OPTIONS block.  When VISCOSITY_FUNC is set to NONLINEAR, a value for DVISCDC must be specified though it is not used."
  reader = "urword"
  longname = "slope of the line that defines the linear relationship between viscosity and temperature or between viscosity and concentration, depending on the type of species entered on each line."
  type = "double"
  
  [children.gwf-nam.children.gwf-vsc.blocks.packagedata.packagedata.children.packagedata.children.cviscref]
  block = "packagedata"
  description = "real value that defines the reference temperature or reference concentration value used for this species in the viscosity equation of state.  If AUXSPECIESNAME entered on a line corresponds to TEMPERATURE_SPECIES_NAME (in the OPTIONS block), then CVISCREF refers to a reference temperature, otherwise it refers to a reference concentration."
  reader = "urword"
  longname = "reference temperature value or reference concentration value"
  type = "double"
  
  [children.gwf-nam.children.gwf-vsc.blocks.packagedata.packagedata.children.packagedata.children.modelname]
  block = "packagedata"
  description = "name of a GWT or GWE model used to simulate a species that will be used in the viscosity equation of state.  This name will have no effect if the simulation does not include a GWT or GWE model that corresponds to this GWF model."
  reader = "urword"
  longname = "modelname"
  type = "string"
  
  [children.gwf-nam.children.gwf-vsc.blocks.packagedata.packagedata.children.packagedata.children.auxspeciesname]
  block = "packagedata"
  description = "name of an auxiliary variable in a GWF stress package that will be used for this species to calculate the viscosity values.  If a viscosity value is needed by the Viscosity Package then it will use the temperature or concentration values associated with this AUXSPECIESNAME in the viscosity equation of state.  For advanced stress packages (LAK, SFR, MAW, and UZF) that have an associated advanced transport package (LKT, SFT, MWT, and UZT), the FLOW_PACKAGE_AUXILIARY_NAME option in the advanced transport package can be used to transfer simulated temperature or concentration(s) into the flow package auxiliary variable.  In this manner, the Viscosity Package can calculate viscosity values for lakes, streams, multi-aquifer wells, and unsaturated zone flow cells using simulated concentrations."
  reader = "urword"
  longname = "auxspeciesname"
  type = "string"
  
  [children.gwf-nam.children.gwf-vsc.blocks.packagedata.iviscspec]
  block = "packagedata"
  description = "integer value that defines the species number associated with the specified PACKAGEDATA data entered on each line. IVISCSPECIES must be greater than zero and less than or equal to NVISCSPECIES. Information must be specified for each of the NVISCSPECIES species or the program will terminate with an error.  The program will also terminate with an error if information for a species is specified more than once."
  reader = "urword"
  longname = "species number for this entry"
  numeric_index = true
  type = "integer"
  
  [children.gwf-nam.children.gwf-vsc.blocks.packagedata.dviscdc]
  block = "packagedata"
  description = "real value that defines the slope of the line defining the linear relationship between viscosity and temperature or between viscosity and concentration, depending on the type of species entered on each line.  If the value of AUXSPECIESNAME entered on a line corresponds to TEMPERATURE_SPECIES_NAME (in the OPTIONS block), this value will be used when VISCOSITY_FUNC is equal to LINEAR (the default) in the OPTIONS block.  When VISCOSITY_FUNC is set to NONLINEAR, a value for DVISCDC must be specified though it is not used."
  reader = "urword"
  longname = "slope of the line that defines the linear relationship between viscosity and temperature or between viscosity and concentration, depending on the type of species entered on each line."
  type = "double"
  
  [children.gwf-nam.children.gwf-vsc.blocks.packagedata.cviscref]
  block = "packagedata"
  description = "real value that defines the reference temperature or reference concentration value used for this species in the viscosity equation of state.  If AUXSPECIESNAME entered on a line corresponds to TEMPERATURE_SPECIES_NAME (in the OPTIONS block), then CVISCREF refers to a reference temperature, otherwise it refers to a reference concentration."
  reader = "urword"
  longname = "reference temperature value or reference concentration value"
  type = "double"
  
  [children.gwf-nam.children.gwf-vsc.blocks.packagedata.modelname]
  block = "packagedata"
  description = "name of a GWT or GWE model used to simulate a species that will be used in the viscosity equation of state.  This name will have no effect if the simulation does not include a GWT or GWE model that corresponds to this GWF model."
  reader = "urword"
  longname = "modelname"
  type = "string"
  
  [children.gwf-nam.children.gwf-vsc.blocks.packagedata.auxspeciesname]
  block = "packagedata"
  description = "name of an auxiliary variable in a GWF stress package that will be used for this species to calculate the viscosity values.  If a viscosity value is needed by the Viscosity Package then it will use the temperature or concentration values associated with this AUXSPECIESNAME in the viscosity equation of state.  For advanced stress packages (LAK, SFR, MAW, and UZF) that have an associated advanced transport package (LKT, SFT, MWT, and UZT), the FLOW_PACKAGE_AUXILIARY_NAME option in the advanced transport package can be used to transfer simulated temperature or concentration(s) into the flow package auxiliary variable.  In this manner, the Viscosity Package can calculate viscosity values for lakes, streams, multi-aquifer wells, and unsaturated zone flow cells using simulated concentrations."
  reader = "urword"
  longname = "auxspeciesname"
  type = "string"
  
  [children.gwf-nam.children.gwf-lak]
  name = "gwf-lak"
  schema_version = "1.2"
  parent = "gwf-nam"
  advanced = true
  multi = true
  ftype = "LAK"
  
  [children.gwf-nam.children.gwf-lak.blocks.options.auxiliary]
  shape = "(naux)"
  block = "options"
  description = "defines an array of one or more auxiliary variable names.  There is no limit on the number of auxiliary variables that can be provided on this line; however, lists of information provided in subsequent blocks must have a column of data for each auxiliary variable name defined here.   The number of auxiliary variables detected on this line determines the value for naux.  Comments cannot be provided anywhere on this line as they will be interpreted as auxiliary variable names.  Auxiliary variables may not be used by the package, but they will be available for use by other parts of the program.  The program will terminate with an error if auxiliary variables are specified on more than one line in the options block."
  reader = "urword"
  optional = true
  longname = "keyword to specify aux variables"
  type = "string"
  
  [children.gwf-nam.children.gwf-lak.blocks.options.boundnames]
  block = "options"
  description = "keyword to indicate that boundary names may be provided with the list of lake cells."
  reader = "urword"
  optional = true
  type = "keyword"
  
  [children.gwf-nam.children.gwf-lak.blocks.options.print_input]
  block = "options"
  description = "keyword to indicate that the list of lake information will be written to the listing file immediately after it is read."
  reader = "urword"
  optional = true
  longname = "print input to listing file"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-lak.blocks.options.print_stage]
  block = "options"
  description = "keyword to indicate that the list of lake {#2} will be printed to the listing file for every stress period in which 'HEAD PRINT' is specified in Output Control.  If there is no Output Control option and PRINT_{#3} is specified, then {#2} are printed for the last time step of each stress period."
  reader = "urword"
  optional = true
  longname = "print calculated stages to listing file"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-lak.blocks.options.print_flows]
  block = "options"
  description = "keyword to indicate that the list of lake flow rates will be printed to the listing file for every stress period time step in which 'BUDGET PRINT' is specified in Output Control.  If there is no Output Control option and 'PRINT_FLOWS' is specified, then flow rates are printed for the last time step of each stress period."
  reader = "urword"
  optional = true
  longname = "print calculated flows to listing file"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-lak.blocks.options.save_flows]
  block = "options"
  description = "keyword to indicate that lake flow terms will be written to the file specified with 'BUDGET FILEOUT' in Output Control."
  reader = "urword"
  optional = true
  longname = "save lake flows to budget file"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-lak.blocks.options.stage_filerecord]
  block = "options"
  reader = "urword"
  optional = true
  type = "record"
  
