                    },
                    "obs6_filename": {
                      "block": "options",
                      "description": "name of input file to define observations for the ZDG package. See the 'Observation utility' section for instructions for preparing observation input files. Table {#2} lists observation type(s) supported by the ZDG package.",
                      "reader": "urword",
