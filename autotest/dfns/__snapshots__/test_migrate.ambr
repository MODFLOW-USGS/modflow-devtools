            "description": "name of the NetCDF structured output file.",
            "preserve_case": true,
            "in_record": true,
            "tagged": false,
            "extended": true
          }
        }
      },
      "nc_filerecord": {
        "block": "options",
        "type": "record",
        "reader": "urword",
        "optional": true,
        "description": "NetCDF filerecord",
        "tagged": true,
        "fields": {
          "netcdf": {
            "block": "options",
            "type": "keyword",
