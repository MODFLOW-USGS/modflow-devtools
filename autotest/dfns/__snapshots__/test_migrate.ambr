                  "mf6internal": "ipakcb",
                  "type": "keyword"
                },
                "obs_filerecord": {
                  "block": "options",
                  "reader": "urword",
                  "optional": true,
                  "type": "record",
                  "children": {
                    "obs6": {
                      "block": "options",
                      "description": "keyword to specify that record corresponds to an observations file.",
                      "reader": "urword",
