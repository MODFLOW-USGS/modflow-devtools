  [children.gwf-nam.children.gwf-uzf.blocks.options.budgetcsvfile]
  block = "options"
  description = "name of the comma-separated value (CSV) output file to write budget summary information.  A budget summary record will be written to this file for each time step of the simulation."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "string"
  
  [children.gwf-nam.children.gwf-uzf.blocks.options.package_convergence_filerecord]
  block = "options"
  reader = "urword"
  optional = true
