              auxiliaryrecord:
                shape: (nper)
                block: period
                reader: urword
                type: record
                children:
                  auxiliary:
                    block: period
                    description: keyword for specifying auxiliary variable.
                    reader: urword
                    type: keyword
                  auxname:
