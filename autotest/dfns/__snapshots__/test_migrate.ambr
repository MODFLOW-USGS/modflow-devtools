        "mf6internal": "ipakcb"
      },
      "ts_filerecord": {
        "block": "options",
        "type": "record",
        "reader": "urword",
        "optional": true,
        "tagged": true,
        "fields": {
          "ts6": {
            "block": "options",
            "type": "keyword",
            "reader": "urword",
            "optional": false,
            "longname": "head keyword",
            "description": "keyword to specify that record corresponds to a time-series file.",
            "in_record": true,
            "tagged": true
          },
          "filein": {
            "block": "options",
            "type": "keyword",
            "reader": "urword",
            "optional": false,
            "longname": "file keyword",
            "description": "keyword to specify that an input filename is expected next.",
            "in_record": true,
            "tagged": true
          },
          "ts6_filename": {
            "block": "options",
            "type": "string",
            "reader": "urword",
