  [attributes.sfacrecord_single]
  block = "attributes"
  type = "record"
  reader = "urword"
  optional = true
  description = "xxx"
  
  [attributes.sfacrecord_single.fields.sfacval]
  block = "attributes"
  type = "double precision"
  shape = "(<time_series_name)"
  reader = "urword"
  optional = "false"
