  layered = true
  netcdf = true
  longname = "drain elevation"
  type = "double"
  
  [children.gwf-nam.children.gwf-drng.blocks.period.cond]
  shape = "(nper, nodes)"
  block = "period"
  description = "is the hydraulic conductance of the interface between the aquifer and the drain."
  default = "3.e30"
  reader = "readarray"
  layered = true
  netcdf = true
  longname = "drain conductance"
  type = "double"
  
