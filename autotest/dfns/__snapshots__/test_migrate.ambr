  reader = "urword"
  type = "keyword"
  
  [children.gwt-nam.children.gwt-sft.blocks.period.reachperioddata.children.reachperioddata.children.reachsetting.children.auxiliaryrecord.children.auxname]
  block = "period"
  description = "name for the auxiliary variable to be assigned AUXVAL.  AUXNAME must match one of the auxiliary variable names defined in the OPTIONS block. If AUXNAME does not match one of the auxiliary variable names defined in the OPTIONS block the data are ignored."
  reader = "urword"
  type = "string"
  
  [children.gwt-nam.children.gwt-sft.blocks.period.reachperioddata.children.reachperioddata.children.reachsetting.children.auxiliaryrecord.children.auxval]
