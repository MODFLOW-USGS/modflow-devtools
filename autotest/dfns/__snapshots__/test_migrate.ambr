  [children.swf-nam.children.swf-dfw]
  name = "swf-dfw"
  schema_version = "1.2"
  parent = "swf-nam"
  advanced = false
  multi = false
  ftype = "DFW"
  
  [children.swf-nam.children.swf-dfw.blocks.options.central_in_space]
  block = "options"
  description = "keyword to indicate conductance should be calculated using central-in-space weighting instead of the default upstream weighting approach.  This option should be used with caution as it does not work well unless all of the stream reaches are saturated.  With this option, there is no way for water to flow into a dry reach from connected reaches."
  reader = "urword"
  optional = true
  longname = "use central in space weighting"
  mf6internal = "icentral"
  type = "keyword"
  
  [children.swf-nam.children.swf-dfw.blocks.options.length_conversion]
  block = "options"
  description = "real value that is used to convert user-specified Manning's roughness coefficients from meters to model length units. LENGTH_CONVERSION should be set to 3.28081, 1.0, and 100.0 when using length units (LENGTH_UNITS) of feet, meters, or centimeters in the simulation, respectively. LENGTH_CONVERSION does not need to be specified if LENGTH_UNITS are meters."
  reader = "urword"
  optional = true
  longname = "length conversion factor"
  mf6internal = "lengthconv"
  type = "double"
  
  [children.swf-nam.children.swf-dfw.blocks.options.time_conversion]
  block = "options"
  description = "real value that is used to convert user-specified Manning's roughness coefficients from seconds to model time units. TIME_CONVERSION should be set to 1.0, 60.0, 3,600.0, 86,400.0, and 31,557,600.0 when using time units (TIME_UNITS) of seconds, minutes, hours, days, or years in the simulation, respectively. TIME_CONVERSION does not need to be specified if TIME_UNITS are seconds."
  reader = "urword"
  optional = true
  longname = "time conversion factor"
  mf6internal = "timeconv"
  type = "double"
  
  [children.swf-nam.children.swf-dfw.blocks.options.save_flows]
  block = "options"
  description = "keyword to indicate that budget flow terms will be written to the file specified with 'BUDGET SAVE FILE' in Output Control."
  reader = "urword"
  optional = true
  longname = "keyword to save DFW flows"
  mf6internal = "ipakcb"
  type = "keyword"
  
  [children.swf-nam.children.swf-dfw.blocks.options.print_flows]
  block = "options"
  description = "keyword to indicate that calculated flows between cells will be printed to the listing file for every stress period time step in which 'BUDGET PRINT' is specified in Output Control. If there is no Output Control option and 'PRINT_FLOWS' is specified, then flow rates are printed for the last time step of each stress period.  This option can produce extremely large list files because all cell-by-cell flows are printed.  It should only be used with the DFW Package for models that have a small number of cells."
  reader = "urword"
  optional = true
  longname = "keyword to print DFW flows to listing file"
  mf6internal = "iprflow"
  type = "keyword"
  
  [children.swf-nam.children.swf-dfw.blocks.options.save_velocity]
  block = "options"
  description = "keyword to indicate that x, y, and z components of velocity will be calculated at cell centers and written to the budget file, which is specified with 'BUDGET SAVE FILE' in Output Control.  If this option is activated, then additional information may be required in the discretization packages and the GWF Exchange package (if GWF models are coupled).  Specifically, ANGLDEGX must be specified in the CONNECTIONDATA block of the DISU Package; ANGLDEGX must also be specified for the GWF Exchange as an auxiliary variable."
  reader = "urword"
  optional = true
  longname = "keyword to save velocity"
  mf6internal = "isavvelocity"
  type = "keyword"
  
  [children.swf-nam.children.swf-dfw.blocks.options.obs_filerecord]
  block = "options"
  reader = "urword"
  optional = true
  type = "record"
  
  [children.swf-nam.children.swf-dfw.blocks.options.obs_filerecord.children.obs6]
  block = "options"
  description = "keyword to specify that record corresponds to an observations file."
  reader = "urword"
  optional = false
  longname = "obs keyword"
  type = "keyword"
  
  [children.swf-nam.children.swf-dfw.blocks.options.obs_filerecord.children.filein]
  block = "options"
  description = "keyword to specify that an input filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.swf-nam.children.swf-dfw.blocks.options.obs_filerecord.children.obs6_filename]
  block = "options"
  description = "name of input file to define observations for the DFW package. See the 'Observation utility' section for instructions for preparing observation input files. Table {#2} lists observation type(s) supported by the DFW package."
  reader = "urword"
  optional = false
  longname = "obs6 input filename"
  type = "string"
  
  [children.swf-nam.children.swf-dfw.blocks.options.obs6]
  block = "options"
  description = "keyword to specify that record corresponds to an observations file."
  reader = "urword"
  optional = false
  longname = "obs keyword"
  type = "keyword"
  
  [children.swf-nam.children.swf-dfw.blocks.options.filein]
  block = "options"
  description = "keyword to specify that an input filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.swf-nam.children.swf-dfw.blocks.options.obs6_filename]
  block = "options"
  description = "name of input file to define observations for the DFW package. See the 'Observation utility' section for instructions for preparing observation input files. Table {#2} lists observation type(s) supported by the DFW package."
  reader = "urword"
  optional = false
  longname = "obs6 input filename"
  type = "string"
  
  [children.swf-nam.children.swf-dfw.blocks.options.export_array_ascii]
  block = "options"
  description = "keyword that specifies input griddata arrays should be written to layered ascii output files."
  reader = "urword"
  optional = true
  mf6internal = "export_ascii"
  longname = "export array variables to layered ascii files."
  type = "keyword"
  
  [children.swf-nam.children.swf-dfw.blocks.options.dev_swr_conductance]
  block = "options"
  description = "use the conductance formulation in the Surface Water Routing (SWR) Process for MODFLOW-2005."
  reader = "urword"
  optional = true
  longname = "use SWR conductance formulation"
  mf6internal = "iswrcond"
  type = "keyword"
  
  [children.swf-nam.children.swf-dfw.blocks.griddata.manningsn]
  shape = "(nodes)"
  block = "griddata"
  description = "mannings roughness coefficient"
  reader = "readarray"
  layered = false
  longname = "mannings roughness coefficient"
  type = "double"
  
  [children.swf-nam.children.swf-dfw.blocks.griddata.idcxs]
  shape = "(nodes)"
  block = "griddata"
  description = "integer value indication the cross section identifier in the Cross Section Package that applies to the reach.  If not provided then reach will be treated as hydraulically wide."
  reader = "readarray"
  layered = false
  optional = true
  longname = "cross section number"
  numeric_index = true
  type = "integer"
  
  [children.swf-nam.children.swf-sto]
  name = "swf-sto"
  schema_version = "1.2"
  parent = "swf-nam"
  advanced = false
  multi = false
  ftype = "STO"
  
  [children.swf-nam.children.swf-sto.blocks.options.save_flows]
  block = "options"
  description = "keyword to indicate that cell-by-cell flow terms will be written to the file specified with 'BUDGET SAVE FILE' in Output Control."
  reader = "urword"
  optional = true
  longname = "keyword to save NPF flows"
  mf6internal = "ipakcb"
  type = "keyword"
  
  [children.swf-nam.children.swf-sto.blocks.options.export_array_ascii]
  block = "options"
  description = "keyword that specifies input grid arrays, which already support the layered keyword, should be written to layered ascii output files."
  reader = "urword"
  optional = true
  mf6internal = "export_ascii"
  longname = "export array variables to layered ascii files."
  type = "keyword"
  
  [children.swf-nam.children.swf-sto.blocks.period.iper]
  shape = "(nper)"
  block = "period"
  description = "integer value specifying the starting stress period number for which the data specified in the PERIOD block apply.  IPER must be less than or equal to NPER in the TDIS Package and greater than zero.  The IPER value assigned to a stress period block must be greater than the IPER value assigned for the previous PERIOD block.  The information specified in the PERIOD block will continue to apply for all subsequent stress periods, unless the program encounters another PERIOD block."
  block_variable = true
  reader = "urword"
  optional = false
  longname = "stress period number"
  type = "integer"
  
  [children.swf-nam.children.swf-sto.blocks.period.steady-state]
  shape = "(nper)"
  block = "period"
  description = "keyword to indicate that stress period IPER is steady-state. Steady-state conditions will apply until the TRANSIENT keyword is specified in a subsequent BEGIN PERIOD block."
  reader = "urword"
  optional = true
  longname = "steady state indicator"
  mf6internal = "steady_state"
  type = "keyword"
  
  [children.swf-nam.children.swf-sto.blocks.period.transient]
  shape = "(nper)"
  block = "period"
  description = "keyword to indicate that stress period IPER is transient. Transient conditions will apply until the STEADY-STATE keyword is specified in a subsequent BEGIN PERIOD block."
  reader = "urword"
  optional = true
  longname = "transient indicator"
  type = "keyword"
  
  [children.swf-nam.children.swf-flw]
  name = "swf-flw"
  schema_version = "1.2"
  parent = "swf-nam"
  advanced = false
  multi = true
  ftype = "FLW"
  
  [children.swf-nam.children.swf-flw.blocks.options.auxiliary]
  shape = "(naux)"
  block = "options"
  description = "defines an array of one or more auxiliary variable names.  There is no limit on the number of auxiliary variables that can be provided on this line; however, lists of information provided in subsequent blocks must have a column of data for each auxiliary variable name defined here.   The number of auxiliary variables detected on this line determines the value for naux.  Comments cannot be provided anywhere on this line as they will be interpreted as auxiliary variable names.  Auxiliary variables may not be used by the package, but they will be available for use by other parts of the program.  The program will terminate with an error if auxiliary variables are specified on more than one line in the options block."
  reader = "urword"
  optional = true
  longname = "keyword to specify aux variables"
  type = "string"
  
  [children.swf-nam.children.swf-flw.blocks.options.auxmultname]
  block = "options"
  description = "name of auxiliary variable to be used as multiplier of flow rate."
  reader = "urword"
  optional = true
  longname = "name of auxiliary variable for multiplier"
  type = "string"
  
  [children.swf-nam.children.swf-flw.blocks.options.boundnames]
  block = "options"
  description = "keyword to indicate that boundary names may be provided with the list of inflow cells."
  reader = "urword"
  optional = true
  type = "keyword"
  
  [children.swf-nam.children.swf-flw.blocks.options.print_input]
  block = "options"
  description = "keyword to indicate that the list of inflow information will be written to the listing file immediately after it is read."
  reader = "urword"
  optional = true
  longname = "print input to listing file"
  type = "keyword"
  
  [children.swf-nam.children.swf-flw.blocks.options.print_flows]
  block = "options"
  description = "keyword to indicate that the list of inflow flow rates will be printed to the listing file for every stress period time step in which 'BUDGET PRINT' is specified in Output Control.  If there is no Output Control option and 'PRINT_FLOWS' is specified, then flow rates are printed for the last time step of each stress period."
  reader = "urword"
  optional = true
  longname = "print calculated flows to listing file"
  type = "keyword"
  
  [children.swf-nam.children.swf-flw.blocks.options.save_flows]
  block = "options"
  description = "keyword to indicate that inflow flow terms will be written to the file specified with 'BUDGET FILEOUT' in Output Control."
  reader = "urword"
  optional = true
  longname = "save well flows to budget file"
  type = "keyword"
  
  [children.swf-nam.children.swf-flw.blocks.options.ts_filerecord]
  block = "options"
  reader = "urword"
  optional = true
  type = "record"
  
  [children.swf-nam.children.swf-flw.blocks.options.ts_filerecord.children.ts6]
  block = "options"
  description = "keyword to specify that record corresponds to a time-series file."
  reader = "urword"
  optional = false
  longname = "head keyword"
  type = "keyword"
  
  [children.swf-nam.children.swf-flw.blocks.options.ts_filerecord.children.filein]
  block = "options"
  description = "keyword to specify that an input filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.swf-nam.children.swf-flw.blocks.options.ts_filerecord.children.ts6_filename]
  block = "options"
  description = "defines a time-series file defining time series that can be used to assign time-varying values. See the 'Time-Variable Input' section for instructions on using the time-series capability."
  reader = "urword"
  optional = false
  longname = "file name of time series information"
  type = "string"
  
  [children.swf-nam.children.swf-flw.blocks.options.ts6]
  block = "options"
  description = "keyword to specify that record corresponds to a time-series file."
  reader = "urword"
  optional = false
  longname = "head keyword"
  type = "keyword"
  
  [children.swf-nam.children.swf-flw.blocks.options.filein]
  block = "options"
  description = "keyword to specify that an input filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.swf-nam.children.swf-flw.blocks.options.ts6_filename]
  block = "options"
  description = "defines a time-series file defining time series that can be used to assign time-varying values. See the 'Time-Variable Input' section for instructions on using the time-series capability."
  reader = "urword"
  optional = false
  longname = "file name of time series information"
  type = "string"
  
  [children.swf-nam.children.swf-flw.blocks.options.obs_filerecord]
  block = "options"
  reader = "urword"
  optional = true
  type = "record"
  
  [children.swf-nam.children.swf-flw.blocks.options.obs_filerecord.children.obs6]
  block = "options"
  description = "keyword to specify that record corresponds to an observations file."
  reader = "urword"
  optional = false
  longname = "obs keyword"
  type = "keyword"
  
  [children.swf-nam.children.swf-flw.blocks.options.obs_filerecord.children.filein]
  block = "options"
  description = "keyword to specify that an input filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.swf-nam.children.swf-flw.blocks.options.obs_filerecord.children.obs6_filename]
  block = "options"
  description = "name of input file to define observations for the inflow package. See the 'Observation utility' section for instructions for preparing observation input files. Table {#2} lists observation type(s) supported by the inflow package."
  reader = "urword"
  optional = false
  longname = "obs6 input filename"
  type = "string"
  
  [children.swf-nam.children.swf-flw.blocks.options.obs6]
  block = "options"
  description = "keyword to specify that record corresponds to an observations file."
  reader = "urword"
  optional = false
  longname = "obs keyword"
  type = "keyword"
  
  [children.swf-nam.children.swf-flw.blocks.options.obs6_filename]
  block = "options"
  description = "name of input file to define observations for the inflow package. See the 'Observation utility' section for instructions for preparing observation input files. Table {#2} lists observation type(s) supported by the inflow package."
  reader = "urword"
  optional = false
  longname = "obs6 input filename"
  type = "string"
  
  [children.swf-nam.children.swf-flw.blocks.dimensions.maxbound]
  block = "dimensions"
  description = "integer value specifying the maximum number of inflow cells that will be specified for use during any stress period."
  reader = "urword"
  optional = false
  longname = "maximum number of inflow"
  type = "integer"
  
  [children.swf-nam.children.swf-flw.blocks.period.iper]
  shape = "(nper, nnodes)"
  block = "period"
  description = "integer value specifying the starting stress period number for which the data specified in the PERIOD block apply.  IPER must be less than or equal to NPER in the TDIS Package and greater than zero.  The IPER value assigned to a stress period block must be greater than the IPER value assigned for the previous PERIOD block.  The information specified in the PERIOD block will continue to apply for all subsequent stress periods, unless the program encounters another PERIOD block."
  block_variable = true
  reader = "urword"
  optional = false
  longname = "stress period number"
  type = "integer"
  
  [children.swf-nam.children.swf-flw.blocks.period.stress_period_data]
  shape = "(nper, nnodes)"
  block = "period"
  reader = "urword"
  mf6internal = "spd"
  type = "list"
  
  [children.swf-nam.children.swf-flw.blocks.period.stress_period_data.children.stress_period_data]
  shape = "(maxbound)"
  block = "period"
  reader = "urword"
  mf6internal = "spd"
  type = "record"
  
  [children.swf-nam.children.swf-flw.blocks.period.stress_period_data.children.stress_period_data.children.cellid]
  shape = "(ncelldim)"
  block = "period"
  description = "is the cell identifier, and depends on the type of grid that is used for the simulation.  For a structured grid that uses the DIS input file, CELLID is the layer, row, and column.   For a grid that uses the DISV input file, CELLID is the layer and CELL2D number.  If the model uses the unstructured discretization (DISU) input file, CELLID is the node number for the cell."
  reader = "urword"
  longname = "cell identifier"
  type = "integer"
  
  [children.swf-nam.children.swf-flw.blocks.period.stress_period_data.children.stress_period_data.children.q]
  block = "period"
  description = "is the volumetric inflow rate. A positive value indicates inflow to the stream.  Negative values are not allows. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "well rate"
  type = "double"
  
  [children.swf-nam.children.swf-flw.blocks.period.stress_period_data.children.stress_period_data.children.aux]
  shape = "(naux)"
  block = "period"
  description = "represents the values of the auxiliary variables for each inflow. The values of auxiliary variables must be present for each inflow. The values must be specified in the order of the auxiliary variables specified in the OPTIONS block.  If the package supports time series and the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  optional = true
  time_series = true
  longname = "auxiliary variables"
  type = "double"
  
  [children.swf-nam.children.swf-flw.blocks.period.stress_period_data.children.stress_period_data.children.boundname]
  block = "period"
  description = "name of the inflow cell.  BOUNDNAME is an ASCII character variable that can contain as many as 40 characters.  If BOUNDNAME contains spaces in it, then the entire name must be enclosed within single quotes."
  reader = "urword"
  optional = true
  longname = "inflow name"
  type = "string"
  
  [children.swf-nam.children.swf-flw.blocks.period.q]
  shape = "(nper, nnodes)"
  block = "period"
  description = "is the volumetric inflow rate. A positive value indicates inflow to the stream.  Negative values are not allows. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "well rate"
  type = "double"
  
  [children.swf-nam.children.swf-flw.blocks.period.aux]
  shape = "(nper, nnodes, naux)"
  block = "period"
  description = "represents the values of the auxiliary variables for each inflow. The values of auxiliary variables must be present for each inflow. The values must be specified in the order of the auxiliary variables specified in the OPTIONS block.  If the package supports time series and the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  optional = true
  time_series = true
  longname = "auxiliary variables"
  type = "double"
  
  [children.swf-nam.children.swf-flw.blocks.period.boundname]
  shape = "(nper, nnodes)"
  block = "period"
  description = "name of the inflow cell.  BOUNDNAME is an ASCII character variable that can contain as many as 40 characters.  If BOUNDNAME contains spaces in it, then the entire name must be enclosed within single quotes."
  reader = "urword"
  optional = true
  longname = "inflow name"
  type = "string"
  
  [children.swf-nam.children.swf-ic]
  name = "swf-ic"
  schema_version = "1.2"
  parent = "swf-nam"
  advanced = false
  multi = false
  ftype = "IC"
  
  [children.swf-nam.children.swf-ic.blocks.options.export_array_ascii]
  block = "options"
  description = "keyword that specifies input griddata arrays should be written to layered ascii output files."
  reader = "urword"
  optional = true
  mf6internal = "export_ascii"
  longname = "export array variables to layered ascii files."
  type = "keyword"
  
  [children.swf-nam.children.swf-ic.blocks.griddata.strt]
  shape = "(nodes)"
  block = "griddata"
  description = "is the initial (starting) stage---that is, stage at the beginning of the SWF Model simulation.  STRT must be specified for all SWF Model simulations. One value is read for every model reach."
  default = "0.0"
  reader = "readarray"
  layered = true
  longname = "starting concentration"
  type = "double"
  
  [children.exg-gwfgwf]
  name = "exg-gwfgwf"
  schema_version = "1.2"
  parent = "sim-nam"
  advanced = false
  multi = true
  ftype = "GWFGWF"
  
  [children.exg-gwfgwf.blocks.options.auxiliary]
  shape = "(naux)"
  block = "options"
  description = "an array of auxiliary variable names.  There is no limit on the number of auxiliary variables that can be provided. Most auxiliary variables will not be used by the GWF-GWF Exchange, but they will be available for use by other parts of the program.  If an auxiliary variable with the name 'ANGLDEGX' is found, then this information will be used as the angle (provided in degrees) between the connection face normal and the x axis, where a value of zero indicates that a normal vector points directly along the positive x axis.  The connection face normal is a normal vector on the cell face shared between the cell in model 1 and the cell in model 2 pointing away from the model 1 cell.  Additional information on 'ANGLDEGX' and when it is required is provided in the description of the DISU Package.  If an auxiliary variable with the name 'CDIST' is found, then this information will be used in the calculation of specific discharge within model cells connected by the exchange.  For a horizontal connection, CDIST should be specified as the horizontal distance between the cell centers, and should not include the vertical component.  For vertical connections, CDIST should be specified as the difference in elevation between the two cell centers.  Both ANGLDEGX and CDIST are required if specific discharge is calculated for either of the groundwater models."
  reader = "urword"
  optional = true
  longname = "keyword to specify aux variables"
  type = "string"
  
  [children.exg-gwfgwf.blocks.options.boundnames]
  block = "options"
  description = "keyword to indicate that boundary names may be provided with the list of GWF Exchange cells."
  reader = "urword"
  optional = true
  type = "keyword"
  
  [children.exg-gwfgwf.blocks.options.print_input]
  block = "options"
  description = "keyword to indicate that the list of exchange entries will be echoed to the listing file immediately after it is read."
  reader = "urword"
  optional = true
  longname = "keyword to print input to list file"
  mf6internal = "iprpak"
  type = "keyword"
  
  [children.exg-gwfgwf.blocks.options.print_flows]
  block = "options"
  description = "keyword to indicate that the list of exchange flow rates will be printed to the listing file for every stress period in which 'SAVE BUDGET' is specified in Output Control."
  reader = "urword"
  optional = true
  longname = "keyword to print gwfgwf flows to list file"
  mf6internal = "iprflow"
  type = "keyword"
  
  [children.exg-gwfgwf.blocks.options.save_flows]
  block = "options"
  description = "keyword to indicate that cell-by-cell flow terms will be written to the budget file for each model provided that the Output Control for the models are set up with the 'BUDGET SAVE FILE' option."
  reader = "urword"
  optional = true
  longname = "keyword to save GWFGWF flows"
  mf6internal = "ipakcb"
  type = "keyword"
  
  [children.exg-gwfgwf.blocks.options.cell_averaging]
  block = "options"
  description = "is a keyword and text keyword to indicate the method that will be used for calculating the conductance for horizontal cell connections.  The text value for CELL_AVERAGING can be 'HARMONIC', 'LOGARITHMIC', or 'AMT-LMK', which means 'arithmetic-mean thickness and logarithmic-mean hydraulic conductivity'. If the user does not specify a value for CELL_AVERAGING, then the harmonic-mean method will be used."
  valid = "harmonic logarithmic amt-lmk"
  reader = "urword"
  optional = true
  longname = "conductance weighting option"
  type = "string"
  
  [children.exg-gwfgwf.blocks.options.cvoptions]
  block = "options"
  description = "none"
  reader = "urword"
  optional = true
  longname = "vertical conductance options"
  type = "record"
  
  [children.exg-gwfgwf.blocks.options.cvoptions.children.variablecv]
  block = "options"
  description = "keyword to indicate that the vertical conductance will be calculated using the saturated thickness and properties of the overlying cell and the thickness and properties of the underlying cell.  If the DEWATERED keyword is also specified, then the vertical conductance is calculated using only the saturated thickness and properties of the overlying cell if the head in the underlying cell is below its top.  If these keywords are not specified, then the default condition is to calculate the vertical conductance at the start of the simulation using the initial head and the cell properties.  The vertical conductance remains constant for the entire simulation."
  reader = "urword"
  longname = "keyword to activate VARIABLECV option"
  type = "keyword"
  
  [children.exg-gwfgwf.blocks.options.cvoptions.children.dewatered]
  block = "options"
  description = "If the DEWATERED keyword is specified, then the vertical conductance is calculated using only the saturated thickness and properties of the overlying cell if the head in the underlying cell is below its top."
  reader = "urword"
  optional = true
  longname = "keyword to activate DEWATERED option"
  type = "keyword"
  
  [children.exg-gwfgwf.blocks.options.variablecv]
  block = "options"
  description = "keyword to indicate that the vertical conductance will be calculated using the saturated thickness and properties of the overlying cell and the thickness and properties of the underlying cell.  If the DEWATERED keyword is also specified, then the vertical conductance is calculated using only the saturated thickness and properties of the overlying cell if the head in the underlying cell is below its top.  If these keywords are not specified, then the default condition is to calculate the vertical conductance at the start of the simulation using the initial head and the cell properties.  The vertical conductance remains constant for the entire simulation."
  reader = "urword"
  longname = "keyword to activate VARIABLECV option"
  type = "keyword"
  
  [children.exg-gwfgwf.blocks.options.dewatered]
  block = "options"
  description = "If the DEWATERED keyword is specified, then the vertical conductance is calculated using only the saturated thickness and properties of the overlying cell if the head in the underlying cell is below its top."
  reader = "urword"
  optional = true
  longname = "keyword to activate DEWATERED option"
  type = "keyword"
  
  [children.exg-gwfgwf.blocks.options.newton]
  block = "options"
  description = "keyword that activates the Newton-Raphson formulation for groundwater flow between connected, convertible groundwater cells. Cells will not dry when this option is used."
  reader = "urword"
  optional = true
  longname = "keyword to activate Newton-Raphson"
  type = "keyword"
  
  [children.exg-gwfgwf.blocks.options.xt3d]
  block = "options"
  description = "keyword that activates the XT3D formulation between the cells connected with this GWF-GWF Exchange."
  reader = "urword"
  optional = true
  longname = "keyword to activate XT3D"
  type = "keyword"
  
  [children.exg-gwfgwf.blocks.options.gnc_filerecord]
  block = "options"
  reader = "urword"
  optional = true
  type = "record"
  
  [children.exg-gwfgwf.blocks.options.gnc_filerecord.children.gnc6]
  block = "options"
  description = "keyword to specify that record corresponds to a ghost-node correction file."
  reader = "urword"
  optional = false
  longname = "gnc6 keyword"
  type = "keyword"
  
  [children.exg-gwfgwf.blocks.options.gnc_filerecord.children.filein]
  block = "options"
  description = "keyword to specify that an input filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.exg-gwfgwf.blocks.options.gnc_filerecord.children.gnc6_filename]
  block = "options"
  description = "is the file name for ghost node correction input file.  Information for the ghost nodes are provided in the file provided with these keywords.  The format for specifying the ghost nodes is the same as described for the GNC Package of the GWF Model.  This includes specifying OPTIONS, DIMENSIONS, and GNCDATA blocks.  The order of the ghost nodes must follow the same order as the order of the cells in the EXCHANGEDATA block.  For the GNCDATA, noden and all of the nodej values are assumed to be located in model 1, and nodem is assumed to be in model 2."
  reader = "urword"
  optional = false
  longname = "gnc6 input filename"
  type = "string"
  
  [children.exg-gwfgwf.blocks.options.filein]
  block = "options"
  description = "keyword to specify that an input filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.exg-gwfgwf.blocks.options.gnc6]
  block = "options"
  description = "keyword to specify that record corresponds to a ghost-node correction file."
  reader = "urword"
  optional = false
  longname = "gnc6 keyword"
  type = "keyword"
  
  [children.exg-gwfgwf.blocks.options.gnc6_filename]
  block = "options"
  description = "is the file name for ghost node correction input file.  Information for the ghost nodes are provided in the file provided with these keywords.  The format for specifying the ghost nodes is the same as described for the GNC Package of the GWF Model.  This includes specifying OPTIONS, DIMENSIONS, and GNCDATA blocks.  The order of the ghost nodes must follow the same order as the order of the cells in the EXCHANGEDATA block.  For the GNCDATA, noden and all of the nodej values are assumed to be located in model 1, and nodem is assumed to be in model 2."
  reader = "urword"
  optional = false
  longname = "gnc6 input filename"
  type = "string"
  
  [children.exg-gwfgwf.blocks.options.mvr_filerecord]
  block = "options"
  reader = "urword"
  optional = true
  type = "record"
  
  [children.exg-gwfgwf.blocks.options.mvr_filerecord.children.mvr6]
  block = "options"
  description = "keyword to specify that record corresponds to a mover file."
  reader = "urword"
  optional = false
  longname = "obs keyword"
  type = "keyword"
  
  [children.exg-gwfgwf.blocks.options.mvr_filerecord.children.filein]
  block = "options"
  description = "keyword to specify that an input filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.exg-gwfgwf.blocks.options.mvr_filerecord.children.mvr6_filename]
  block = "options"
  description = "is the file name of the water mover input file to apply to this exchange.  Information for the water mover are provided in the file provided with these keywords.  The format for specifying the water mover information is the same as described for the Water Mover (MVR) Package of the GWF Model, with two exceptions.  First, in the PACKAGES block, the model name must be included as a separate string before each package.  Second, the appropriate model name must be included before package name 1 and package name 2 in the BEGIN PERIOD block.  This allows providers and receivers to be located in both models listed as part of this exchange."
  reader = "urword"
  optional = false
  longname = "mvr6 input filename"
  type = "string"
  
  [children.exg-gwfgwf.blocks.options.mvr6]
  block = "options"
  description = "keyword to specify that record corresponds to a mover file."
  reader = "urword"
  optional = false
  longname = "obs keyword"
  type = "keyword"
  
  [children.exg-gwfgwf.blocks.options.mvr6_filename]
  block = "options"
  description = "is the file name of the water mover input file to apply to this exchange.  Information for the water mover are provided in the file provided with these keywords.  The format for specifying the water mover information is the same as described for the Water Mover (MVR) Package of the GWF Model, with two exceptions.  First, in the PACKAGES block, the model name must be included as a separate string before each package.  Second, the appropriate model name must be included before package name 1 and package name 2 in the BEGIN PERIOD block.  This allows providers and receivers to be located in both models listed as part of this exchange."
  reader = "urword"
  optional = false
  longname = "mvr6 input filename"
  type = "string"
  
  [children.exg-gwfgwf.blocks.options.obs_filerecord]
  block = "options"
  reader = "urword"
  optional = true
  type = "record"
  
  [children.exg-gwfgwf.blocks.options.obs_filerecord.children.obs6]
  block = "options"
  description = "keyword to specify that record corresponds to an observations file."
  reader = "urword"
  optional = false
  longname = "obs keyword"
  type = "keyword"
  
  [children.exg-gwfgwf.blocks.options.obs_filerecord.children.filein]
  block = "options"
  description = "keyword to specify that an input filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.exg-gwfgwf.blocks.options.obs_filerecord.children.obs6_filename]
  block = "options"
  description = "is the file name of the observations input file for this exchange. See the 'Observation utility' section for instructions for preparing observation input files. Table ref{table:gwf-obstypetable} lists observation type(s) supported by the GWF-GWF package."
  reader = "urword"
  optional = false
  longname = "obs6 input filename"
  type = "string"
  
  [children.exg-gwfgwf.blocks.options.obs6]
  block = "options"
  description = "keyword to specify that record corresponds to an observations file."
  reader = "urword"
  optional = false
  longname = "obs keyword"
  type = "keyword"
  
  [children.exg-gwfgwf.blocks.options.obs6_filename]
  block = "options"
  description = "is the file name of the observations input file for this exchange. See the 'Observation utility' section for instructions for preparing observation input files. Table ref{table:gwf-obstypetable} lists observation type(s) supported by the GWF-GWF package."
  reader = "urword"
  optional = false
  longname = "obs6 input filename"
  type = "string"
  
  [children.exg-gwfgwf.blocks.options.dev_interfacemodel_on]
  block = "options"
  description = "activates the interface model mechanism for calculating the coefficients at (and possibly near) the exchange. This keyword should only be used for development purposes."
  reader = "urword"
  optional = true
  longname = "activate interface model on exchange"
  mf6internal = "dev_ifmod_on"
  type = "keyword"
  
  [children.exg-gwfgwf.blocks.dimensions.nexg]
  block = "dimensions"
  description = "keyword and integer value specifying the number of GWF-GWF exchanges."
  reader = "urword"
  optional = false
  longname = "number of exchanges"
  type = "integer"
  
  [children.exg-gwfgwf.blocks.exchangedata.exchangedata]
  shape = "(nexg)"
  block = "exchangedata"
  reader = "urword"
  optional = false
  longname = "exchange data"
  type = "list"
  
  [children.exg-gwfgwf.blocks.exchangedata.exchangedata.children.exchangedata]
  shape = "(nexg)"
  block = "exchangedata"
  reader = "urword"
  optional = false
  longname = "exchange data"
  type = "record"
  
  [children.exg-gwfgwf.blocks.exchangedata.exchangedata.children.exchangedata.children.cellidm1]
  block = "exchangedata"
  description = "is the cellid of the cell in model 1 as specified in the simulation name file. For a structured grid that uses the DIS input file, CELLIDM1 is the layer, row, and column numbers of the cell.   For a grid that uses the DISV input file, CELLIDM1 is the layer number and CELL2D number for the two cells.  If the model uses the unstructured discretization (DISU) input file, then CELLIDM1 is the node number for the cell."
  reader = "urword"
  optional = false
  longname = "cellid of first cell"
  numeric_index = true
  type = "integer"
  
  [children.exg-gwfgwf.blocks.exchangedata.exchangedata.children.exchangedata.children.cellidm2]
  block = "exchangedata"
  description = "is the cellid of the cell in model 2 as specified in the simulation name file. For a structured grid that uses the DIS input file, CELLIDM2 is the layer, row, and column numbers of the cell.   For a grid that uses the DISV input file, CELLIDM2 is the layer number and CELL2D number for the two cells.  If the model uses the unstructured discretization (DISU) input file, then CELLIDM2 is the node number for the cell."
  reader = "urword"
  optional = false
  longname = "cellid of second cell"
  numeric_index = true
  type = "integer"
  
  [children.exg-gwfgwf.blocks.exchangedata.exchangedata.children.exchangedata.children.ihc]
  block = "exchangedata"
  description = "is an integer flag indicating the direction between node n and all of its m connections. If IHC = 0 then the connection is vertical.  If IHC = 1 then the connection is horizontal. If IHC = 2 then the connection is horizontal for a vertically staggered grid."
  reader = "urword"
  optional = false
  longname = "integer flag for connection type"
  type = "integer"
  
  [children.exg-gwfgwf.blocks.exchangedata.exchangedata.children.exchangedata.children.cl1]
  block = "exchangedata"
  description = "is the distance between the center of cell 1 and the its shared face with cell 2."
  reader = "urword"
  optional = false
  longname = "connection distance"
  type = "double"
  
  [children.exg-gwfgwf.blocks.exchangedata.exchangedata.children.exchangedata.children.cl2]
  block = "exchangedata"
  description = "is the distance between the center of cell 2 and the its shared face with cell 1."
  reader = "urword"
  optional = false
  longname = "connection distance"
  type = "double"
  
  [children.exg-gwfgwf.blocks.exchangedata.exchangedata.children.exchangedata.children.hwva]
  block = "exchangedata"
  description = "is the horizontal width of the flow connection between cell 1 and cell 2 if IHC $>$ 0, or it is the area perpendicular to flow of the vertical connection between cell 1 and cell 2 if IHC = 0."
  reader = "urword"
  optional = false
  longname = "horizontal cell width or area for vertical flow"
  type = "double"
  
  [children.exg-gwfgwf.blocks.exchangedata.exchangedata.children.exchangedata.children.aux]
  shape = "(naux)"
  block = "exchangedata"
  description = "represents the values of the auxiliary variables for each GWFGWF Exchange. The values of auxiliary variables must be present for each exchange. The values must be specified in the order of the auxiliary variables specified in the OPTIONS block."
  reader = "urword"
  optional = true
  longname = "auxiliary variables"
  mf6internal = "auxvar"
  type = "double"
  
  [children.exg-gwfgwf.blocks.exchangedata.exchangedata.children.exchangedata.children.boundname]
  block = "exchangedata"
  description = "name of the GWF Exchange cell.  BOUNDNAME is an ASCII character variable that can contain as many as 40 characters.  If BOUNDNAME contains spaces in it, then the entire name must be enclosed within single quotes."
  reader = "urword"
  optional = true
  longname = "exchange boundname"
  type = "string"
  
  [children.exg-gwfgwf.blocks.exchangedata.cellidm1]
  block = "exchangedata"
  description = "is the cellid of the cell in model 1 as specified in the simulation name file. For a structured grid that uses the DIS input file, CELLIDM1 is the layer, row, and column numbers of the cell.   For a grid that uses the DISV input file, CELLIDM1 is the layer number and CELL2D number for the two cells.  If the model uses the unstructured discretization (DISU) input file, then CELLIDM1 is the node number for the cell."
  reader = "urword"
  optional = false
  longname = "cellid of first cell"
  numeric_index = true
  type = "integer"
  
  [children.exg-gwfgwf.blocks.exchangedata.cellidm2]
  block = "exchangedata"
  description = "is the cellid of the cell in model 2 as specified in the simulation name file. For a structured grid that uses the DIS input file, CELLIDM2 is the layer, row, and column numbers of the cell.   For a grid that uses the DISV input file, CELLIDM2 is the layer number and CELL2D number for the two cells.  If the model uses the unstructured discretization (DISU) input file, then CELLIDM2 is the node number for the cell."
  reader = "urword"
  optional = false
  longname = "cellid of second cell"
  numeric_index = true
  type = "integer"
  
  [children.exg-gwfgwf.blocks.exchangedata.ihc]
  block = "exchangedata"
  description = "is an integer flag indicating the direction between node n and all of its m connections. If IHC = 0 then the connection is vertical.  If IHC = 1 then the connection is horizontal. If IHC = 2 then the connection is horizontal for a vertically staggered grid."
  reader = "urword"
  optional = false
  longname = "integer flag for connection type"
  type = "integer"
  
  [children.exg-gwfgwf.blocks.exchangedata.cl1]
  block = "exchangedata"
  description = "is the distance between the center of cell 1 and the its shared face with cell 2."
  reader = "urword"
  optional = false
  longname = "connection distance"
  type = "double"
  
  [children.exg-gwfgwf.blocks.exchangedata.cl2]
  block = "exchangedata"
  description = "is the distance between the center of cell 2 and the its shared face with cell 1."
  reader = "urword"
  optional = false
  longname = "connection distance"
  type = "double"
  
  [children.exg-gwfgwf.blocks.exchangedata.hwva]
  block = "exchangedata"
  description = "is the horizontal width of the flow connection between cell 1 and cell 2 if IHC $>$ 0, or it is the area perpendicular to flow of the vertical connection between cell 1 and cell 2 if IHC = 0."
  reader = "urword"
  optional = false
  longname = "horizontal cell width or area for vertical flow"
  type = "double"
  
  [children.exg-gwfgwf.blocks.exchangedata.aux]
  shape = "(naux)"
  block = "exchangedata"
  description = "represents the values of the auxiliary variables for each GWFGWF Exchange. The values of auxiliary variables must be present for each exchange. The values must be specified in the order of the auxiliary variables specified in the OPTIONS block."
  reader = "urword"
  optional = true
  longname = "auxiliary variables"
  mf6internal = "auxvar"
  type = "double"
  
  [children.exg-gwfgwf.blocks.exchangedata.boundname]
  block = "exchangedata"
  description = "name of the GWF Exchange cell.  BOUNDNAME is an ASCII character variable that can contain as many as 40 characters.  If BOUNDNAME contains spaces in it, then the entire name must be enclosed within single quotes."
  reader = "urword"
  optional = true
  longname = "exchange boundname"
  type = "string"
  
  '''
# ---
# name: test_migrate_v1_2[yaml]
  '''
  name: sim-nam
  schema_version: '1.2'
  advanced: false
  multi: false
  ftype: NAM
  blocks:
    options:
      continue:
        block: options
        description: keyword flag to indicate that the simulation should continue even if one or more solutions
          do not converge.
        reader: urword
        optional: true
        longname: continue if not converged
        type: keyword
      nocheck:
        block: options
        description: keyword flag to indicate that the model input check routines should not be called prior
          to each time step. Checks are performed by default.
        reader: urword
        optional: true
        longname: turn off checking
        type: keyword
      memory_print_option:
        block: options
        description: is a flag that controls printing of detailed memory manager usage to the end of the
          simulation list file.  NONE means do not print detailed information. SUMMARY means print only
          the total memory for each simulation component. ALL means print information for each variable
          stored in the memory manager. NONE is default if MEMORY_PRINT_OPTION is not specified.
        reader: urword
        optional: true
        longname: memory print option
        mf6internal: prmem
        type: string
      profile_option:
        block: options
        description: is a flag that controls performance profiling and reporting.  NONE disables profiling.
          SUMMARY means to measure and print a coarse performance profile. DETAIL means collect and print
          information with the highest resolution available. NONE is default if PROFILE_OPTION is not specified.
        reader: urword
        optional: true
        longname: profiling option
        mf6internal: prprof
        type: string
      maxerrors:
        block: options
        description: maximum number of errors that will be stored and printed.
        reader: urword
        optional: true
        longname: maximum number of errors
        type: integer
      print_input:
        block: options
        description: keyword to activate printing of simulation input summaries to the simulation list file
          (mfsim.lst). With this keyword, input summaries will be written for those packages that support
          newer input data model routines.  Not all packages are supported yet by the newer input data model
          routines.
        reader: urword
        optional: true
        longname: print input to listing file
        type: keyword
      hpc_filerecord:
        block: options
        description: hpc record
        reader: urword
        optional: true
        type: record
        children:
          hpc6:
            block: options
            description: keyword to specify that record corresponds to a hpc file.
            reader: urword
            optional: false
            longname: head keyword
            extended: true
            type: keyword
          filein:
            block: options
            description: keyword to specify that an input filename is expected next.
            reader: urword
            optional: false
            longname: file keyword
            type: keyword
          hpc6_filename:
            block: options
            description: name of input file to define HPC file settings for the HPC package. See the 'HPC
              File' section for instructions for preparing HPC input files.
            reader: urword
            optional: false
            longname: file name of time series information
            extended: true
            type: string
      hpc6:
        block: options
        description: keyword to specify that record corresponds to a hpc file.
        reader: urword
        optional: false
        longname: head keyword
        extended: true
        type: keyword
      filein:
        block: options
        description: keyword to specify that an input filename is expected next.
        reader: urword
        optional: false
        longname: file keyword
        type: keyword
      hpc6_filename:
        block: options
        description: name of input file to define HPC file settings for the HPC package. See the 'HPC File'
          section for instructions for preparing HPC input files.
        reader: urword
        optional: false
        longname: file name of time series information
        extended: true
        type: string
    timing:
      tdis6:
        block: timing
        description: is the name of the Temporal Discretization (TDIS) Input File.
        reader: urword
        longname: name of tdis input file
        type: string
    models:
      models:
        block: models
        description: is the list of model types, model name files, and model names.
        reader: urword
        longname: list of models
        type: list
        children:
          models:
            block: models
            description: is the record of model types, model name files, and model names.
            reader: urword
            longname: list of models
            type: record
            children:
              mtype:
                block: models
                description: is the type of model to add to simulation.
                reader: urword
                longname: model type
                type: string
              mfname:
                block: models
                description: is the file name of the model name file.
                reader: urword
                longname: file name for model name file
                type: string
              mname:
                block: models
                description: is the user-assigned name of the model.  The model name cannot exceed 16 characters
                  and must not have blanks within the name.  The model name is case insensitive; any lowercase
                  letters are converted and stored as upper case letters.
                reader: urword
                longname: name of model
                type: string
      mtype:
        block: models
        description: is the type of model to add to simulation.
        reader: urword
        longname: model type
        type: string
      mfname:
        block: models
        description: is the file name of the model name file.
        reader: urword
        longname: file name for model name file
        type: string
      mname:
        block: models
        description: is the user-assigned name of the model.  The model name cannot exceed 16 characters
          and must not have blanks within the name.  The model name is case insensitive; any lowercase letters
          are converted and stored as upper case letters.
        reader: urword
        longname: name of model
        type: string
    exchanges:
      exchanges:
        block: exchanges
        description: is the list of exchange types, exchange files, and model names.
        reader: urword
        longname: list of exchanges
        type: list
        children:
          exchanges:
            block: exchanges
            description: is the record of exchange types, exchange files, and model names.
            reader: urword
            longname: list of exchanges
            type: record
            children:
              exgtype:
                block: exchanges
                description: is the exchange type.
                reader: urword
                longname: exchange type
                type: string
              exgfile:
                block: exchanges
                description: is the input file for the exchange.
                reader: urword
                longname: input file for exchange
                type: string
              exgmnamea:
                block: exchanges
                description: is the name of the first model that is part of this exchange.
                reader: urword
                longname: name of model A
                type: string
              exgmnameb:
                block: exchanges
                description: is the name of the second model that is part of this exchange.
                reader: urword
                longname: name of model B
                type: string
      exgtype:
        block: exchanges
        description: is the exchange type.
        reader: urword
        longname: exchange type
        type: string
      exgfile:
        block: exchanges
        description: is the input file for the exchange.
        reader: urword
        longname: input file for exchange
        type: string
      exgmnamea:
        block: exchanges
        description: is the name of the first model that is part of this exchange.
        reader: urword
        longname: name of model A
        type: string
      exgmnameb:
        block: exchanges
        description: is the name of the second model that is part of this exchange.
        reader: urword
        longname: name of model B
        type: string
    solutiongroup:
      group_num:
        block: solutiongroup
        description: is the group number of the solution group.  Solution groups must be numbered sequentially,
          starting with group number one.
        block_variable: true
        reader: urword
        type: integer
      mxiter:
        block: solutiongroup
        description: is the maximum number of outer iterations for this solution group.  The default value
          is 1.  If there is only one solution in the solution group, then MXITER must be 1.
        reader: urword
        optional: true
        longname: maximum solution group iterations
        type: integer
      solutiongroup:
        block: solutiongroup
        description: is the list of solution types and models in the solution.
        reader: urword
        longname: solution type and models in the solution
        type: list
        children:
          solutiongroup:
            block: solutiongroup
            description: is the record of solution types and models in the solution.
            reader: urword
            longname: solution type and models in the solution
            type: record
            children:
              slntype:
                block: solutiongroup
                description: is the type of solution.  The Integrated Model Solution (IMS6) and Explicit
                  Model Solution (EMS6) are the only supported options in this version.
                valid: ims6 ems6
                reader: urword
                longname: type of solution
                type: string
              slnfname:
                block: solutiongroup
                description: name of file containing solution input.
                reader: urword
                longname: file name for solution input
                type: string
              slnmnames:
                shape: (any1d)
                block: solutiongroup
                description: is the array of model names to add to this solution.  The number of model names
                  is determined by the number of model names the user provides on this line.
                reader: urword
                longname: array of model names in this solution
                type: string
      slntype:
        block: solutiongroup
        description: is the type of solution.  The Integrated Model Solution (IMS6) and Explicit Model Solution
          (EMS6) are the only supported options in this version.
        valid: ims6 ems6
        reader: urword
        longname: type of solution
        type: string
      slnfname:
        block: solutiongroup
        description: name of file containing solution input.
        reader: urword
        longname: file name for solution input
        type: string
      slnmnames:
        shape: (any1d)
        block: solutiongroup
        description: is the array of model names to add to this solution.  The number of model names is
          determined by the number of model names the user provides on this line.
        reader: urword
        longname: array of model names in this solution
        type: string
  children:
    chf-nam:
      name: chf-nam
      schema_version: '1.2'
      parent: sim-nam
      advanced: false
      multi: false
      ftype: NAM
      blocks:
        options:
          list:
            block: options
            description: is name of the listing file to create for this CHF model.  If not specified, then
              the name of the list file will be the basename of the CHF model name file and the '.lst' extension.  For
              example, if the CHF name file is called 'my.model.nam' then the list file will be called 'my.model.lst'.
            reader: urword
            optional: true
            longname: name of listing file
            type: string
          print_input:
            block: options
            description: keyword to indicate that the list of all model stress package information will
              be written to the listing file immediately after it is read.
            reader: urword
            optional: true
            longname: print input to listing file
            type: keyword
          print_flows:
            block: options
            description: keyword to indicate that the list of all model package flow rates will be printed
              to the listing file for every stress period time step in which 'BUDGET PRINT' is specified
              in Output Control.  If there is no Output Control option and 'PRINT_FLOWS' is specified, then
              flow rates are printed for the last time step of each stress period.
            reader: urword
            optional: true
            longname: print calculated flows to listing file
            type: keyword
          save_flows:
            block: options
            description: keyword to indicate that all model package flow terms will be written to the file
              specified with 'BUDGET FILEOUT' in Output Control.
            reader: urword
            optional: true
            longname: save flows for all packages to budget file
            type: keyword
          newtonoptions:
            block: options
            description: none
            reader: urword
            optional: true
            longname: newton keyword and options
            type: record
            children:
              newton:
                block: options
                description: keyword that activates the Newton-Raphson formulation for surface water flow
                  between connected reaches and stress packages that support calculation of Newton-Raphson
                  terms.
                reader: urword
                longname: keyword to activate Newton-Raphson formulation
                type: keyword
              under_relaxation:
                block: options
                description: keyword that indicates whether the surface water stage in a reach will be under-relaxed
                  when water levels fall below the bottom of the model below any given cell. By default,
                  Newton-Raphson UNDER_RELAXATION is not applied.
                reader: urword
                optional: true
                longname: keyword to activate Newton-Raphson UNDER_RELAXATION option
                type: keyword
          newton:
            block: options
            description: keyword that activates the Newton-Raphson formulation for surface water flow between
              connected reaches and stress packages that support calculation of Newton-Raphson terms.
            reader: urword
            longname: keyword to activate Newton-Raphson formulation
            type: keyword
          under_relaxation:
            block: options
            description: keyword that indicates whether the surface water stage in a reach will be under-relaxed
              when water levels fall below the bottom of the model below any given cell. By default, Newton-Raphson
              UNDER_RELAXATION is not applied.
            reader: urword
            optional: true
            longname: keyword to activate Newton-Raphson UNDER_RELAXATION option
            type: keyword
        packages:
          packages:
            block: packages
            reader: urword
            optional: false
            longname: package list
            type: list
            children:
              packages:
                block: packages
                reader: urword
                optional: false
                longname: package list
                type: record
                children:
                  ftype:
                    block: packages
                    description: is the file type, which must be one of the following character values shown
                      in table~ref{table:ftype-chf}. Ftype may be entered in any combination of uppercase
                      and lowercase.
                    reader: urword
                    longname: package type
                    type: string
                  fname:
                    block: packages
                    description: is the name of the file containing the package input.  The path to the
                      file should be included if the file is not located in the folder where the program
                      was run.
                    reader: urword
                    longname: file name
                    type: string
                  pname:
                    block: packages
                    description: is the user-defined name for the package. PNAME is restricted to 16 characters.  No
                      spaces are allowed in PNAME.  PNAME character values are read and stored by the program
                      for stress packages only.  These names may be useful for labeling purposes when multiple
                      stress packages of the same type are located within a single CHF Model.  If PNAME
                      is specified for a stress package, then PNAME will be used in the flow budget table
                      in the listing file; it will also be used for the text entry in the cell-by-cell budget
                      file.  PNAME is case insensitive and is stored in all upper case letters.
                    reader: urword
                    optional: true
                    longname: user name for package
                    type: string
          ftype:
            block: packages
            description: is the file type, which must be one of the following character values shown in
              table~ref{table:ftype-chf}. Ftype may be entered in any combination of uppercase and lowercase.
            reader: urword
            longname: package type
            type: string
          fname:
            block: packages
            description: is the name of the file containing the package input.  The path to the file should
              be included if the file is not located in the folder where the program was run.
            reader: urword
            longname: file name
            type: string
          pname:
            block: packages
            description: is the user-defined name for the package. PNAME is restricted to 16 characters.  No
              spaces are allowed in PNAME.  PNAME character values are read and stored by the program for
              stress packages only.  These names may be useful for labeling purposes when multiple stress
              packages of the same type are located within a single CHF Model.  If PNAME is specified for
              a stress package, then PNAME will be used in the flow budget table in the listing file; it
              will also be used for the text entry in the cell-by-cell budget file.  PNAME is case insensitive
              and is stored in all upper case letters.
            reader: urword
            optional: true
            longname: user name for package
            type: string
      children:
        chf-oc:
          name: chf-oc
          schema_version: '1.2'
          parent: chf-nam
          advanced: false
          multi: false
          ftype: OC
          blocks:
            options:
              budget_filerecord:
                block: options
                reader: urword
                optional: true
                mf6internal: budfilerec
                type: record
                children:
                  budget:
                    block: options
                    description: keyword to specify that record corresponds to the budget.
                    reader: urword
                    optional: false
                    longname: budget keyword
                    type: keyword
                  fileout:
                    block: options
                    description: keyword to specify that an output filename is expected next.
                    reader: urword
                    optional: false
                    longname: file keyword
                    type: keyword
                  budgetfile:
                    block: options
                    description: name of the output file to write budget information.
                    reader: urword
                    optional: false
                    longname: file keyword
                    type: string
              budget:
                block: options
                description: keyword to specify that record corresponds to the budget.
                reader: urword
                optional: false
                longname: budget keyword
                type: keyword
              fileout:
                block: options
                description: keyword to specify that an output filename is expected next.
                reader: urword
                optional: false
                longname: file keyword
                type: keyword
              budgetfile:
                block: options
                description: name of the output file to write budget information.
                reader: urword
                optional: false
                longname: file keyword
                type: string
              budgetcsv_filerecord:
                block: options
                reader: urword
                optional: true
                mf6internal: budcsvfilerec
                type: record
                children:
                  budgetcsv:
                    block: options
                    description: keyword to specify that record corresponds to the budget CSV.
                    reader: urword
                    optional: false
                    longname: budget keyword
                    type: keyword
                  fileout:
                    block: options
                    description: keyword to specify that an output filename is expected next.
                    reader: urword
                    optional: false
                    longname: file keyword
                    type: keyword
                  budgetcsvfile:
                    block: options
                    description: name of the comma-separated value (CSV) output file to write budget summary
                      information.  A budget summary record will be written to this file for each time step
                      of the simulation.
                    reader: urword
                    optional: false
                    longname: file keyword
                    type: string
              budgetcsv:
                block: options
                description: keyword to specify that record corresponds to the budget CSV.
                reader: urword
                optional: false
                longname: budget keyword
                type: keyword
              budgetcsvfile:
                block: options
                description: name of the comma-separated value (CSV) output file to write budget summary
                  information.  A budget summary record will be written to this file for each time step
                  of the simulation.
                reader: urword
                optional: false
                longname: file keyword
                type: string
              qoutflow_filerecord:
                block: options
                reader: urword
                optional: true
                mf6internal: qoutfilerec
                type: record
                children:
                  qoutflow:
                    block: options
                    description: keyword to specify that record corresponds to qoutflow.
                    reader: urword
                    optional: false
                    longname: qoutflow keyword
                    type: keyword
                  fileout:
                    block: options
                    description: keyword to specify that an output filename is expected next.
                    reader: urword
                    optional: false
                    longname: file keyword
                    type: keyword
                  qoutflowfile:
                    block: options
                    description: name of the output file to write conc information.
                    reader: urword
                    optional: false
                    longname: file keyword
                    type: string
              qoutflow:
                block: options
                description: keyword to specify that record corresponds to qoutflow.
                reader: urword
                optional: false
                longname: qoutflow keyword
                type: keyword
              qoutflowfile:
                block: options
                description: name of the output file to write conc information.
                reader: urword
                optional: false
                longname: file keyword
                type: string
              stage_filerecord:
                block: options
                reader: urword
                optional: true
                mf6internal: stagefilerec
                type: record
                children:
                  stage:
                    block: options
                    description: keyword to specify that record corresponds to stage.
                    reader: urword
                    optional: false
                    longname: stage keyword
                    type: keyword
                  fileout:
                    block: options
                    description: keyword to specify that an output filename is expected next.
                    reader: urword
                    optional: false
                    longname: file keyword
                    type: keyword
                  stagefile:
                    block: options
                    description: name of the output file to write stage information.
                    reader: urword
                    optional: false
                    longname: file keyword
                    type: string
              stage:
                block: options
                description: keyword to specify that record corresponds to stage.
                reader: urword
                optional: false
                longname: stage keyword
                type: keyword
              stagefile:
                block: options
                description: name of the output file to write stage information.
                reader: urword
                optional: false
                longname: file keyword
                type: string
              qoutflowprintrecord:
                block: options
                reader: urword
                optional: true
                mf6internal: qoutprintrec
                type: record
                children:
                  qoutflow:
                    block: options
                    description: keyword to specify that record corresponds to qoutflow.
                    reader: urword
                    optional: false
                    longname: qoutflow keyword
                    type: keyword
                  print_format:
                    block: options
                    description: keyword to specify format for printing to the listing file.
                    reader: urword
                    optional: false
                    longname: keyword to indicate that a print format follows
                    type: keyword
              print_format:
                block: options
                description: keyword to specify format for printing to the listing file.
                reader: urword
                optional: false
                longname: keyword to indicate that a print format follows
                type: keyword
              formatrecord:
                block: options
                reader: urword
                optional: false
                type: record
                children:
                  columns:
                    block: options
                    description: number of columns for writing data.
                    reader: urword
                    longname: number of columns
                    type: integer
                  width:
                    block: options
                    description: width for writing each number.
                    reader: urword
                    longname: width for each number
                    type: integer
                  digits:
                    block: options
                    description: number of digits to use for writing a number.
                    reader: urword
                    longname: number of digits
                    type: integer
                  format:
                    block: options
                    description: write format can be EXPONENTIAL, FIXED, GENERAL, or SCIENTIFIC.
                    reader: urword
                    optional: false
                    longname: write format
                    type: string
              columns:
                block: options
                description: number of columns for writing data.
                reader: urword
                longname: number of columns
                type: integer
              width:
                block: options
                description: width for writing each number.
                reader: urword
                longname: width for each number
                type: integer
              digits:
                block: options
                description: number of digits to use for writing a number.
                reader: urword
                longname: number of digits
                type: integer
              format:
                block: options
                description: write format can be EXPONENTIAL, FIXED, GENERAL, or SCIENTIFIC.
                reader: urword
