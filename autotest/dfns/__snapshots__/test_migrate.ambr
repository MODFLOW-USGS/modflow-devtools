                  "type": "keyword"
                },
                "ts_filerecord": {
                  "block": "options",
                  "reader": "urword",
                  "optional": true,
                  "type": "record",
                  "children": {
                    "ts6": {
                      "block": "options",
                      "description": "keyword to specify that record corresponds to a time-series file.",
                      "reader": "urword",
                      "optional": false,
