  [children.chf-nam.children.chf-disv1d.blocks.cell1d.cell1d]
  shape = "(nodes)"
  block = "cell1d"
  reader = "urword"
  optional = false
  longname = "cell1d data"
  type = "list"
  
  [children.chf-nam.children.chf-disv1d.blocks.cell1d.cell1d.children.cell1d]
  shape = "(nodes)"
  block = "cell1d"
  reader = "urword"
  optional = false
  longname = "cell1d data"
  type = "record"
  
  [children.chf-nam.children.chf-disv1d.blocks.cell1d.cell1d.children.cell1d.children.icell1d]
  block = "cell1d"
  description = "is the cell1d number.  Records in the cell1d block must be listed in consecutive order from the first to the last."
  reader = "urword"
  optional = false
  longname = "cell1d number"
  numeric_index = true
  type = "integer"
  
  [children.chf-nam.children.chf-disv1d.blocks.cell1d.cell1d.children.cell1d.children.fdc]
  block = "cell1d"
  description = "is the fractional distance to the cell center. FDC is relative to the first vertex in the ICVERT array. In most cases FDC should be 0.5, which would place the center of the line segment that defines the cell. If the value of FDC is 1, the cell center would located at the last vertex. FDC values of 0 and 1 can be used to place the node at either end of the cell which can be useful for cells with boundary conditions."
  reader = "urword"
  optional = false
  longname = "fractional distance to the cell center"
  type = "double"
  
  [children.chf-nam.children.chf-disv1d.blocks.cell1d.cell1d.children.cell1d.children.ncvert]
  block = "cell1d"
  description = "is the number of vertices required to define the cell.  There may be a different number of vertices for each cell."
  reader = "urword"
  optional = false
  longname = "number of cell vertices"
  type = "integer"
  
  [children.chf-nam.children.chf-disv1d.blocks.cell1d.cell1d.children.cell1d.children.icvert]
  shape = "(ncvert)"
  block = "cell1d"
  description = "is an array of integer values containing vertex numbers (in the VERTICES block) used to define the cell.  Vertices must be listed in the order that defines the line representing the cell.  Cells that are connected must share vertices. The bottom elevation of the cell is calculated using the ZV of the first and last vertex point and FDC."
  reader = "urword"
  optional = false
  longname = "number of cell vertices"
  numeric_index = true
  type = "integer"
  
  [children.chf-nam.children.chf-disv1d.blocks.cell1d.icell1d]
  block = "cell1d"
  description = "is the cell1d number.  Records in the cell1d block must be listed in consecutive order from the first to the last."
  reader = "urword"
  optional = false
  longname = "cell1d number"
  numeric_index = true
  type = "integer"
  
  [children.chf-nam.children.chf-disv1d.blocks.cell1d.fdc]
  block = "cell1d"
  description = "is the fractional distance to the cell center. FDC is relative to the first vertex in the ICVERT array. In most cases FDC should be 0.5, which would place the center of the line segment that defines the cell. If the value of FDC is 1, the cell center would located at the last vertex. FDC values of 0 and 1 can be used to place the node at either end of the cell which can be useful for cells with boundary conditions."
  reader = "urword"
  optional = false
  longname = "fractional distance to the cell center"
  type = "double"
  
  [children.chf-nam.children.chf-disv1d.blocks.cell1d.ncvert]
  block = "cell1d"
  description = "is the number of vertices required to define the cell.  There may be a different number of vertices for each cell."
  reader = "urword"
  optional = false
  longname = "number of cell vertices"
  type = "integer"
  
  [children.chf-nam.children.chf-disv1d.blocks.cell1d.icvert]
  shape = "(ncvert)"
  block = "cell1d"
  description = "is an array of integer values containing vertex numbers (in the VERTICES block) used to define the cell.  Vertices must be listed in the order that defines the line representing the cell.  Cells that are connected must share vertices. The bottom elevation of the cell is calculated using the ZV of the first and last vertex point and FDC."
  reader = "urword"
  optional = false
  longname = "number of cell vertices"
  numeric_index = true
  type = "integer"
  
  [children.chf-nam.children.chf-flw]
  name = "chf-flw"
  schema_version = "1.2"
  parent = "chf-nam"
  advanced = false
  multi = true
  ftype = "FLW"
  
  [children.chf-nam.children.chf-flw.blocks.options.auxiliary]
  shape = "(naux)"
  block = "options"
  description = "defines an array of one or more auxiliary variable names.  There is no limit on the number of auxiliary variables that can be provided on this line; however, lists of information provided in subsequent blocks must have a column of data for each auxiliary variable name defined here.   The number of auxiliary variables detected on this line determines the value for naux.  Comments cannot be provided anywhere on this line as they will be interpreted as auxiliary variable names.  Auxiliary variables may not be used by the package, but they will be available for use by other parts of the program.  The program will terminate with an error if auxiliary variables are specified on more than one line in the options block."
  reader = "urword"
  optional = true
  longname = "keyword to specify aux variables"
  type = "string"
  
  [children.chf-nam.children.chf-flw.blocks.options.auxmultname]
  block = "options"
  description = "name of auxiliary variable to be used as multiplier of flow rate."
  reader = "urword"
  optional = true
  longname = "name of auxiliary variable for multiplier"
  type = "string"
  
  [children.chf-nam.children.chf-flw.blocks.options.boundnames]
  block = "options"
  description = "keyword to indicate that boundary names may be provided with the list of inflow cells."
  reader = "urword"
  optional = true
  type = "keyword"
  
  [children.chf-nam.children.chf-flw.blocks.options.print_input]
  block = "options"
  description = "keyword to indicate that the list of inflow information will be written to the listing file immediately after it is read."
  reader = "urword"
  optional = true
  longname = "print input to listing file"
  type = "keyword"
  
  [children.chf-nam.children.chf-flw.blocks.options.print_flows]
  block = "options"
  description = "keyword to indicate that the list of inflow flow rates will be printed to the listing file for every stress period time step in which 'BUDGET PRINT' is specified in Output Control.  If there is no Output Control option and 'PRINT_FLOWS' is specified, then flow rates are printed for the last time step of each stress period."
  reader = "urword"
  optional = true
  longname = "print calculated flows to listing file"
  type = "keyword"
  
  [children.chf-nam.children.chf-flw.blocks.options.save_flows]
  block = "options"
  description = "keyword to indicate that inflow flow terms will be written to the file specified with 'BUDGET FILEOUT' in Output Control."
  reader = "urword"
  optional = true
  longname = "save well flows to budget file"
  type = "keyword"
  
  [children.chf-nam.children.chf-flw.blocks.options.ts_filerecord]
  block = "options"
  reader = "urword"
  optional = true
  type = "record"
  
  [children.chf-nam.children.chf-flw.blocks.options.ts_filerecord.children.ts6]
