  reader = "urword"
  optional = false
  longname = "file name of time series information"
  type = "string"
  
  [children.gwf-nam.children.gwf-chd.blocks.options.ts6]
  block = "options"
  description = "keyword to specify that record corresponds to a time-series file."
  reader = "urword"
  optional = false
  longname = "head keyword"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-chd.blocks.options.filein]
  block = "options"
