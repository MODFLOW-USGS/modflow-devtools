  [children.gwe-nam.children.gwe-mve.blocks.options.budget_filerecord.children.budgetfile]
  block = "options"
  description = "name of the binary output file to write budget information."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "string"
  
  [children.gwe-nam.children.gwe-mve.blocks.options.budget]
  block = "options"
