            "in_record": true,
            "tagged": true
          },
          "package_convergence": {
            "block": "options",
            "type": "keyword",
            "reader": "urword",
            "optional": false,
            "longname": "package_convergence keyword",
            "description": "keyword to specify that record corresponds to the package convergence comma spaced values file.",
            "in_record": true,
            "tagged": true
          },
          "package_convergence_filename": {
            "block": "options",
            "type": "string",
            "reader": "urword",
            "optional": false,
            "longname": "file keyword",
            "description": "name of the comma spaced values output file to write package convergence information.",
            "in_record": true,
            "tagged": false
          }
        }
      },
      "ts_filerecord": {
        "block": "options",
        "type": "record",
        "reader": "urword",
        "optional": true,
        "tagged": true,
        "fields": {
          "ts6": {
