                    reader: urword
                    optional: false
                    longname: file keyword
                    type: keyword
                  budgetfile:
                    block: options
                    description: name of the output file to write budget information.
                    reader: urword
                    optional: false
                    longname: file keyword
                    type: string
              budget:
                block: options
