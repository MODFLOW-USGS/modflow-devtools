                        reader: urword
                        optional: true
                        time_series: true
                        longname: auxiliary variables
                        type: double
                      boundname:
                        block: period
                        description: name of the inflow cell.  BOUNDNAME is an ASCII character variable
                          that can contain as many as 40 characters.  If BOUNDNAME contains spaces in it,
                          then the entire name must be enclosed within single quotes.
                        reader: urword
                        optional: true
