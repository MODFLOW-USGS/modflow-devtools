                reader: urword
                optional: false
                longname: track keyword
                type: keyword
              trackcsvfile:
                block: options
                description: name of the comma-separated value (CSV) file to write tracking information.
                reader: urword
                optional: false
                longname: file keyword
                type: string
              track_release:
                block: options
                description: keyword to indicate that particle tracking output is to be written when a particle
                  is released
                reader: urword
                optional: true
                longname: track release
                type: keyword
              track_exit:
                block: options
                description: keyword to indicate that particle tracking output is to be written when a particle
                  exits a grid feature (e.g. model, cell)
                reader: urword
                optional: true
                longname: track domain exits
                type: keyword
              track_subfeature_exit:
                block: options
                description: keyword to indicate that particle tracking output is to be written when a particle
                  exits a sub-grid-scale feature. Such features are considered implementation details of
                  the tracking algorithm employed for particular grid types, and reporting for exit events
                  from such features is disabled by default.
                reader: urword
                optional: true
                mf6internal: track_subf_exit
                longname: track cell exits
                type: keyword
              track_timestep:
                block: options
                description: keyword to indicate that particle tracking output is to be written at the end
                  of each time step
                reader: urword
                optional: true
                longname: track timestep ends
                type: keyword
              track_terminate:
                block: options
                description: keyword to indicate that particle tracking output is to be written when a particle
                  terminates for any reason
                reader: urword
                optional: true
                longname: track termination
                type: keyword
              track_weaksink:
                block: options
                description: keyword to indicate that particle tracking output is to be written when a particle
                  exits a weak sink (a cell which removes some but not all inflow from adjacent cells)
                reader: urword
                optional: true
                longname: track weaksink exits
                type: keyword
              track_usertime:
                block: options
                description: keyword to indicate that particle tracking output is to be written at user-specified
                  times, provided as double precision values in the TRACKTIMES block.
                reader: urword
                optional: true
                longname: track user-specified times
                type: keyword
              track_dropped:
                block: options
                description: keyword to indicate that particle tracking output is to be written when a particle
                  is dropped to the water table via DRY_TRACKING_METHOD DROP.
                reader: urword
                optional: true
                longname: track drops to water table
                type: keyword
              track_timesrecord:
                block: options
                reader: urword
                optional: true
                mf6internal: ttimesrec
                removed: 6.6.0
                type: record
                children:
                  track_times:
                    block: options
                    description: keyword indicating tracking times will follow
                    reader: urword
                    removed: 6.6.0
                    type: keyword
                  times:
                    shape: (any1d)
                    block: options
                    description: times to track, relative to the beginning of the simulation.
                    reader: urword
                    repeating: true
                    longname: tracking times
                    removed: 6.6.0
                    type: double
              track_times:
                block: options
                description: keyword indicating tracking times will follow
                reader: urword
                removed: 6.6.0
                type: keyword
