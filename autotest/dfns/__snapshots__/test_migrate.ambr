  shape = "(nodes)"
  block = "cell1d"
  reader = "urword"
  optional = false
  longname = "cell1d data"
  type = "list"
  
  [children.swf-nam.children.swf-disv1d.blocks.cell1d.cell1d.children.cell1d]
  shape = "(nodes)"
  block = "cell1d"
  reader = "urword"
  optional = false
  longname = "cell1d data"
  type = "record"
  
  [children.swf-nam.children.swf-disv1d.blocks.cell1d.cell1d.children.cell1d.children.icell1d]
  block = "cell1d"
  description = "is the cell1d number.  Records in the cell1d block must be listed in consecutive order from the first to the last."
  reader = "urword"
  optional = false
  longname = "cell1d number"
  numeric_index = true
  type = "integer"
  
  [children.swf-nam.children.swf-disv1d.blocks.cell1d.cell1d.children.cell1d.children.fdc]
  block = "cell1d"
  description = "is the fractional distance to the cell center. FDC is relative to the first vertex in the ICVERT array. In most cases FDC should be 0.5, which would place the center of the line segment that defines the cell. If the value of FDC is 1, the cell center would located at the last vertex. FDC values of 0 and 1 can be used to place the node at either end of the cell which can be useful for cells with boundary conditions."
  reader = "urword"
  optional = false
  longname = "fractional distance to the cell center"
  type = "double"
  
  [children.swf-nam.children.swf-disv1d.blocks.cell1d.cell1d.children.cell1d.children.ncvert]
  block = "cell1d"
  description = "is the number of vertices required to define the cell.  There may be a different number of vertices for each cell."
  reader = "urword"
  optional = false
  longname = "number of cell vertices"
  type = "integer"
  
  [children.swf-nam.children.swf-disv1d.blocks.cell1d.cell1d.children.cell1d.children.icvert]
  shape = "(ncvert)"
  block = "cell1d"
  description = "is an array of integer values containing vertex numbers (in the VERTICES block) used to define the cell.  Vertices must be listed in the order that defines the line representing the cell.  Cells that are connected must share vertices. The bottom elevation of the cell is calculated using the ZV of the first and last vertex point and FDC."
  reader = "urword"
  optional = false
  longname = "number of cell vertices"
  numeric_index = true
  type = "integer"
  
  [children.swf-nam.children.swf-disv1d.blocks.cell1d.icell1d]
  block = "cell1d"
  description = "is the cell1d number.  Records in the cell1d block must be listed in consecutive order from the first to the last."
  reader = "urword"
  optional = false
  longname = "cell1d number"
  numeric_index = true
  type = "integer"
  
  [children.swf-nam.children.swf-disv1d.blocks.cell1d.fdc]
  block = "cell1d"
  description = "is the fractional distance to the cell center. FDC is relative to the first vertex in the ICVERT array. In most cases FDC should be 0.5, which would place the center of the line segment that defines the cell. If the value of FDC is 1, the cell center would located at the last vertex. FDC values of 0 and 1 can be used to place the node at either end of the cell which can be useful for cells with boundary conditions."
  reader = "urword"
  optional = false
  longname = "fractional distance to the cell center"
  type = "double"
  
  [children.swf-nam.children.swf-disv1d.blocks.cell1d.ncvert]
  block = "cell1d"
  description = "is the number of vertices required to define the cell.  There may be a different number of vertices for each cell."
  reader = "urword"
  optional = false
  longname = "number of cell vertices"
  type = "integer"
  
  [children.swf-nam.children.swf-disv1d.blocks.cell1d.icvert]
  shape = "(ncvert)"
  block = "cell1d"
  description = "is an array of integer values containing vertex numbers (in the VERTICES block) used to define the cell.  Vertices must be listed in the order that defines the line representing the cell.  Cells that are connected must share vertices. The bottom elevation of the cell is calculated using the ZV of the first and last vertex point and FDC."
  reader = "urword"
  optional = false
  longname = "number of cell vertices"
  numeric_index = true
  type = "integer"
  
