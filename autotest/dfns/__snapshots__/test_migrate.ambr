  type = "keyword"
  
  [children.gwe-nam.children.gwe-uze.blocks.options.budgetcsv_filerecord.children.budgetcsvfile]
  block = "options"
  description = "name of the comma-separated value (CSV) output file to write budget summary information.  A budget summary record will be written to this file for each time step of the simulation."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "string"
  
  [children.gwe-nam.children.gwe-uze.blocks.options.budgetcsv]
  block = "options"
