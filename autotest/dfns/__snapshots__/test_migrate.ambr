                        reader: urword
                        time_series: true
                        longname: flow rate
                        type: double
                      aux:
                        shape: (naux)
                        block: period
                        description: represents the values of the auxiliary variables for each inflow. The
                          values of auxiliary variables must be present for each inflow. The values must
                          be specified in the order of the auxiliary variables specified in the OPTIONS
                          block.  If the package supports time series and the Options block includes a TIMESERIESFILE
