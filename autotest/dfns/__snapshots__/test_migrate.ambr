  [children.chf-nam.children.chf-oc.blocks.period.ocsetting.children.steps]
  shape = "(<nstp)"
  block = "period"
  description = "save for each step specified in STEPS. This keyword may be used in conjunction with other keywords to print or save results for multiple time steps."
  reader = "urword"
  type = "integer"
  
  [children.chf-nam.children.chf-oc.blocks.period.all]
  shape = "(nper)"
  block = "period"
  description = "keyword to indicate save for all time steps in period."
  reader = "urword"
  type = "keyword"
  
  [children.chf-nam.children.chf-oc.blocks.period.first]
  shape = "(nper)"
  block = "period"
  description = "keyword to indicate save for first step in period. This keyword may be used in conjunction with other keywords to print or save results for multiple time steps."
  reader = "urword"
  type = "keyword"
  
  [children.chf-nam.children.chf-oc.blocks.period.last]
  shape = "(nper)"
  block = "period"
  description = "keyword to indicate save for last step in period. This keyword may be used in conjunction with other keywords to print or save results for multiple time steps."
  reader = "urword"
  type = "keyword"
  
  [children.chf-nam.children.chf-oc.blocks.period.frequency]
  shape = "(nper)"
  block = "period"
  description = "save at the specified time step frequency. This keyword may be used in conjunction with other keywords to print or save results for multiple time steps."
  reader = "urword"
  type = "integer"
  
  [children.chf-nam.children.chf-oc.blocks.period.steps]
  shape = "(nper, <nstp)"
  block = "period"
  description = "save for each step specified in STEPS. This keyword may be used in conjunction with other keywords to print or save results for multiple time steps."
  reader = "urword"
  type = "integer"
  
  [children.chf-nam.children.chf-sto]
  name = "chf-sto"
  schema_version = "1.2"
  parent = "chf-nam"
  advanced = false
  multi = false
  ftype = "STO"
  
  [children.chf-nam.children.chf-sto.blocks.options.save_flows]
  block = "options"
  description = "keyword to indicate that cell-by-cell flow terms will be written to the file specified with 'BUDGET SAVE FILE' in Output Control."
  reader = "urword"
  optional = true
  longname = "keyword to save NPF flows"
  mf6internal = "ipakcb"
  type = "keyword"
  
  [children.chf-nam.children.chf-sto.blocks.options.export_array_ascii]
  block = "options"
  description = "keyword that specifies input grid arrays, which already support the layered keyword, should be written to layered ascii output files."
  reader = "urword"
  optional = true
  mf6internal = "export_ascii"
  longname = "export array variables to layered ascii files."
  type = "keyword"
  
  [children.chf-nam.children.chf-sto.blocks.period.iper]
  shape = "(nper)"
  block = "period"
  description = "integer value specifying the starting stress period number for which the data specified in the PERIOD block apply.  IPER must be less than or equal to NPER in the TDIS Package and greater than zero.  The IPER value assigned to a stress period block must be greater than the IPER value assigned for the previous PERIOD block.  The information specified in the PERIOD block will continue to apply for all subsequent stress periods, unless the program encounters another PERIOD block."
  block_variable = true
  reader = "urword"
  optional = false
  longname = "stress period number"
  type = "integer"
  
  [children.chf-nam.children.chf-sto.blocks.period.steady-state]
  shape = "(nper)"
  block = "period"
  description = "keyword to indicate that stress period IPER is steady-state. Steady-state conditions will apply until the TRANSIENT keyword is specified in a subsequent BEGIN PERIOD block."
  reader = "urword"
  optional = true
  longname = "steady state indicator"
  mf6internal = "steady_state"
  type = "keyword"
  
  [children.chf-nam.children.chf-sto.blocks.period.transient]
  shape = "(nper)"
  block = "period"
  description = "keyword to indicate that stress period IPER is transient. Transient conditions will apply until the STEADY-STATE keyword is specified in a subsequent BEGIN PERIOD block."
  reader = "urword"
  optional = true
  longname = "transient indicator"
  type = "keyword"
  
  [children.chf-nam.children.chf-disv1d]
  name = "chf-disv1d"
  schema_version = "1.2"
  parent = "chf-nam"
  advanced = false
  multi = false
  ftype = "DISV1D"
  
  [children.chf-nam.children.chf-disv1d.blocks.options.length_units]
  block = "options"
  description = "is the length units used for this model.  Values can be 'FEET', 'METERS', or 'CENTIMETERS'.  If not specified, the default is 'UNKNOWN'."
  reader = "urword"
  optional = true
  longname = "model length units"
  type = "string"
  
  [children.chf-nam.children.chf-disv1d.blocks.options.nogrb]
  block = "options"
  description = "keyword to deactivate writing of the binary grid file."
  reader = "urword"
  optional = true
  longname = "do not write binary grid file"
  type = "keyword"
  
  [children.chf-nam.children.chf-disv1d.blocks.options.grb_filerecord]
  block = "options"
  reader = "urword"
  optional = true
  type = "record"
  
  [children.chf-nam.children.chf-disv1d.blocks.options.grb_filerecord.children.grb6]
  block = "options"
  description = "keyword to specify that record corresponds to a binary grid file."
  reader = "urword"
  optional = false
  longname = "grb keyword"
  type = "keyword"
  
  [children.chf-nam.children.chf-disv1d.blocks.options.grb_filerecord.children.fileout]
  block = "options"
  description = "keyword to specify that an output filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.chf-nam.children.chf-disv1d.blocks.options.grb_filerecord.children.grb6_filename]
  block = "options"
  description = "defines a binary grid output file. If this option is not provided, the output file will have the same name as the discretization input file, plus extension '.grb'."
  reader = "urword"
  optional = false
  longname = "file name of GRB information"
  type = "string"
  
  [children.chf-nam.children.chf-disv1d.blocks.options.grb6]
  block = "options"
  description = "keyword to specify that record corresponds to a binary grid file."
  reader = "urword"
  optional = false
  longname = "grb keyword"
  type = "keyword"
  
  [children.chf-nam.children.chf-disv1d.blocks.options.fileout]
  block = "options"
  description = "keyword to specify that an output filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.chf-nam.children.chf-disv1d.blocks.options.grb6_filename]
  block = "options"
  description = "defines a binary grid output file. If this option is not provided, the output file will have the same name as the discretization input file, plus extension '.grb'."
  reader = "urword"
  optional = false
  longname = "file name of GRB information"
  type = "string"
  
  [children.chf-nam.children.chf-disv1d.blocks.options.xorigin]
  block = "options"
  description = "x-position of the origin used for model grid vertices.  This value should be provided in a real-world coordinate system.  A default value of zero is assigned if not specified.  The value for XORIGIN does not affect the model simulation, but it is written to the binary grid file so that postprocessors can locate the grid in space."
  reader = "urword"
  optional = true
  longname = "x-position origin of the model grid coordinate system"
  type = "double"
  
  [children.chf-nam.children.chf-disv1d.blocks.options.yorigin]
  block = "options"
  description = "y-position of the origin used for model grid vertices.  This value should be provided in a real-world coordinate system.  If not specified, then a default value equal to zero is used.  The value for YORIGIN does not affect the model simulation, but it is written to the binary grid file so that postprocessors can locate the grid in space."
  reader = "urword"
  optional = true
  longname = "y-position origin of the model grid coordinate system"
  type = "double"
  
  [children.chf-nam.children.chf-disv1d.blocks.options.angrot]
  block = "options"
  description = "counter-clockwise rotation angle (in degrees) of the model grid coordinate system relative to a real-world coordinate system.  If not specified, then a default value of 0.0 is assigned.  The value for ANGROT does not affect the model simulation, but it is written to the binary grid file so that postprocessors can locate the grid in space."
  reader = "urword"
  optional = true
  longname = "rotation angle"
  type = "double"
  
  [children.chf-nam.children.chf-disv1d.blocks.options.export_array_ascii]
  block = "options"
  description = "keyword that specifies input griddata arrays should be written to layered ascii output files."
  reader = "urword"
  optional = true
  mf6internal = "export_ascii"
  longname = "export array variables to layered ascii files."
  type = "keyword"
  
  [children.chf-nam.children.chf-disv1d.blocks.options.crs]
  shape = "lenbigline"
  block = "options"
  description = "is a real-world coordinate reference system (CRS) for the model, for example, an EPSG integer code (e.g. 26915), authority string (i.e. epsg:26915), or Open Geospatial Consortium Well-Known Text (WKT) specification. Limited to 5000 characters. The entry for CRS does not affect the model simulation, but it is written to the binary grid file so that postprocessors can locate the grid in space."
  reader = "urword"
  optional = true
  developmode = true
  longname = "CRS user input string"
  type = "string"
  
  [children.chf-nam.children.chf-disv1d.blocks.dimensions.nodes]
  block = "dimensions"
  description = "is the number of linear cells."
  reader = "urword"
  optional = false
  longname = "number of linear features"
  type = "integer"
  
  [children.chf-nam.children.chf-disv1d.blocks.dimensions.nvert]
  block = "dimensions"
  description = "is the total number of (x, y, z) vertex pairs used to characterize the model grid."
  reader = "urword"
  optional = true
  longname = "number of columns"
  type = "integer"
  
  [children.chf-nam.children.chf-disv1d.blocks.griddata.width]
  shape = "(nodes)"
  block = "griddata"
  description = "real value that defines the width for each one-dimensional cell. WIDTH must be greater than zero.  If the Cross Section (CXS) Package is used, then the WIDTH value will be multiplied by the specified cross section x-fraction values."
  reader = "readarray"
  layered = false
  longname = "width"
  type = "double"
  
  [children.chf-nam.children.chf-disv1d.blocks.griddata.bottom]
  shape = "(nodes)"
  block = "griddata"
  description = "bottom elevation for the one-dimensional cell."
  reader = "readarray"
  layered = false
  longname = "bottom elevation for the one-dimensional cell"
  type = "double"
  
  [children.chf-nam.children.chf-disv1d.blocks.griddata.idomain]
  shape = "(nodes)"
  block = "griddata"
  description = "is an optional array that characterizes the existence status of a cell.  If the IDOMAIN array is not specified, then all model cells exist within the solution.  If the IDOMAIN value for a cell is 0, the cell does not exist in the simulation.  Input and output values will be read and written for the cell, but internal to the program, the cell is excluded from the solution.  If the IDOMAIN value for a cell is 1, the cell exists in the simulation."
  reader = "readarray"
  layered = false
  optional = true
  longname = "idomain existence array"
  type = "integer"
  
  [children.chf-nam.children.chf-disv1d.blocks.vertices.vertices]
  shape = "(nvert)"
  block = "vertices"
  reader = "urword"
  optional = false
  longname = "vertices data"
  type = "list"
  
  [children.chf-nam.children.chf-disv1d.blocks.vertices.vertices.children.vertices]
  shape = "(nvert)"
  block = "vertices"
