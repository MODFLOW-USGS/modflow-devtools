                "sorbate_filerecord": {
                  "block": "options",
                  "reader": "urword",
                  "optional": true,
                  "mf6internal": "sorbatefilerec",
                  "type": "record",
                  "children": {
                    "sorbate": {
                      "block": "options",
                      "description": "keyword to specify that record corresponds to immobile sorbate concentration.",
                      "reader": "urword",
