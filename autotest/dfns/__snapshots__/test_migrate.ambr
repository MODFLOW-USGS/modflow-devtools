              "type": "keyword"
            },
            "sfacval": {
              "shape": "(<time_series_name)",
              "block": "attributes",
              "description": "Scale factor, which will multiply all array values in time series. SFAC is an optional attribute; if omitted, SFAC = 1.0.",
              "reader": "urword",
              "optional": false,
              "type": "double"
            },
            "sfacrecord_single": {
              "block": "attributes",
              "description": "xxx",
              "reader": "urword",
              "optional": true,
              "type": "record",
              "children": {
                "sfacval": {
                  "shape": "(<time_series_name)",
                  "block": "attributes",
                  "description": "Scale factor, which will multiply all array values in time series. SFAC is an optional attribute; if omitted, SFAC = 1.0.",
                  "reader": "urword",
                  "optional": false,
