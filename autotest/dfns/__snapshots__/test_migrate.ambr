            "description": "name of input file to define observations for the FLW package. See the 'Observation utility' section for instructions for preparing observation input files. Table {#2} lists observation type(s) supported by the FLW package.",
            "preserve_case": true,
            "in_record": true,
            "tagged": false
          }
        },
        "ref": {
          "parent": "parent_model_or_package",
