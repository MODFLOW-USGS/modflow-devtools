  '''
  {
    "name": "gwf-uzf",
    "advanced": true,
    "multi": true,
    "schema_version": "1.1",
    "fkeys": {
      "ts_filerecord": {
        "parent": "parent_package",
        "key": "ts_filerecord",
        "val": "timeseries",
        "abbr": "ts",
        "param": "timeseries",
