  [children.prt-nam.children.prt-dis]
  name = "prt-dis"
  schema_version = "1.2"
  parent = "prt-nam"
  advanced = false
  multi = false
  ftype = "DIS"
  
  [children.prt-nam.children.prt-dis.blocks.options.length_units]
  block = "options"
  description = "is the length units used for this model.  Values can be 'FEET', 'METERS', or 'CENTIMETERS'.  If not specified, the default is 'UNKNOWN'."
  reader = "urword"
  optional = true
  longname = "model length units"
  type = "string"
  
  [children.prt-nam.children.prt-dis.blocks.options.nogrb]
