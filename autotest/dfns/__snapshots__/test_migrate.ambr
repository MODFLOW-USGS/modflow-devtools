  type = "keyword"
  
  [children.gwf-nam.children.gwf-lak.blocks.period.perioddata.children.perioddata.children.laksetting.children.auxiliaryrecord.children.auxname]
  block = "period"
  description = "name for the auxiliary variable to be assigned AUXVAL.  AUXNAME must match one of the auxiliary variable names defined in the OPTIONS block. If AUXNAME does not match one of the auxiliary variable names defined in the OPTIONS block the data are ignored."
  reader = "urword"
  type = "string"
  
  [children.gwf-nam.children.gwf-lak.blocks.period.perioddata.children.perioddata.children.laksetting.children.auxiliaryrecord.children.auxval]
