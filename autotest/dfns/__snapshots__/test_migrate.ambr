  block = "options"
  description = "keyword to specify that record corresponds to immobile concentration."
  reader = "urword"
  optional = false
  longname = "cim keyword"
  mf6internal = "cimopt"
  type = "keyword"
  
  [children.gwt-nam.children.gwt-ist.blocks.options.cim_filerecord.children.fileout]
  block = "options"
  description = "keyword to specify that an output filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.gwt-nam.children.gwt-ist.blocks.options.cim_filerecord.children.cimfile]
  block = "options"
  description = "name of the output file to write immobile concentrations.  This file is a binary file that has the same format and structure as a binary head and concentration file.  The value for the text variable written to the file is CIM.  Immobile domain concentrations will be written to this file at the same interval as mobile domain concentrations are saved, as specified in the GWT Model Output Control file."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "string"
  
  [children.gwt-nam.children.gwt-ist.blocks.options.cim]
  block = "options"
  description = "keyword to specify that record corresponds to immobile concentration."
  reader = "urword"
  optional = false
  longname = "cim keyword"
  mf6internal = "cimopt"
  type = "keyword"
  
  [children.gwt-nam.children.gwt-ist.blocks.options.cimfile]
  block = "options"
  description = "name of the output file to write immobile concentrations.  This file is a binary file that has the same format and structure as a binary head and concentration file.  The value for the text variable written to the file is CIM.  Immobile domain concentrations will be written to this file at the same interval as mobile domain concentrations are saved, as specified in the GWT Model Output Control file."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "string"
  
