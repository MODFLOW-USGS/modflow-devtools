                  "reader": "urword",
                  "optional": true,
                  "longname": "number of particle tracking times",
                  "type": "integer"
                }
              },
              "tracktimes": {
                "tracktimes": {
                  "shape": "(ntracktimes)",
                  "block": "tracktimes",
                  "reader": "urword",
                  "optional": true,
                  "type": "list",
                  "children": {
                    "tracktimes": {
                      "shape": "(ntracktimes)",
                      "block": "tracktimes",
