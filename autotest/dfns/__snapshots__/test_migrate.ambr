  [children.gwf-nam.children.gwf-sfr.blocks.options.package_convergence]
  block = "options"
  description = "keyword to specify that record corresponds to the package convergence comma spaced values file."
  reader = "urword"
  optional = false
  longname = "package_convergence keyword"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-sfr.blocks.options.package_convergence_filename]
  block = "options"
  description = "name of the comma spaced values output file to write package convergence information."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "string"
  
  [children.gwf-nam.children.gwf-sfr.blocks.options.ts_filerecord]
  block = "options"
  reader = "urword"
  optional = true
  type = "record"
  
  [children.gwf-nam.children.gwf-sfr.blocks.options.ts_filerecord.children.ts6]
  block = "options"
  description = "keyword to specify that record corresponds to a time-series file."
  reader = "urword"
  optional = false
  longname = "head keyword"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-sfr.blocks.options.ts_filerecord.children.filein]
  block = "options"
  description = "keyword to specify that an input filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-sfr.blocks.options.ts_filerecord.children.ts6_filename]
  block = "options"
  description = "defines a time-series file defining time series that can be used to assign time-varying values. See the 'Time-Variable Input' section for instructions on using the time-series capability."
  reader = "urword"
  optional = false
  longname = "file name of time series information"
  type = "string"
  
  [children.gwf-nam.children.gwf-sfr.blocks.options.ts6]
  block = "options"
  description = "keyword to specify that record corresponds to a time-series file."
  reader = "urword"
  optional = false
  longname = "head keyword"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-sfr.blocks.options.filein]
  block = "options"
  description = "keyword to specify that an input filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-sfr.blocks.options.ts6_filename]
  block = "options"
  description = "defines a time-series file defining time series that can be used to assign time-varying values. See the 'Time-Variable Input' section for instructions on using the time-series capability."
  reader = "urword"
  optional = false
  longname = "file name of time series information"
  type = "string"
  
  [children.gwf-nam.children.gwf-sfr.blocks.options.obs_filerecord]
  block = "options"
  reader = "urword"
  optional = true
  type = "record"
  
  [children.gwf-nam.children.gwf-sfr.blocks.options.obs_filerecord.children.obs6]
  block = "options"
  description = "keyword to specify that record corresponds to an observations file."
  reader = "urword"
  optional = false
  longname = "obs keyword"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-sfr.blocks.options.obs_filerecord.children.filein]
  block = "options"
  description = "keyword to specify that an input filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-sfr.blocks.options.obs_filerecord.children.obs6_filename]
  block = "options"
  description = "name of input file to define observations for the SFR package. See the 'Observation utility' section for instructions for preparing observation input files. Table {#2} lists observation type(s) supported by the SFR package."
  reader = "urword"
  optional = false
  longname = "obs6 input filename"
  type = "string"
  
  [children.gwf-nam.children.gwf-sfr.blocks.options.obs6]
  block = "options"
  description = "keyword to specify that record corresponds to an observations file."
  reader = "urword"
  optional = false
  longname = "obs keyword"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-sfr.blocks.options.obs6_filename]
  block = "options"
  description = "name of input file to define observations for the SFR package. See the 'Observation utility' section for instructions for preparing observation input files. Table {#2} lists observation type(s) supported by the SFR package."
  reader = "urword"
  optional = false
  longname = "obs6 input filename"
  type = "string"
  
  [children.gwf-nam.children.gwf-sfr.blocks.options.mover]
  block = "options"
  description = "keyword to indicate that this instance of the SFR Package can be used with the Water Mover (MVR) Package.  When the MOVER option is specified, additional memory is allocated within the package to store the available, provided, and received water."
  reader = "urword"
  optional = true
  type = "keyword"
  
  [children.gwf-nam.children.gwf-sfr.blocks.options.maximum_picard_iterations]
  block = "options"
  description = "integer value that defines the maximum number of Streamflow Routing picard iterations allowed when solving for reach stages and flows as part of the GWF formulate step. Picard iterations are used to minimize differences in SFR package results between subsequent GWF picard (non-linear) iterations as a result of non-optimal reach numbering. If reaches are numbered in order, from upstream to downstream, MAXIMUM_PICARD_ITERATIONS can be set to 1 to reduce model run time. By default, MAXIMUM_PICARD_ITERATIONS is equal to 100."
  reader = "urword"
  optional = true
  longname = "SFR picard iterations"
  type = "integer"
  
  [children.gwf-nam.children.gwf-sfr.blocks.options.maximum_iterations]
  block = "options"
  description = "integer value that defines the maximum number of Streamflow Routing Newton-Raphson iterations allowed for a reach. By default, MAXIMUM_ITERATIONS is equal to 100. MAXIMUM_ITERATIONS would only need to be increased from the default value if one or more reach in a simulation has a large water budget error."
  reader = "urword"
  optional = true
  longname = "SFR Newton-Raphson iterations"
  type = "integer"
  
  [children.gwf-nam.children.gwf-sfr.blocks.options.maximum_depth_change]
  block = "options"
  description = "real value that defines the depth closure tolerance. By default, MAXIMUM_DEPTH_CHANGE is equal to $1 times 10^{-5}$. The MAXIMUM_STAGE_CHANGE would only need to be increased or decreased from the default value if the water budget error for one or more reach is too small or too large, respectively."
  reader = "urword"
  optional = true
  longname = "depth closure tolerance"
  type = "double"
  
  [children.gwf-nam.children.gwf-sfr.blocks.options.unit_conversion]
  block = "options"
  description = "real value that is used to convert user-specified Manning's roughness coefficients from seconds per meters$^{1/3}$ to model length and time units. A constant of 1.486 is used for flow units of cubic feet per second, and a constant of 1.0 is used for units of cubic meters per second. The constant must be multiplied by 86,400 when using time units of days in the simulation."
  reader = "urword"
  optional = true
  deprecated = "6.4.2"
  longname = "conversion factor"
  type = "double"
  
  [children.gwf-nam.children.gwf-sfr.blocks.options.length_conversion]
  block = "options"
  description = "real value that is used to convert user-specified Manning's roughness coefficients from meters to model length units. LENGTH_CONVERSION should be set to 3.28081, 1.0, and 100.0 when using length units (LENGTH_UNITS) of feet, meters, or centimeters in the simulation, respectively. LENGTH_CONVERSION does not need to be specified if LENGTH_UNITS are meters."
  reader = "urword"
  optional = true
  longname = "length conversion factor"
  type = "double"
  
  [children.gwf-nam.children.gwf-sfr.blocks.options.time_conversion]
  block = "options"
  description = "real value that is used to convert user-specified Manning's roughness coefficients from seconds to model time units. TIME_CONVERSION should be set to 1.0, 60.0, 3,600.0, 86,400.0, and 31,557,600.0 when using time units (TIME_UNITS) of seconds, minutes, hours, days, or years in the simulation, respectively. TIME_CONVERSION does not need to be specified if TIME_UNITS are seconds."
  reader = "urword"
  optional = true
  longname = "time conversion factor"
  type = "double"
  
  [children.gwf-nam.children.gwf-sfr.blocks.options.dev_storage_weight]
  block = "options"
  description = "real number value that defines the time weighting factor used to calculate the change in channel storage. STORAGE_WEIGHT must have a value between 0.5 and 1. Default STORAGE_WEIGHT value is 1."
  reader = "urword"
  optional = true
  longname = "reach storage time weighting"
  type = "double"
  
  [children.gwf-nam.children.gwf-sfr.blocks.dimensions.nreaches]
  block = "dimensions"
  description = "integer value specifying the number of stream reaches.  There must be NREACHES entries in the PACKAGEDATA block."
  reader = "urword"
  optional = false
  longname = "maximum number reaches"
  type = "integer"
  
  [children.gwf-nam.children.gwf-sfr.blocks.packagedata.packagedata]
  shape = "(maxbound)"
  block = "packagedata"
  reader = "urword"
  type = "list"
  
  [children.gwf-nam.children.gwf-sfr.blocks.packagedata.packagedata.children.packagedata]
  shape = "(maxbound)"
  block = "packagedata"
  reader = "urword"
  type = "record"
  
  [children.gwf-nam.children.gwf-sfr.blocks.packagedata.packagedata.children.packagedata.children.ifno]
  block = "packagedata"
  description = "integer value that defines the feature (reach) number associated with the specified PACKAGEDATA data on the line. IFNO must be greater than zero and less than or equal to NREACHES. Reach information must be specified for every reach or the program will terminate with an error.  The program will also terminate with an error if information for a reach is specified more than once."
  reader = "urword"
  longname = "reach number for this entry"
  numeric_index = true
  type = "integer"
  
  [children.gwf-nam.children.gwf-sfr.blocks.packagedata.packagedata.children.packagedata.children.cellid]
  shape = "(ncelldim)"
  block = "packagedata"
  description = "is the cell identifier, and depends on the type of grid that is used for the simulation. For a structured grid that uses the DIS input file, CELLID is the layer, row, and column. For a grid that uses the DISV input file, CELLID is the layer and CELL2D number. If the model uses the unstructured discretization (DISU) input file, CELLID is the node number for the cell. For reaches that are not connected to an underlying GWF cell, a zero should be specified for each grid dimension. For example, for a DIS grid a CELLID of 0 0 0 should be specified. Reach-aquifer flow is not calculated for unconnected reaches. The keyword NONE can be still be specified to identify unconnected reaches for backward compatibility with previous versions of MODFLOW 6 but eventually NONE will be deprecated and will cause MODFLOW 6 to terminate with an error."
  reader = "urword"
  longname = "cell identifier"
  type = "integer"
  
  [children.gwf-nam.children.gwf-sfr.blocks.packagedata.packagedata.children.packagedata.children.rlen]
  block = "packagedata"
  description = "real value that defines the reach length. RLEN must be greater than zero."
  reader = "urword"
  longname = "reach length"
  type = "double"
  
  [children.gwf-nam.children.gwf-sfr.blocks.packagedata.packagedata.children.packagedata.children.rwid]
  block = "packagedata"
  description = "real value that defines the reach width. RWID must be greater than zero."
  reader = "urword"
  longname = "reach width"
  type = "double"
  
  [children.gwf-nam.children.gwf-sfr.blocks.packagedata.packagedata.children.packagedata.children.rgrd]
  block = "packagedata"
  description = "real value that defines the stream gradient (slope) across the reach. RGRD must be greater than zero."
  reader = "urword"
  longname = "stream gradient"
  type = "double"
  
  [children.gwf-nam.children.gwf-sfr.blocks.packagedata.packagedata.children.packagedata.children.rtp]
  block = "packagedata"
  description = "real value that defines the top elevation of the streambed of a reach."
  reader = "urword"
  longname = "reach streambed top elevation"
  type = "double"
  
  [children.gwf-nam.children.gwf-sfr.blocks.packagedata.packagedata.children.packagedata.children.rbth]
  block = "packagedata"
  description = "real value that defines the thickness of the reach streambed. RBTH can be any value if the reach is not connected to an underlying GWF cell. Otherwise, RBTH must be greater than zero."
  reader = "urword"
  longname = "streambed thickness"
  type = "double"
  
  [children.gwf-nam.children.gwf-sfr.blocks.packagedata.packagedata.children.packagedata.children.rhk]
  block = "packagedata"
  description = "real or character value that defines the hydraulic conductivity of the reach streambed. RHK can be any positive value if the reach is not connected to an underlying GWF cell. Otherwise, RHK must be greater than zero. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "reach bed hydraulic conductivity"
  type = "double"
  
  [children.gwf-nam.children.gwf-sfr.blocks.packagedata.packagedata.children.packagedata.children.man]
  block = "packagedata"
  description = "real or character value that defines the Manning's roughness coefficient for the reach. MAN must be greater than zero.  If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "Manning's roughness coefficient"
  type = "string"
  
  [children.gwf-nam.children.gwf-sfr.blocks.packagedata.packagedata.children.packagedata.children.ncon]
  block = "packagedata"
  description = "integer value that defines the number of reaches connected to the reach.  If a value of zero is specified for NCON an entry for IFNO is still required in the subsequent CONNECTIONDATA block."
  reader = "urword"
  longname = "number of connected reaches"
  type = "integer"
  
  [children.gwf-nam.children.gwf-sfr.blocks.packagedata.packagedata.children.packagedata.children.ustrf]
  block = "packagedata"
  description = "real value that defines the fraction of upstream flow from each upstream reach that is applied as upstream inflow to the reach. The sum of all USTRF values for all reaches connected to the same upstream reach must be equal to one and USTRF must be greater than or equal to zero. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "fraction of upstream flow"
  type = "double"
  
  [children.gwf-nam.children.gwf-sfr.blocks.packagedata.packagedata.children.packagedata.children.ndv]
  block = "packagedata"
  description = "integer value that defines the number of downstream diversions for the reach."
  reader = "urword"
  longname = "number of downstream reaches"
  type = "integer"
  
  [children.gwf-nam.children.gwf-sfr.blocks.packagedata.packagedata.children.packagedata.children.aux]
  shape = "(naux)"
  block = "packagedata"
  description = "represents the values of the auxiliary variables for each stream reach. The values of auxiliary variables must be present for each stream reach. The values must be specified in the order of the auxiliary variables specified in the OPTIONS block.  If the package supports time series and the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  optional = true
  longname = "auxiliary variables"
  type = "double"
  
  [children.gwf-nam.children.gwf-sfr.blocks.packagedata.packagedata.children.packagedata.children.boundname]
  block = "packagedata"
  description = "name of the stream reach cell.  BOUNDNAME is an ASCII character variable that can contain as many as 40 characters.  If BOUNDNAME contains spaces in it, then the entire name must be enclosed within single quotes."
  reader = "urword"
  optional = true
  longname = "well name"
  type = "string"
  
  [children.gwf-nam.children.gwf-sfr.blocks.packagedata.ifno]
  block = "packagedata"
  description = "integer value that defines the feature (reach) number associated with the specified PACKAGEDATA data on the line. IFNO must be greater than zero and less than or equal to NREACHES. Reach information must be specified for every reach or the program will terminate with an error.  The program will also terminate with an error if information for a reach is specified more than once."
  reader = "urword"
  longname = "reach number for this entry"
  numeric_index = true
  type = "integer"
  
  [children.gwf-nam.children.gwf-sfr.blocks.packagedata.cellid]
  shape = "(ncelldim)"
  block = "packagedata"
  description = "is the cell identifier, and depends on the type of grid that is used for the simulation. For a structured grid that uses the DIS input file, CELLID is the layer, row, and column. For a grid that uses the DISV input file, CELLID is the layer and CELL2D number. If the model uses the unstructured discretization (DISU) input file, CELLID is the node number for the cell. For reaches that are not connected to an underlying GWF cell, a zero should be specified for each grid dimension. For example, for a DIS grid a CELLID of 0 0 0 should be specified. Reach-aquifer flow is not calculated for unconnected reaches. The keyword NONE can be still be specified to identify unconnected reaches for backward compatibility with previous versions of MODFLOW 6 but eventually NONE will be deprecated and will cause MODFLOW 6 to terminate with an error."
  reader = "urword"
  longname = "cell identifier"
  type = "integer"
  
  [children.gwf-nam.children.gwf-sfr.blocks.packagedata.rlen]
  block = "packagedata"
  description = "real value that defines the reach length. RLEN must be greater than zero."
  reader = "urword"
  longname = "reach length"
  type = "double"
  
  [children.gwf-nam.children.gwf-sfr.blocks.packagedata.rwid]
  block = "packagedata"
  description = "real value that defines the reach width. RWID must be greater than zero."
  reader = "urword"
  longname = "reach width"
  type = "double"
  
  [children.gwf-nam.children.gwf-sfr.blocks.packagedata.rgrd]
  block = "packagedata"
  description = "real value that defines the stream gradient (slope) across the reach. RGRD must be greater than zero."
  reader = "urword"
  longname = "stream gradient"
  type = "double"
  
  [children.gwf-nam.children.gwf-sfr.blocks.packagedata.rtp]
  block = "packagedata"
  description = "real value that defines the top elevation of the streambed of a reach."
  reader = "urword"
  longname = "reach streambed top elevation"
  type = "double"
  
  [children.gwf-nam.children.gwf-sfr.blocks.packagedata.rbth]
  block = "packagedata"
  description = "real value that defines the thickness of the reach streambed. RBTH can be any value if the reach is not connected to an underlying GWF cell. Otherwise, RBTH must be greater than zero."
  reader = "urword"
  longname = "streambed thickness"
  type = "double"
  
  [children.gwf-nam.children.gwf-sfr.blocks.packagedata.rhk]
  block = "packagedata"
  description = "real or character value that defines the hydraulic conductivity of the reach streambed. RHK can be any positive value if the reach is not connected to an underlying GWF cell. Otherwise, RHK must be greater than zero. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "reach bed hydraulic conductivity"
  type = "double"
  
  [children.gwf-nam.children.gwf-sfr.blocks.packagedata.man]
  block = "packagedata"
  description = "real or character value that defines the Manning's roughness coefficient for the reach. MAN must be greater than zero.  If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "Manning's roughness coefficient"
  type = "string"
  
  [children.gwf-nam.children.gwf-sfr.blocks.packagedata.ncon]
  block = "packagedata"
  description = "integer value that defines the number of reaches connected to the reach.  If a value of zero is specified for NCON an entry for IFNO is still required in the subsequent CONNECTIONDATA block."
  reader = "urword"
  longname = "number of connected reaches"
  type = "integer"
  
  [children.gwf-nam.children.gwf-sfr.blocks.packagedata.ustrf]
  block = "packagedata"
  description = "real value that defines the fraction of upstream flow from each upstream reach that is applied as upstream inflow to the reach. The sum of all USTRF values for all reaches connected to the same upstream reach must be equal to one and USTRF must be greater than or equal to zero. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "fraction of upstream flow"
  type = "double"
  
  [children.gwf-nam.children.gwf-sfr.blocks.packagedata.ndv]
  block = "packagedata"
  description = "integer value that defines the number of downstream diversions for the reach."
  reader = "urword"
  longname = "number of downstream reaches"
  type = "integer"
  
  [children.gwf-nam.children.gwf-sfr.blocks.packagedata.aux]
  shape = "(naux)"
  block = "packagedata"
  description = "represents the values of the auxiliary variables for each stream reach. The values of auxiliary variables must be present for each stream reach. The values must be specified in the order of the auxiliary variables specified in the OPTIONS block.  If the package supports time series and the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  optional = true
  longname = "auxiliary variables"
  type = "double"
  
  [children.gwf-nam.children.gwf-sfr.blocks.packagedata.boundname]
  block = "packagedata"
  description = "name of the stream reach cell.  BOUNDNAME is an ASCII character variable that can contain as many as 40 characters.  If BOUNDNAME contains spaces in it, then the entire name must be enclosed within single quotes."
  reader = "urword"
  optional = true
  longname = "well name"
  type = "string"
  
  [children.gwf-nam.children.gwf-sfr.blocks.crosssections.crosssections]
  block = "crosssections"
  optional = false
  reader = "urword"
  type = "list"
  
