  reader = "urword"
  optional = false
  longname = "obs6 input filename"
  type = "string"
  
  [children.chf-nam.children.chf-pcp.blocks.options.obs6]
  block = "options"
  description = "keyword to specify that record corresponds to an observations file."
  reader = "urword"
  optional = false
  longname = "obs keyword"
  type = "keyword"
  
  [children.chf-nam.children.chf-pcp.blocks.options.obs6_filename]
  block = "options"
  description = "name of input file to define observations for the PCP package. See the 'Observation utility' section for instructions for preparing observation input files. Table {#2} lists observation type(s) supported by the PCP package."
  reader = "urword"
  optional = false
  longname = "obs6 input filename"
  type = "string"
  
  [children.chf-nam.children.chf-pcp.blocks.dimensions.maxbound]
  block = "dimensions"
  description = "integer value specifying the maximum number of precipitation cells that will be specified for use during any stress period."
  reader = "urword"
  optional = false
  longname = "maximum number of precipitation cells"
  type = "integer"
  
  [children.chf-nam.children.chf-pcp.blocks.period.iper]
  shape = "(nper, nnodes)"
  block = "period"
  description = "integer value specifying the starting stress period number for which the data specified in the PERIOD block apply.  IPER must be less than or equal to NPER in the TDIS Package and greater than zero.  The IPER value assigned to a stress period block must be greater than the IPER value assigned for the previous PERIOD block.  The information specified in the PERIOD block will continue to apply for all subsequent stress periods, unless the program encounters another PERIOD block."
  block_variable = true
  reader = "urword"
