              "shape": "(time_series_names)",
              "block": "attributes",
              "description": "Interpolation method, which is either STEPWISE or LINEAR.",
              "valid": "stepwise linear linearend",
              "reader": "urword",
              "optional": false,
              "type": "string"
            },
            "interpolation_methodrecord_single": {
              "block": "attributes",
              "description": "xxx",
              "reader": "urword",
              "optional": true,
              "type": "record"
            },
            "method": {
              "block": "attributes",
              "description": " xxx",
              "reader": "urword",
