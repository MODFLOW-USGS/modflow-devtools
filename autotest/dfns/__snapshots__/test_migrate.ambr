  [children.utl-spc.blocks.dimensions.maxbound]
  block = "dimensions"
  description = "integer value specifying the maximum number of spc cells that will be specified for use during any stress period."
  reader = "urword"
  optional = false
  longname = "maximum number of ssm entries"
  type = "integer"
  
  [children.utl-spc.blocks.period.iper]
  shape = "(nper)"
  block = "period"
  description = "integer value specifying the starting stress period number for which the data specified in the PERIOD block apply.  IPER must be less than or equal to NPER in the TDIS Package and greater than zero.  The IPER value assigned to a stress period block must be greater than the IPER value assigned for the previous PERIOD block.  The information specified in the PERIOD block will continue to apply for all subsequent stress periods, unless the program encounters another PERIOD block."
  block_variable = true
  reader = "urword"
  optional = false
  longname = "stress period number"
  type = "integer"
  
  [children.utl-spc.blocks.period.perioddata]
  shape = "(nper)"
  block = "period"
  reader = "urword"
  type = "list"
  
  [children.utl-spc.blocks.period.perioddata.children.perioddata]
  type = "record"
  block = "period"
  reader = "urword"
  
  [children.utl-spc.blocks.period.perioddata.children.perioddata.children.bndno]
  block = "period"
  description = "integer value that defines the boundary package feature number associated with the specified PERIOD data on the line. BNDNO must be greater than zero and less than or equal to MAXBOUND."
  reader = "urword"
  longname = "bound number for this entry"
  numeric_index = true
  type = "integer"
  
  [children.utl-spc.blocks.period.perioddata.children.perioddata.children.spcsetting]
  block = "period"
  description = "line of information that is parsed into a keyword and values.  Keyword values that can be used to start the SPCSETTING string include: CONCENTRATION and TEMPERATURE."
  reader = "urword"
  type = "union"
  
  [children.utl-spc.blocks.period.perioddata.children.perioddata.children.spcsetting.children.concentration]
  block = "period"
  description = "is the boundary concentration. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value. By default, the CONCENTRATION for each boundary feature is zero."
  reader = "urword"
  time_series = true
  longname = "boundary concentration"
  type = "double"
  
  [children.utl-spc.blocks.period.perioddata.children.perioddata.children.spcsetting.children.temperature]
  block = "period"
  description = "is the user-supplied boundary temperature. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value. By default, the TEMPERATURE for each boundary feature is zero."
  reader = "urword"
  time_series = true
  longname = "boundary temperature"
  type = "double"
  
  [children.utl-spc.blocks.period.bndno]
  shape = "(nper)"
  block = "period"
  description = "integer value that defines the boundary package feature number associated with the specified PERIOD data on the line. BNDNO must be greater than zero and less than or equal to MAXBOUND."
  reader = "urword"
  longname = "bound number for this entry"
  numeric_index = true
  type = "integer"
  
  [children.utl-spc.blocks.period.spcsetting]
  shape = "(nper)"
  block = "period"
  description = "line of information that is parsed into a keyword and values.  Keyword values that can be used to start the SPCSETTING string include: CONCENTRATION and TEMPERATURE."
  reader = "urword"
  type = "union"
  
  [children.utl-spc.blocks.period.spcsetting.children.concentration]
  block = "period"
  description = "is the boundary concentration. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value. By default, the CONCENTRATION for each boundary feature is zero."
  reader = "urword"
  time_series = true
  longname = "boundary concentration"
  type = "double"
  
  [children.utl-spc.blocks.period.spcsetting.children.temperature]
  block = "period"
  description = "is the user-supplied boundary temperature. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value. By default, the TEMPERATURE for each boundary feature is zero."
  reader = "urword"
  time_series = true
  longname = "boundary temperature"
  type = "double"
  
  [children.utl-spc.blocks.period.concentration]
  shape = "(nper)"
  block = "period"
  description = "is the boundary concentration. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value. By default, the CONCENTRATION for each boundary feature is zero."
  reader = "urword"
  time_series = true
  longname = "boundary concentration"
  type = "double"
  
  [children.utl-spc.blocks.period.temperature]
  shape = "(nper)"
  block = "period"
  description = "is the user-supplied boundary temperature. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value. By default, the TEMPERATURE for each boundary feature is zero."
  reader = "urword"
  time_series = true
  longname = "boundary temperature"
