  longname = "vertices data"
  type = "record"
  
  [children.chf-nam.children.chf-disv1d.blocks.vertices.vertices.children.vertices.children.iv]
  block = "vertices"
  description = "is the vertex number.  Records in the VERTICES block must be listed in consecutive order from 1 to NVERT."
  reader = "urword"
  optional = false
  longname = "vertex number"
  numeric_index = true
  type = "integer"
  
  [children.chf-nam.children.chf-disv1d.blocks.vertices.vertices.children.vertices.children.xv]
  block = "vertices"
  description = "is the x-coordinate for the vertex."
