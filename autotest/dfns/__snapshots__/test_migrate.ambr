  reader = "urword"
  longname = "flow type"
  type = "string"
  
  [children.prt-nam.children.prt-fmi.blocks.packagedata.packagedata.children.packagedata.children.filein]
  block = "packagedata"
  description = "keyword to specify that an input filename is expected next."
