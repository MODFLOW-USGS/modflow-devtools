  [children.prt-nam.children.prt-dis.blocks.dimensions.nrow]
  block = "dimensions"
  description = "is the number of rows in the model grid."
  default = "2"
  reader = "urword"
  optional = false
  longname = "number of rows"
  type = "integer"
  
  [children.prt-nam.children.prt-dis.blocks.dimensions.ncol]
  block = "dimensions"
  description = "is the number of columns in the model grid."
  default = "2"
  reader = "urword"
