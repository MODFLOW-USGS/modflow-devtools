  reader = "urword"
  optional = false
  longname = "obs6 input filename"
  type = "string"
  
  [children.gwe-nam.children.gwe-uze.blocks.packagedata.packagedata]
  shape = "(maxbound)"
  block = "packagedata"
  reader = "urword"
  type = "list"
  
  [children.gwe-nam.children.gwe-uze.blocks.packagedata.packagedata.children.packagedata]
  shape = "(maxbound)"
  block = "packagedata"
  reader = "urword"
  type = "record"
  
  [children.gwe-nam.children.gwe-uze.blocks.packagedata.packagedata.children.packagedata.children.uzfno]
  block = "packagedata"
  description = "integer value that defines the UZF cell number associated with the specified PACKAGEDATA data on the line. UZFNO must be greater than zero and less than or equal to NUZFCELLS. Unsaturated zone flow information must be specified for every UZF cell or the program will terminate with an error.  The program also will terminate with an error if information for a UZF cell is specified more than once."
  reader = "urword"
  longname = "UZF cell number for this entry"
  numeric_index = true
  type = "integer"
  
  [children.gwe-nam.children.gwe-uze.blocks.packagedata.packagedata.children.packagedata.children.strt]
  block = "packagedata"
  description = "real value that defines the starting temperature for the unsaturated zone flow cell."
  reader = "urword"
  longname = "starting UZF cell temperature"
  type = "double"
  
  [children.gwe-nam.children.gwe-uze.blocks.packagedata.packagedata.children.packagedata.children.aux]
  shape = "(naux)"
  block = "packagedata"
  description = "represents the values of the auxiliary variables for each unsaturated zone flow. The values of auxiliary variables must be present for each unsaturated zone flow. The values must be specified in the order of the auxiliary variables specified in the OPTIONS block.  If the package supports time series and the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  optional = true
  longname = "auxiliary variables"
  type = "double"
  
  [children.gwe-nam.children.gwe-uze.blocks.packagedata.packagedata.children.packagedata.children.boundname]
  block = "packagedata"
  description = "name of the unsaturated zone flow cell.  BOUNDNAME is an ASCII character variable that can contain as many as 40 characters.  If BOUNDNAME contains spaces in it, then the entire name must be enclosed within single quotes."
  reader = "urword"
  optional = true
  longname = "UZF cell name"
  type = "string"
  
  [children.gwe-nam.children.gwe-uze.blocks.packagedata.uzfno]
  block = "packagedata"
  description = "integer value that defines the UZF cell number associated with the specified PACKAGEDATA data on the line. UZFNO must be greater than zero and less than or equal to NUZFCELLS. Unsaturated zone flow information must be specified for every UZF cell or the program will terminate with an error.  The program also will terminate with an error if information for a UZF cell is specified more than once."
  reader = "urword"
  longname = "UZF cell number for this entry"
  numeric_index = true
  type = "integer"
  
  [children.gwe-nam.children.gwe-uze.blocks.packagedata.strt]
  block = "packagedata"
  description = "real value that defines the starting temperature for the unsaturated zone flow cell."
  reader = "urword"
  longname = "starting UZF cell temperature"
  type = "double"
  
  [children.gwe-nam.children.gwe-uze.blocks.packagedata.aux]
  shape = "(naux)"
  block = "packagedata"
  description = "represents the values of the auxiliary variables for each unsaturated zone flow. The values of auxiliary variables must be present for each unsaturated zone flow. The values must be specified in the order of the auxiliary variables specified in the OPTIONS block.  If the package supports time series and the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  optional = true
  longname = "auxiliary variables"
  type = "double"
  
  [children.gwe-nam.children.gwe-uze.blocks.packagedata.boundname]
  block = "packagedata"
  description = "name of the unsaturated zone flow cell.  BOUNDNAME is an ASCII character variable that can contain as many as 40 characters.  If BOUNDNAME contains spaces in it, then the entire name must be enclosed within single quotes."
  reader = "urword"
  optional = true
  longname = "UZF cell name"
  type = "string"
  
  [children.gwe-nam.children.gwe-uze.blocks.period.iper]
  shape = "(nper)"
  block = "period"
  description = "integer value specifying the starting stress period number for which the data specified in the PERIOD block apply.  IPER must be less than or equal to NPER in the TDIS Package and greater than zero.  The IPER value assigned to a stress period block must be greater than the IPER value assigned for the previous PERIOD block.  The information specified in the PERIOD block will continue to apply for all subsequent stress periods, unless the program encounters another PERIOD block."
  block_variable = true
  reader = "urword"
  optional = false
  longname = "stress period number"
  type = "integer"
  
  [children.gwe-nam.children.gwe-uze.blocks.period.uzeperioddata]
  shape = "(nper)"
  block = "period"
  reader = "urword"
  type = "list"
  
  [children.gwe-nam.children.gwe-uze.blocks.period.uzeperioddata.children.uzeperioddata]
  type = "record"
  block = "period"
  reader = "urword"
  
  [children.gwe-nam.children.gwe-uze.blocks.period.uzeperioddata.children.uzeperioddata.children.uzfno]
  block = "period"
  description = "integer value that defines the UZF cell number associated with the specified PERIOD data on the line. UZFNO must be greater than zero and less than or equal to NUZFCELLS."
  reader = "urword"
  longname = "unsaturated zone flow cell number for this entry"
  numeric_index = true
  type = "integer"
  
  [children.gwe-nam.children.gwe-uze.blocks.period.uzeperioddata.children.uzeperioddata.children.uzesetting]
  block = "period"
  description = "line of information that is parsed into a keyword and values.  Keyword values that can be used to start the UZESETTING string include: STATUS, TEMPERATURE, INFILTRATION, UZET, and AUXILIARY.  These settings are used to assign the temperature associated with the corresponding flow terms.  Temperatures cannot be specified for all flow terms."
  reader = "urword"
  type = "union"
  
  [children.gwe-nam.children.gwe-uze.blocks.period.uzeperioddata.children.uzeperioddata.children.uzesetting.children.temperature]
  block = "period"
  description = "real or character value that defines the temperature for the unsaturated zone flow cell. The specified TEMPERATURE is only applied if the unsaturated zone flow cell is a constant temperature cell. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  time_series = true
  reader = "urword"
  longname = "unsaturated zone flow cell temperature"
  type = "string"
  
  [children.gwe-nam.children.gwe-uze.blocks.period.uzeperioddata.children.uzeperioddata.children.uzesetting.children.status]
  block = "period"
  description = "keyword option to define UZF cell status.  STATUS can be ACTIVE, INACTIVE, or CONSTANT. By default, STATUS is ACTIVE, which means that temperature will be calculated for the UZF cell.  If a UZF cell is inactive, then there will be no energy fluxes into or out of the UZF cell and the inactive value will be written for the UZF cell temperature.  If a UZF cell is constant, then the temperature for the UZF cell will be fixed at the user specified value."
  reader = "urword"
  longname = "unsaturated zone flow cell temperature status"
  type = "string"
  
  [children.gwe-nam.children.gwe-uze.blocks.period.uzeperioddata.children.uzeperioddata.children.uzesetting.children.infiltration]
  block = "period"
  description = "real or character value that defines the temperature of the infiltration $(e.g.,:^{circ}C:or:^{circ}F)$ for the UZF cell. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "infiltration temperature"
  type = "string"
  
  [children.gwe-nam.children.gwe-uze.blocks.period.uzeperioddata.children.uzeperioddata.children.uzesetting.children.uzet]
  block = "period"
  description = "real or character value that states what fraction of the simulated unsaturated zone evapotranspiration is associated with evaporation.  The evaporative losses from the unsaturated zone moisture content will have an evaporative cooling effect on the GWE cell from which the evaporation originated. If this value is larger than 1, then it will be reset to 1.  If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "unsaturated zone et temperature"
  type = "string"
  
  [children.gwe-nam.children.gwe-uze.blocks.period.uzeperioddata.children.uzeperioddata.children.uzesetting.children.auxiliaryrecord]
  block = "period"
  reader = "urword"
  type = "record"
  
  [children.gwe-nam.children.gwe-uze.blocks.period.uzeperioddata.children.uzeperioddata.children.uzesetting.children.auxiliaryrecord.children.auxiliary]
  block = "period"
  description = "keyword for specifying auxiliary variable."
  reader = "urword"
  type = "keyword"
  
  [children.gwe-nam.children.gwe-uze.blocks.period.uzeperioddata.children.uzeperioddata.children.uzesetting.children.auxiliaryrecord.children.auxname]
  block = "period"
  description = "name for the auxiliary variable to be assigned AUXVAL.  AUXNAME must match one of the auxiliary variable names defined in the OPTIONS block. If AUXNAME does not match one of the auxiliary variable names defined in the OPTIONS block the data are ignored."
  reader = "urword"
  type = "string"
  
  [children.gwe-nam.children.gwe-uze.blocks.period.uzeperioddata.children.uzeperioddata.children.uzesetting.children.auxiliaryrecord.children.auxval]
  block = "period"
  description = "value for the auxiliary variable. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "auxiliary variable value"
  type = "double"
  
  [children.gwe-nam.children.gwe-uze.blocks.period.uzfno]
  shape = "(nper)"
  block = "period"
  description = "integer value that defines the UZF cell number associated with the specified PERIOD data on the line. UZFNO must be greater than zero and less than or equal to NUZFCELLS."
  reader = "urword"
  longname = "unsaturated zone flow cell number for this entry"
  numeric_index = true
  type = "integer"
  
  [children.gwe-nam.children.gwe-uze.blocks.period.uzesetting]
  shape = "(nper)"
  block = "period"
  description = "line of information that is parsed into a keyword and values.  Keyword values that can be used to start the UZESETTING string include: STATUS, TEMPERATURE, INFILTRATION, UZET, and AUXILIARY.  These settings are used to assign the temperature associated with the corresponding flow terms.  Temperatures cannot be specified for all flow terms."
  reader = "urword"
  type = "union"
  
  [children.gwe-nam.children.gwe-uze.blocks.period.uzesetting.children.temperature]
  block = "period"
  description = "real or character value that defines the temperature for the unsaturated zone flow cell. The specified TEMPERATURE is only applied if the unsaturated zone flow cell is a constant temperature cell. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  time_series = true
  reader = "urword"
  longname = "unsaturated zone flow cell temperature"
  type = "string"
  
  [children.gwe-nam.children.gwe-uze.blocks.period.uzesetting.children.status]
  block = "period"
  description = "keyword option to define UZF cell status.  STATUS can be ACTIVE, INACTIVE, or CONSTANT. By default, STATUS is ACTIVE, which means that temperature will be calculated for the UZF cell.  If a UZF cell is inactive, then there will be no energy fluxes into or out of the UZF cell and the inactive value will be written for the UZF cell temperature.  If a UZF cell is constant, then the temperature for the UZF cell will be fixed at the user specified value."
  reader = "urword"
  longname = "unsaturated zone flow cell temperature status"
  type = "string"
  
  [children.gwe-nam.children.gwe-uze.blocks.period.uzesetting.children.infiltration]
  block = "period"
  description = "real or character value that defines the temperature of the infiltration $(e.g.,:^{circ}C:or:^{circ}F)$ for the UZF cell. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "infiltration temperature"
  type = "string"
  
  [children.gwe-nam.children.gwe-uze.blocks.period.uzesetting.children.uzet]
  block = "period"
  description = "real or character value that states what fraction of the simulated unsaturated zone evapotranspiration is associated with evaporation.  The evaporative losses from the unsaturated zone moisture content will have an evaporative cooling effect on the GWE cell from which the evaporation originated. If this value is larger than 1, then it will be reset to 1.  If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "unsaturated zone et temperature"
  type = "string"
  
  [children.gwe-nam.children.gwe-uze.blocks.period.uzesetting.children.auxiliaryrecord]
  block = "period"
  reader = "urword"
  type = "record"
  
  [children.gwe-nam.children.gwe-uze.blocks.period.uzesetting.children.auxiliaryrecord.children.auxiliary]
  block = "period"
  description = "keyword for specifying auxiliary variable."
  reader = "urword"
  type = "keyword"
  
  [children.gwe-nam.children.gwe-uze.blocks.period.uzesetting.children.auxiliaryrecord.children.auxname]
  block = "period"
  description = "name for the auxiliary variable to be assigned AUXVAL.  AUXNAME must match one of the auxiliary variable names defined in the OPTIONS block. If AUXNAME does not match one of the auxiliary variable names defined in the OPTIONS block the data are ignored."
  reader = "urword"
  type = "string"
  
  [children.gwe-nam.children.gwe-uze.blocks.period.uzesetting.children.auxiliaryrecord.children.auxval]
  block = "period"
  description = "value for the auxiliary variable. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "auxiliary variable value"
  type = "double"
  
  [children.gwe-nam.children.gwe-uze.blocks.period.status]
  shape = "(nper)"
  block = "period"
  description = "keyword option to define UZF cell status.  STATUS can be ACTIVE, INACTIVE, or CONSTANT. By default, STATUS is ACTIVE, which means that temperature will be calculated for the UZF cell.  If a UZF cell is inactive, then there will be no energy fluxes into or out of the UZF cell and the inactive value will be written for the UZF cell temperature.  If a UZF cell is constant, then the temperature for the UZF cell will be fixed at the user specified value."
  reader = "urword"
  longname = "unsaturated zone flow cell temperature status"
  type = "string"
  
  [children.gwe-nam.children.gwe-uze.blocks.period.temperature]
  shape = "(nper)"
  block = "period"
  description = "real or character value that defines the temperature for the unsaturated zone flow cell. The specified TEMPERATURE is only applied if the unsaturated zone flow cell is a constant temperature cell. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  time_series = true
  reader = "urword"
  longname = "unsaturated zone flow cell temperature"
  type = "string"
  
  [children.gwe-nam.children.gwe-uze.blocks.period.infiltration]
  shape = "(nper)"
  block = "period"
  description = "real or character value that defines the temperature of the infiltration $(e.g.,:^{circ}C:or:^{circ}F)$ for the UZF cell. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "infiltration temperature"
  type = "string"
  
  [children.gwe-nam.children.gwe-uze.blocks.period.uzet]
  shape = "(nper)"
  block = "period"
  description = "real or character value that states what fraction of the simulated unsaturated zone evapotranspiration is associated with evaporation.  The evaporative losses from the unsaturated zone moisture content will have an evaporative cooling effect on the GWE cell from which the evaporation originated. If this value is larger than 1, then it will be reset to 1.  If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "unsaturated zone et temperature"
  type = "string"
  
  [children.gwe-nam.children.gwe-uze.blocks.period.auxiliaryrecord]
  shape = "(nper)"
  block = "period"
  reader = "urword"
  type = "record"
  
  [children.gwe-nam.children.gwe-uze.blocks.period.auxiliaryrecord.children.auxiliary]
  block = "period"
  description = "keyword for specifying auxiliary variable."
  reader = "urword"
  type = "keyword"
  
  [children.gwe-nam.children.gwe-uze.blocks.period.auxiliaryrecord.children.auxname]
  block = "period"
  description = "name for the auxiliary variable to be assigned AUXVAL.  AUXNAME must match one of the auxiliary variable names defined in the OPTIONS block. If AUXNAME does not match one of the auxiliary variable names defined in the OPTIONS block the data are ignored."
  reader = "urword"
  type = "string"
  
  [children.gwe-nam.children.gwe-uze.blocks.period.auxiliaryrecord.children.auxval]
  block = "period"
  description = "value for the auxiliary variable. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "auxiliary variable value"
  type = "double"
  
  [children.gwe-nam.children.gwe-uze.blocks.period.auxiliary]
  shape = "(nper)"
  block = "period"
  description = "keyword for specifying auxiliary variable."
  reader = "urword"
  type = "keyword"
  
  [children.gwe-nam.children.gwe-uze.blocks.period.auxname]
  shape = "(nper)"
  block = "period"
  description = "name for the auxiliary variable to be assigned AUXVAL.  AUXNAME must match one of the auxiliary variable names defined in the OPTIONS block. If AUXNAME does not match one of the auxiliary variable names defined in the OPTIONS block the data are ignored."
  reader = "urword"
  type = "string"
  
  [children.gwe-nam.children.gwe-uze.blocks.period.auxval]
  shape = "(nper)"
  block = "period"
  description = "value for the auxiliary variable. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "auxiliary variable value"
  type = "double"
  
  [children.swf-nam]
  name = "swf-nam"
  schema_version = "1.2"
  parent = "sim-nam"
  advanced = false
  multi = false
  ftype = "NAM"
  
  [children.swf-nam.blocks.options.list]
  block = "options"
  description = "is name of the listing file to create for this SWF model.  If not specified, then the name of the list file will be the basename of the SWF model name file and the '.lst' extension.  For example, if the SWF name file is called 'my.model.nam' then the list file will be called 'my.model.lst'."
  reader = "urword"
  optional = true
  longname = "name of listing file"
  type = "string"
  
  [children.swf-nam.blocks.options.print_input]
  block = "options"
  description = "keyword to indicate that the list of all model stress package information will be written to the listing file immediately after it is read."
  reader = "urword"
  optional = true
  longname = "print input to listing file"
  type = "keyword"
  
  [children.swf-nam.blocks.options.print_flows]
  block = "options"
  description = "keyword to indicate that the list of all model package flow rates will be printed to the listing file for every stress period time step in which 'BUDGET PRINT' is specified in Output Control.  If there is no Output Control option and 'PRINT_FLOWS' is specified, then flow rates are printed for the last time step of each stress period."
  reader = "urword"
  optional = true
  longname = "print calculated flows to listing file"
  type = "keyword"
  
  [children.swf-nam.blocks.options.save_flows]
  block = "options"
  description = "keyword to indicate that all model package flow terms will be written to the file specified with 'BUDGET FILEOUT' in Output Control."
  reader = "urword"
  optional = true
  longname = "save flows for all packages to budget file"
  type = "keyword"
  
  [children.swf-nam.blocks.options.newtonoptions]
  block = "options"
  description = "none"
  reader = "urword"
  optional = true
  longname = "newton keyword and options"
  type = "record"
  
  [children.swf-nam.blocks.options.newtonoptions.children.newton]
  block = "options"
  description = "keyword that activates the Newton-Raphson formulation for surface water flow between connected reaches and stress packages that support calculation of Newton-Raphson terms."
  reader = "urword"
  longname = "keyword to activate Newton-Raphson formulation"
  type = "keyword"
  
  [children.swf-nam.blocks.options.newtonoptions.children.under_relaxation]
  block = "options"
  description = "keyword that indicates whether the surface water stage in a reach will be under-relaxed when water levels fall below the bottom of the model below any given cell. By default, Newton-Raphson UNDER_RELAXATION is not applied."
  reader = "urword"
  optional = true
  longname = "keyword to activate Newton-Raphson UNDER_RELAXATION option"
  type = "keyword"
  
  [children.swf-nam.blocks.options.newton]
  block = "options"
  description = "keyword that activates the Newton-Raphson formulation for surface water flow between connected reaches and stress packages that support calculation of Newton-Raphson terms."
  reader = "urword"
  longname = "keyword to activate Newton-Raphson formulation"
  type = "keyword"
  
  [children.swf-nam.blocks.options.under_relaxation]
  block = "options"
  description = "keyword that indicates whether the surface water stage in a reach will be under-relaxed when water levels fall below the bottom of the model below any given cell. By default, Newton-Raphson UNDER_RELAXATION is not applied."
  reader = "urword"
  optional = true
  longname = "keyword to activate Newton-Raphson UNDER_RELAXATION option"
  type = "keyword"
  
  [children.swf-nam.blocks.packages.packages]
  block = "packages"
  reader = "urword"
  optional = false
  longname = "package list"
  type = "list"
  
  [children.swf-nam.blocks.packages.packages.children.packages]
  block = "packages"
  reader = "urword"
  optional = false
  longname = "package list"
  type = "record"
  
  [children.swf-nam.blocks.packages.packages.children.packages.children.ftype]
  block = "packages"
  description = "is the file type, which must be one of the following character values shown in table~ref{table:ftype-swf}. Ftype may be entered in any combination of uppercase and lowercase."
  reader = "urword"
  longname = "package type"
  type = "string"
  
  [children.swf-nam.blocks.packages.packages.children.packages.children.fname]
  block = "packages"
  description = "is the name of the file containing the package input.  The path to the file should be included if the file is not located in the folder where the program was run."
  reader = "urword"
  longname = "file name"
  type = "string"
  
  [children.swf-nam.blocks.packages.packages.children.packages.children.pname]
  block = "packages"
  description = "is the user-defined name for the package. PNAME is restricted to 16 characters.  No spaces are allowed in PNAME.  PNAME character values are read and stored by the program for stress packages only.  These names may be useful for labeling purposes when multiple stress packages of the same type are located within a single SWF Model.  If PNAME is specified for a stress package, then PNAME will be used in the flow budget table in the listing file; it will also be used for the text entry in the cell-by-cell budget file.  PNAME is case insensitive and is stored in all upper case letters."
  reader = "urword"
  optional = true
  longname = "user name for package"
  type = "string"
  
  [children.swf-nam.blocks.packages.ftype]
  block = "packages"
  description = "is the file type, which must be one of the following character values shown in table~ref{table:ftype-swf}. Ftype may be entered in any combination of uppercase and lowercase."
  reader = "urword"
  longname = "package type"
  type = "string"
  
  [children.swf-nam.blocks.packages.fname]
  block = "packages"
  description = "is the name of the file containing the package input.  The path to the file should be included if the file is not located in the folder where the program was run."
  reader = "urword"
  longname = "file name"
  type = "string"
  
  [children.swf-nam.blocks.packages.pname]
  block = "packages"
  description = "is the user-defined name for the package. PNAME is restricted to 16 characters.  No spaces are allowed in PNAME.  PNAME character values are read and stored by the program for stress packages only.  These names may be useful for labeling purposes when multiple stress packages of the same type are located within a single SWF Model.  If PNAME is specified for a stress package, then PNAME will be used in the flow budget table in the listing file; it will also be used for the text entry in the cell-by-cell budget file.  PNAME is case insensitive and is stored in all upper case letters."
  reader = "urword"
  optional = true
  longname = "user name for package"
  type = "string"
  
  [children.swf-nam.children.swf-cdb]
  name = "swf-cdb"
  schema_version = "1.2"
  parent = "swf-nam"
  advanced = false
  multi = true
  ftype = "CDB"
  
  [children.swf-nam.children.swf-cdb.blocks.options.auxiliary]
  shape = "(naux)"
  block = "options"
  description = "defines an array of one or more auxiliary variable names.  There is no limit on the number of auxiliary variables that can be provided on this line; however, lists of information provided in subsequent blocks must have a column of data for each auxiliary variable name defined here.   The number of auxiliary variables detected on this line determines the value for naux.  Comments cannot be provided anywhere on this line as they will be interpreted as auxiliary variable names.  Auxiliary variables may not be used by the package, but they will be available for use by other parts of the program.  The program will terminate with an error if auxiliary variables are specified on more than one line in the options block."
  reader = "urword"
  optional = true
  longname = "keyword to specify aux variables"
  type = "string"
  
  [children.swf-nam.children.swf-cdb.blocks.options.boundnames]
  block = "options"
  description = "keyword to indicate that boundary names may be provided with the list of critical depth boundary cells."
  reader = "urword"
  optional = true
  type = "keyword"
  
  [children.swf-nam.children.swf-cdb.blocks.options.print_input]
  block = "options"
  description = "keyword to indicate that the list of critical depth boundary information will be written to the listing file immediately after it is read."
  reader = "urword"
  optional = true
  longname = "print input to listing file"
  mf6internal = "iprpak"
  type = "keyword"
  
  [children.swf-nam.children.swf-cdb.blocks.options.print_flows]
  block = "options"
  description = "keyword to indicate that the list of critical depth boundary flow rates will be printed to the listing file for every stress period time step in which 'BUDGET PRINT' is specified in Output Control.  If there is no Output Control option and 'PRINT_FLOWS' is specified, then flow rates are printed for the last time step of each stress period."
  reader = "urword"
  optional = true
  longname = "print calculated flows to listing file"
  mf6internal = "iprflow"
  type = "keyword"
  
  [children.swf-nam.children.swf-cdb.blocks.options.save_flows]
  block = "options"
  description = "keyword to indicate that critical depth boundary flow terms will be written to the file specified with 'BUDGET FILEOUT' in Output Control."
  reader = "urword"
  optional = true
  longname = "save flows to budget file"
  mf6internal = "ipakcb"
  type = "keyword"
  
  [children.swf-nam.children.swf-cdb.blocks.options.filein]
  block = "options"
  description = "keyword to specify that an input filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.swf-nam.children.swf-cdb.blocks.options.obs_filerecord]
  block = "options"
  reader = "urword"
  optional = true
  type = "record"
  
  [children.swf-nam.children.swf-cdb.blocks.options.obs_filerecord.children.obs6]
  block = "options"
  description = "keyword to specify that record corresponds to an observations file."
  reader = "urword"
  optional = false
  longname = "obs keyword"
  type = "keyword"
  
  [children.swf-nam.children.swf-cdb.blocks.options.obs_filerecord.children.filein]
  block = "options"
  description = "keyword to specify that an input filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.swf-nam.children.swf-cdb.blocks.options.obs_filerecord.children.obs6_filename]
  block = "options"
  description = "name of input file to define observations for the Zero-Depth-Gradient Boundary package. See the 'Observation utility' section for instructions for preparing observation input files. Table {#2} lists observation type(s) supported by the Zero-Depth-Gradient Boundary package."
  reader = "urword"
  optional = false
  longname = "obs6 input filename"
  type = "string"
  
  [children.swf-nam.children.swf-cdb.blocks.options.obs6]
  block = "options"
  description = "keyword to specify that record corresponds to an observations file."
  reader = "urword"
  optional = false
  longname = "obs keyword"
  type = "keyword"
  
  [children.swf-nam.children.swf-cdb.blocks.options.obs6_filename]
  block = "options"
  description = "name of input file to define observations for the Zero-Depth-Gradient Boundary package. See the 'Observation utility' section for instructions for preparing observation input files. Table {#2} lists observation type(s) supported by the Zero-Depth-Gradient Boundary package."
  reader = "urword"
  optional = false
  longname = "obs6 input filename"
  type = "string"
  
  [children.swf-nam.children.swf-cdb.blocks.dimensions.maxbound]
  block = "dimensions"
  description = "integer value specifying the maximum number of critical depth boundary cells that will be specified for use during any stress period."
  reader = "urword"
  optional = false
  longname = "maximum number of critical depth boundaries"
  type = "integer"
  
  [children.swf-nam.children.swf-cdb.blocks.period.iper]
  shape = "(nper, nnodes)"
  block = "period"
  description = "integer value specifying the starting stress period number for which the data specified in the PERIOD block apply.  IPER must be less than or equal to NPER in the TDIS Package and greater than zero.  The IPER value assigned to a stress period block must be greater than the IPER value assigned for the previous PERIOD block.  The information specified in the PERIOD block will continue to apply for all subsequent stress periods, unless the program encounters another PERIOD block."
  block_variable = true
  reader = "urword"
  optional = false
  longname = "stress period number"
  type = "integer"
  
  [children.swf-nam.children.swf-cdb.blocks.period.stress_period_data]
  shape = "(nper, nnodes)"
  block = "period"
  reader = "urword"
  mf6internal = "spd"
  type = "list"
  
  [children.swf-nam.children.swf-cdb.blocks.period.stress_period_data.children.stress_period_data]
  shape = "(maxbound)"
  block = "period"
  reader = "urword"
  mf6internal = "spd"
  type = "record"
  
  [children.swf-nam.children.swf-cdb.blocks.period.stress_period_data.children.stress_period_data.children.cellid]
  shape = "(ncelldim)"
  block = "period"
  description = "is the cell identifier, and depends on the type of grid that is used for the simulation.  For a structured grid that uses the DIS input file, CELLID is the layer, row, and column.   For a grid that uses the DISV input file, CELLID is the layer and CELL2D number.  If the model uses the unstructured discretization (DISU) input file, CELLID is the node number for the cell."
  reader = "urword"
  longname = "cell identifier"
  type = "integer"
  
  [children.swf-nam.children.swf-cdb.blocks.period.stress_period_data.children.stress_period_data.children.idcxs]
  block = "period"
  description = "is the identifier for the cross section specified in the CXS Package.  A value of zero indicates the zero-depth-gradient calculation will use parameters for a hydraulically wide channel."
  reader = "urword"
  time_series = false
  longname = "cross section identifier"
  numeric_index = true
  type = "integer"
  
  [children.swf-nam.children.swf-cdb.blocks.period.stress_period_data.children.stress_period_data.children.width]
  block = "period"
  description = "is the channel width of the zero-depth gradient boundary. If a cross section is associated with this boundary, the width will be scaled by the cross section information.  If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "width of the zero-depth gradient boundary"
  type = "double"
  
  [children.swf-nam.children.swf-cdb.blocks.period.stress_period_data.children.stress_period_data.children.aux]
  shape = "(naux)"
  block = "period"
  description = "represents the values of the auxiliary variables for each zero-depth-gradient boundary. The values of auxiliary variables must be present for each zero-depth-gradient boundary. The values must be specified in the order of the auxiliary variables specified in the OPTIONS block.  If the package supports time series and the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  optional = true
  time_series = true
  longname = "auxiliary variables"
  mf6internal = "auxvar"
  type = "double"
  
  [children.swf-nam.children.swf-cdb.blocks.period.stress_period_data.children.stress_period_data.children.boundname]
  block = "period"
  description = "name of the zero-depth-gradient boundary cell.  BOUNDNAME is an ASCII character variable that can contain as many as 40 characters.  If BOUNDNAME contains spaces in it, then the entire name must be enclosed within single quotes."
  reader = "urword"
  optional = true
  longname = "zero-depth-gradient boundary name"
  type = "string"
  
  [children.swf-nam.children.swf-cdb.blocks.period.idcxs]
  shape = "(nper, nnodes)"
  block = "period"
  description = "is the identifier for the cross section specified in the CXS Package.  A value of zero indicates the zero-depth-gradient calculation will use parameters for a hydraulically wide channel."
  reader = "urword"
