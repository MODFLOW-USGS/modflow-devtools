  description = "keyword to specify that an input filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-sfr.blocks.crosssections.crosssections.children.crosssections.children.tab6_filename]
  block = "crosssections"
  description = "character string that defines the path and filename for the file containing cross-section table data for the reach. The TAB6_FILENAME file includes the number of entries in the file and the station elevation data in terms of the fractional width and the reach depth. Instructions for creating the TAB6_FILENAME input file are provided in SFR Reach Cross-Section Table Input File section."
  reader = "urword"
  optional = false
  longname = "table file name"
  type = "string"
  
  [children.gwf-nam.children.gwf-sfr.blocks.crosssections.ifno]
  block = "crosssections"
  description = "integer value that defines the feature (reach) number associated with the specified cross-section table file on the line. IFNO must be greater than zero and less than or equal to NREACHES. The program will also terminate with an error if table information for a reach is specified more than once."
  reader = "urword"
  longname = "reach number for this entry"
  numeric_index = true
  type = "integer"
  
  [children.gwf-nam.children.gwf-sfr.blocks.crosssections.tab6]
  block = "crosssections"
  description = "keyword to specify that record corresponds to a cross-section table file."
  reader = "urword"
  optional = false
  longname = "head keyword"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-sfr.blocks.crosssections.filein]
  block = "crosssections"
  description = "keyword to specify that an input filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-sfr.blocks.crosssections.tab6_filename]
  block = "crosssections"
  description = "character string that defines the path and filename for the file containing cross-section table data for the reach. The TAB6_FILENAME file includes the number of entries in the file and the station elevation data in terms of the fractional width and the reach depth. Instructions for creating the TAB6_FILENAME input file are provided in SFR Reach Cross-Section Table Input File section."
  reader = "urword"
  optional = false
  longname = "table file name"
  type = "string"
  
  [children.gwf-nam.children.gwf-sfr.blocks.connectiondata.connectiondata]
  shape = "(maxbound)"
  block = "connectiondata"
  reader = "urword"
  type = "list"
  
  [children.gwf-nam.children.gwf-sfr.blocks.connectiondata.connectiondata.children.connectiondata]
  shape = "(maxbound)"
  block = "connectiondata"
  reader = "urword"
  type = "record"
  
  [children.gwf-nam.children.gwf-sfr.blocks.connectiondata.connectiondata.children.connectiondata.children.ifno]
  block = "packagedata"
  description = "integer value that defines the feature (reach) number associated with the specified PACKAGEDATA data on the line. IFNO must be greater than zero and less than or equal to NREACHES. Reach information must be specified for every reach or the program will terminate with an error.  The program will also terminate with an error if information for a reach is specified more than once."
  reader = "urword"
  longname = "reach number for this entry"
  numeric_index = true
  type = "integer"
  
  [children.gwf-nam.children.gwf-sfr.blocks.connectiondata.connectiondata.children.connectiondata.children.ic]
  shape = "(ncon(ifno))"
  block = "connectiondata"
  description = "integer value that defines the reach number of the reach connected to the current reach and whether it is connected to the upstream or downstream end of the reach. Negative IC numbers indicate connected reaches are connected to the downstream end of the current reach. Positive IC numbers indicate connected reaches are connected to the upstream end of the current reach. The absolute value of IC must be greater than zero and less than or equal to NREACHES. IC should not be specified when NCON is zero but must be specified otherwise."
  reader = "urword"
  optional = true
  longname = "connected reach numbers"
  numeric_index = true
  support_negative_index = true
  type = "integer"
  
  [children.gwf-nam.children.gwf-sfr.blocks.connectiondata.ifno]
  block = "connectiondata"
  description = "integer value that defines the feature (reach) number associated with the specified CONNECTIONDATA data on the line. IFNO must be greater than zero and less than or equal to NREACHES. Reach connection information must be specified for every reach or the program will terminate with an error.  The program will also terminate with an error if connection information for a reach is specified more than once."
  reader = "urword"
  longname = "reach number for this entry"
  numeric_index = true
  type = "integer"
  
  [children.gwf-nam.children.gwf-sfr.blocks.connectiondata.ic]
  shape = "(ncon(ifno))"
  block = "connectiondata"
  description = "integer value that defines the reach number of the reach connected to the current reach and whether it is connected to the upstream or downstream end of the reach. Negative IC numbers indicate connected reaches are connected to the downstream end of the current reach. Positive IC numbers indicate connected reaches are connected to the upstream end of the current reach. The absolute value of IC must be greater than zero and less than or equal to NREACHES. IC should not be specified when NCON is zero but must be specified otherwise."
  reader = "urword"
  optional = true
  longname = "connected reach numbers"
  numeric_index = true
  support_negative_index = true
  type = "integer"
  
  [children.gwf-nam.children.gwf-sfr.blocks.diversions.diversions]
  shape = "(maxbound)"
  block = "diversions"
  reader = "urword"
  type = "list"
  
  [children.gwf-nam.children.gwf-sfr.blocks.diversions.diversions.children.diversions]
  shape = "(maxbound)"
  block = "diversions"
  reader = "urword"
  type = "record"
  
  [children.gwf-nam.children.gwf-sfr.blocks.diversions.diversions.children.diversions.children.ifno]
  block = "packagedata"
  description = "integer value that defines the feature (reach) number associated with the specified PACKAGEDATA data on the line. IFNO must be greater than zero and less than or equal to NREACHES. Reach information must be specified for every reach or the program will terminate with an error.  The program will also terminate with an error if information for a reach is specified more than once."
  reader = "urword"
  longname = "reach number for this entry"
  numeric_index = true
  type = "integer"
  
  [children.gwf-nam.children.gwf-sfr.blocks.diversions.diversions.children.diversions.children.idv]
  block = "diversions"
  description = "integer value that defines the downstream diversion number for the diversion for reach IFNO. IDV must be greater than zero and less than or equal to NDV for reach IFNO."
  reader = "urword"
  longname = "downstream diversion number"
  numeric_index = true
  type = "integer"
  
  [children.gwf-nam.children.gwf-sfr.blocks.diversions.diversions.children.diversions.children.iconr]
  block = "diversions"
  description = "integer value that defines the downstream reach that will receive the diverted water. IDV must be greater than zero and less than or equal to NREACHES. Furthermore, reach  ICONR must be a downstream connection for reach IFNO."
  reader = "urword"
  longname = "downstream reach number for diversion"
  numeric_index = true
  type = "integer"
  
  [children.gwf-nam.children.gwf-sfr.blocks.diversions.diversions.children.diversions.children.cprior]
  block = "diversions"
  description = "character string value that defines the the prioritization system for the diversion, such as when insufficient water is available to meet all diversion stipulations, and is used in conjunction with the value of FLOW value specified in the STRESS_PERIOD_DATA section. Available diversion options include:  (1) CPRIOR = `FRACTION', then the amount of the diversion is computed as a fraction of the streamflow leaving reach IFNO ($Q_{DS}$); in this case, 0.0 $le$ DIVFLOW $le$ 1.0.  (2) CPRIOR = `EXCESS', a diversion is made only if $Q_{DS}$ for reach IFNO exceeds the value of DIVFLOW. If this occurs, then the quantity of water diverted is the excess flow ($Q_{DS} -$ DIVFLOW) and $Q_{DS}$ from reach IFNO is set equal to DIVFLOW. This represents a flood-control type of diversion, as described by Danskin and Hanson (2002). (3) CPRIOR = `THRESHOLD', then if $Q_{DS}$ in reach IFNO is less than the specified diversion flow DIVFLOW, no water is diverted from reach IFNO. If $Q_{DS}$ in reach IFNO is greater than or equal to DIVFLOW, DIVFLOW is diverted and $Q_{DS}$ is set to the remainder ($Q_{DS} -$ DIVFLOW)). This approach assumes that once flow in the stream is sufficiently low, diversions from the stream cease, and is the `priority' algorithm that originally was programmed into the STR1 Package (Prudic, 1989).  (4) CPRIOR = `UPTO' -- if $Q_{DS}$ in reach IFNO is greater than or equal to the specified diversion flow DIVFLOW, $Q_{DS}$ is reduced by DIVFLOW. If $Q_{DS}$ in reach IFNO is less than DIVFLOW, DIVFLOW is set to $Q_{DS}$ and there will be no flow available for reaches connected to downstream end of reach IFNO."
  reader = "urword"
  longname = "iprior code"
  type = "string"
  
  [children.gwf-nam.children.gwf-sfr.blocks.diversions.ifno]
  block = "diversions"
  description = "integer value that defines the feature (reach) number associated with the specified DIVERSIONS data on the line. IFNO must be greater than zero and less than or equal to NREACHES.  Reach diversion information must be specified for every reach with a NDV value greater than 0 or the program will terminate with an error.  The program will also terminate with an error if diversion information for a given reach diversion is specified more than once."
  reader = "urword"
  longname = "reach number for this entry"
  numeric_index = true
  type = "integer"
  
  [children.gwf-nam.children.gwf-sfr.blocks.diversions.idv]
  block = "diversions"
  description = "integer value that defines the downstream diversion number for the diversion for reach IFNO. IDV must be greater than zero and less than or equal to NDV for reach IFNO."
  reader = "urword"
  longname = "downstream diversion number"
  numeric_index = true
  type = "integer"
  
  [children.gwf-nam.children.gwf-sfr.blocks.diversions.iconr]
  block = "diversions"
  description = "integer value that defines the downstream reach that will receive the diverted water. IDV must be greater than zero and less than or equal to NREACHES. Furthermore, reach  ICONR must be a downstream connection for reach IFNO."
  reader = "urword"
  longname = "downstream reach number for diversion"
  numeric_index = true
  type = "integer"
  
  [children.gwf-nam.children.gwf-sfr.blocks.diversions.cprior]
  block = "diversions"
  description = "character string value that defines the the prioritization system for the diversion, such as when insufficient water is available to meet all diversion stipulations, and is used in conjunction with the value of FLOW value specified in the STRESS_PERIOD_DATA section. Available diversion options include:  (1) CPRIOR = `FRACTION', then the amount of the diversion is computed as a fraction of the streamflow leaving reach IFNO ($Q_{DS}$); in this case, 0.0 $le$ DIVFLOW $le$ 1.0.  (2) CPRIOR = `EXCESS', a diversion is made only if $Q_{DS}$ for reach IFNO exceeds the value of DIVFLOW. If this occurs, then the quantity of water diverted is the excess flow ($Q_{DS} -$ DIVFLOW) and $Q_{DS}$ from reach IFNO is set equal to DIVFLOW. This represents a flood-control type of diversion, as described by Danskin and Hanson (2002). (3) CPRIOR = `THRESHOLD', then if $Q_{DS}$ in reach IFNO is less than the specified diversion flow DIVFLOW, no water is diverted from reach IFNO. If $Q_{DS}$ in reach IFNO is greater than or equal to DIVFLOW, DIVFLOW is diverted and $Q_{DS}$ is set to the remainder ($Q_{DS} -$ DIVFLOW)). This approach assumes that once flow in the stream is sufficiently low, diversions from the stream cease, and is the `priority' algorithm that originally was programmed into the STR1 Package (Prudic, 1989).  (4) CPRIOR = `UPTO' -- if $Q_{DS}$ in reach IFNO is greater than or equal to the specified diversion flow DIVFLOW, $Q_{DS}$ is reduced by DIVFLOW. If $Q_{DS}$ in reach IFNO is less than DIVFLOW, DIVFLOW is set to $Q_{DS}$ and there will be no flow available for reaches connected to downstream end of reach IFNO."
  reader = "urword"
  longname = "iprior code"
  type = "string"
  
  [children.gwf-nam.children.gwf-sfr.blocks.initialstages.initialstages]
  shape = "(maxbound)"
  block = "initialstages"
  optional = false
  reader = "urword"
  type = "list"
  
  [children.gwf-nam.children.gwf-sfr.blocks.initialstages.initialstages.children.initialstages]
  shape = "(maxbound)"
  block = "initialstages"
  optional = false
  reader = "urword"
  type = "record"
  
  [children.gwf-nam.children.gwf-sfr.blocks.initialstages.initialstages.children.initialstages.children.ifno]
  block = "packagedata"
  description = "integer value that defines the feature (reach) number associated with the specified PACKAGEDATA data on the line. IFNO must be greater than zero and less than or equal to NREACHES. Reach information must be specified for every reach or the program will terminate with an error.  The program will also terminate with an error if information for a reach is specified more than once."
  reader = "urword"
  longname = "reach number for this entry"
  numeric_index = true
  type = "integer"
  
  [children.gwf-nam.children.gwf-sfr.blocks.initialstages.initialstages.children.initialstages.children.initialstage]
  block = "initialstages"
  description = "real value that defines the initial stage for the reach. The program will terminate with an error if INITIALSTAGE is less than the RTP value for reach IFNO defined in the PACKAGEDATA block.  INITIALSTAGE data are used only if STORAGE is specified in the Options block and the first stress period is transient or for reaches defined to use the SIMPLE STATUS in the Period block."
  optional = false
  reader = "urword"
  longname = "initial reach stage"
  type = "double"
  
  [children.gwf-nam.children.gwf-sfr.blocks.initialstages.ifno]
  block = "initialstages"
  description = "integer value that defines the feature (reach) number associated with the specified initial stage. Initial stage data must be specified for every reach or the program will terminate with an error. The program will also terminate with a error if IFNO is less than one or greater than NREACHES."
  optional = false
  reader = "urword"
  longname = "reach number for this entry"
  numeric_index = true
  type = "integer"
  
  [children.gwf-nam.children.gwf-sfr.blocks.initialstages.initialstage]
  block = "initialstages"
  description = "real value that defines the initial stage for the reach. The program will terminate with an error if INITIALSTAGE is less than the RTP value for reach IFNO defined in the PACKAGEDATA block.  INITIALSTAGE data are used only if STORAGE is specified in the Options block and the first stress period is transient or for reaches defined to use the SIMPLE STATUS in the Period block."
  optional = false
  reader = "urword"
  longname = "initial reach stage"
  type = "double"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.iper]
  shape = "(nper)"
  block = "period"
  description = "integer value specifying the starting stress period number for which the data specified in the PERIOD block apply.  IPER must be less than or equal to NPER in the TDIS Package and greater than zero.  The IPER value assigned to a stress period block must be greater than the IPER value assigned for the previous PERIOD block.  The information specified in the PERIOD block will continue to apply for all subsequent stress periods, unless the program encounters another PERIOD block."
  block_variable = true
  reader = "urword"
  optional = false
  longname = "stress period number"
  type = "integer"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.perioddata]
  shape = "(nper)"
  block = "period"
  reader = "urword"
  type = "list"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.perioddata.children.perioddata]
  type = "record"
  block = "period"
  reader = "urword"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.perioddata.children.perioddata.children.ifno]
  block = "period"
  description = "integer value that defines the feature (reach) number associated with the specified PERIOD data on the line. IFNO must be greater than zero and less than or equal to NREACHES."
  reader = "urword"
  longname = "reach number for this entry"
  numeric_index = true
  type = "integer"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.perioddata.children.perioddata.children.sfrsetting]
  block = "period"
  description = "line of information that is parsed into a keyword and values.  Keyword values that can be used to start the SFRSETTING string include: STATUS, BEDK, MANNING, STAGE, INFLOW, RAINFALL, EVAPORATION, RUNOFF, DIVERSION, UPSTREAM_FRACTION, and AUXILIARY."
  reader = "urword"
  type = "union"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.perioddata.children.perioddata.children.sfrsetting.children.stage]
  block = "period"
  description = "real or character value that defines the stage for the reach. The specified STAGE is only applied if the reach uses the simple routing option. If STAGE is not specified for reaches that use the simple routing option, the specified stage is set to the top of the reach. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "reach stage"
  type = "string"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.perioddata.children.perioddata.children.sfrsetting.children.status]
  block = "period"
  description = "keyword option to define stream reach status.  STATUS can be ACTIVE, INACTIVE, or SIMPLE. The SIMPLE STATUS option simulates streamflow using a user-specified stage for a reach or a stage set to the top of the reach (depth = 0). In cases where the simulated leakage calculated using the specified stage exceeds the sum of inflows to the reach, the stage is set to the top of the reach and leakage is set equal to the sum of inflows. Upstream fractions should be changed using the UPSTREAM_FRACTION SFRSETTING if the status for one or more reaches is changed to ACTIVE or INACTIVE. For example, if one of two downstream connections for a reach is inactivated, the upstream fraction for the active and inactive downstream reach should be changed to 1.0 and 0.0, respectively, to ensure that the active reach receives all of the downstream outflow from the upstream reach. By default, STATUS is ACTIVE."
  reader = "urword"
  longname = "reach status"
  type = "string"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.perioddata.children.perioddata.children.sfrsetting.children.bedk]
  block = "period"
  description = "real or character value that defines the hydraulic conductivity of the reach streambed. BEDK can be any positive value if the reach is not connected to an underlying GWF cell. Otherwise, BEDK must be greater than zero. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "reach bed hydraulic conductivity"
  type = "string"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.perioddata.children.perioddata.children.sfrsetting.children.manning]
  block = "period"
  description = "real or character value that defines the Manning's roughness coefficient for the reach. MANNING must be greater than zero.  If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "reach Manning's roughness coefficient"
  type = "string"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.perioddata.children.perioddata.children.sfrsetting.children.inflow]
  block = "period"
  description = "real or character value that defines the volumetric inflow rate for the streamflow routing reach. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value. By default, inflow rates are zero for each reach."
  reader = "urword"
  time_series = true
  longname = "inflow rate"
  type = "string"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.perioddata.children.perioddata.children.sfrsetting.children.rainfall]
  block = "period"
  description = "real or character value that defines the  volumetric rate per unit area of water added by precipitation directly on the streamflow routing reach. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value. By default, rainfall  rates are zero for each reach."
  reader = "urword"
  time_series = true
  longname = "rainfall rate"
  type = "string"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.perioddata.children.perioddata.children.sfrsetting.children.evaporation]
  block = "period"
  description = "real or character value that defines the volumetric rate per unit area of water subtracted by evaporation from the streamflow routing reach. A positive evaporation rate should be provided. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value. If the volumetric evaporation rate for a reach exceeds the sources of water to the reach (upstream and specified inflows, rainfall, and runoff but excluding groundwater leakage into the reach) the volumetric evaporation rate is limited to the sources of water to the reach. By default, evaporation rates are zero for each reach."
  reader = "urword"
  time_series = true
  longname = "evaporation rate"
  type = "string"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.perioddata.children.perioddata.children.sfrsetting.children.runoff]
  block = "period"
  description = "real or character value that defines the volumetric rate of diffuse overland runoff that enters the streamflow routing reach. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value. If the volumetric runoff rate for a reach is negative and exceeds inflows to the reach (upstream and specified inflows, and rainfall but excluding groundwater leakage into the reach) the volumetric runoff rate is limited to inflows to the reach and the volumetric evaporation rate for the reach is set to zero. By default, runoff rates are zero for each reach."
  reader = "urword"
  time_series = true
  longname = "runoff rate"
  type = "string"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.perioddata.children.perioddata.children.sfrsetting.children.diversionrecord]
  block = "period"
  reader = "urword"
  type = "record"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.perioddata.children.perioddata.children.sfrsetting.children.diversionrecord.children.diversion]
  block = "period"
  description = "keyword to indicate diversion record."
  reader = "urword"
  longname = "diversion keyword"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.perioddata.children.perioddata.children.sfrsetting.children.diversionrecord.children.idv]
  block = "diversions"
  description = "integer value that defines the downstream diversion number for the diversion for reach IFNO. IDV must be greater than zero and less than or equal to NDV for reach IFNO."
  reader = "urword"
  longname = "downstream diversion number"
  numeric_index = true
  type = "integer"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.perioddata.children.perioddata.children.sfrsetting.children.diversionrecord.children.divflow]
  block = "period"
  description = "real or character value that defines the volumetric diversion (DIVFLOW) rate for the streamflow routing reach. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "volumetric diversion flow rate"
  type = "double"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.perioddata.children.perioddata.children.sfrsetting.children.upstream_fraction]
  block = "period"
  description = "real value that defines the fraction of upstream flow (USTRF) from each upstream reach that is applied as upstream inflow to the reach. The sum of all USTRF values for all reaches connected to the same upstream reach must be equal to one."
  reader = "urword"
  longname = "fraction of upstream flow"
  type = "double"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.perioddata.children.perioddata.children.sfrsetting.children.cross_sectionrecord]
  block = "period"
  reader = "urword"
  type = "record"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.perioddata.children.perioddata.children.sfrsetting.children.cross_sectionrecord.children.cross_section]
  block = "period"
  description = "keyword to specify that record corresponds to a reach cross-section."
  reader = "urword"
  optional = false
  longname = "cross_section keyword"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.perioddata.children.perioddata.children.sfrsetting.children.cross_sectionrecord.children.tab6]
  block = "crosssections"
  description = "keyword to specify that record corresponds to a cross-section table file."
  reader = "urword"
  optional = false
  longname = "head keyword"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.perioddata.children.perioddata.children.sfrsetting.children.cross_sectionrecord.children.filein]
  block = "options"
  description = "keyword to specify that an input filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.perioddata.children.perioddata.children.sfrsetting.children.cross_sectionrecord.children.tab6_filename]
  block = "crosssections"
  description = "character string that defines the path and filename for the file containing cross-section table data for the reach. The TAB6_FILENAME file includes the number of entries in the file and the station elevation data in terms of the fractional width and the reach depth. Instructions for creating the TAB6_FILENAME input file are provided in SFR Reach Cross-Section Table Input File section."
  reader = "urword"
  optional = false
  longname = "table file name"
  type = "string"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.perioddata.children.perioddata.children.sfrsetting.children.auxiliaryrecord]
  block = "period"
  reader = "urword"
  type = "record"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.perioddata.children.perioddata.children.sfrsetting.children.auxiliaryrecord.children.auxiliary]
  block = "period"
  description = "keyword for specifying auxiliary variable."
  reader = "urword"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.perioddata.children.perioddata.children.sfrsetting.children.auxiliaryrecord.children.auxname]
  block = "period"
  description = "name for the auxiliary variable to be assigned AUXVAL.  AUXNAME must match one of the auxiliary variable names defined in the OPTIONS block. If AUXNAME does not match one of the auxiliary variable names defined in the OPTIONS block the data are ignored."
  reader = "urword"
  type = "string"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.perioddata.children.perioddata.children.sfrsetting.children.auxiliaryrecord.children.auxval]
  block = "period"
  description = "value for the auxiliary variable.  If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "auxiliary variable value"
  type = "double"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.ifno]
  shape = "(nper)"
  block = "period"
  description = "integer value that defines the feature (reach) number associated with the specified PERIOD data on the line. IFNO must be greater than zero and less than or equal to NREACHES."
  reader = "urword"
  longname = "reach number for this entry"
  numeric_index = true
  type = "integer"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.sfrsetting]
  shape = "(nper)"
  block = "period"
  description = "line of information that is parsed into a keyword and values.  Keyword values that can be used to start the SFRSETTING string include: STATUS, BEDK, MANNING, STAGE, INFLOW, RAINFALL, EVAPORATION, RUNOFF, DIVERSION, UPSTREAM_FRACTION, and AUXILIARY."
  reader = "urword"
  type = "union"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.sfrsetting.children.stage]
  block = "period"
  description = "real or character value that defines the stage for the reach. The specified STAGE is only applied if the reach uses the simple routing option. If STAGE is not specified for reaches that use the simple routing option, the specified stage is set to the top of the reach. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "reach stage"
  type = "string"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.sfrsetting.children.status]
  block = "period"
  description = "keyword option to define stream reach status.  STATUS can be ACTIVE, INACTIVE, or SIMPLE. The SIMPLE STATUS option simulates streamflow using a user-specified stage for a reach or a stage set to the top of the reach (depth = 0). In cases where the simulated leakage calculated using the specified stage exceeds the sum of inflows to the reach, the stage is set to the top of the reach and leakage is set equal to the sum of inflows. Upstream fractions should be changed using the UPSTREAM_FRACTION SFRSETTING if the status for one or more reaches is changed to ACTIVE or INACTIVE. For example, if one of two downstream connections for a reach is inactivated, the upstream fraction for the active and inactive downstream reach should be changed to 1.0 and 0.0, respectively, to ensure that the active reach receives all of the downstream outflow from the upstream reach. By default, STATUS is ACTIVE."
  reader = "urword"
  longname = "reach status"
  type = "string"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.sfrsetting.children.bedk]
  block = "period"
  description = "real or character value that defines the hydraulic conductivity of the reach streambed. BEDK can be any positive value if the reach is not connected to an underlying GWF cell. Otherwise, BEDK must be greater than zero. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "reach bed hydraulic conductivity"
  type = "string"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.sfrsetting.children.manning]
  block = "period"
  description = "real or character value that defines the Manning's roughness coefficient for the reach. MANNING must be greater than zero.  If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "reach Manning's roughness coefficient"
  type = "string"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.sfrsetting.children.inflow]
  block = "period"
  description = "real or character value that defines the volumetric inflow rate for the streamflow routing reach. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value. By default, inflow rates are zero for each reach."
  reader = "urword"
  time_series = true
  longname = "inflow rate"
  type = "string"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.sfrsetting.children.rainfall]
  block = "period"
  description = "real or character value that defines the  volumetric rate per unit area of water added by precipitation directly on the streamflow routing reach. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value. By default, rainfall  rates are zero for each reach."
  reader = "urword"
  time_series = true
  longname = "rainfall rate"
  type = "string"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.sfrsetting.children.evaporation]
  block = "period"
  description = "real or character value that defines the volumetric rate per unit area of water subtracted by evaporation from the streamflow routing reach. A positive evaporation rate should be provided. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value. If the volumetric evaporation rate for a reach exceeds the sources of water to the reach (upstream and specified inflows, rainfall, and runoff but excluding groundwater leakage into the reach) the volumetric evaporation rate is limited to the sources of water to the reach. By default, evaporation rates are zero for each reach."
  reader = "urword"
  time_series = true
  longname = "evaporation rate"
  type = "string"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.sfrsetting.children.runoff]
  block = "period"
  description = "real or character value that defines the volumetric rate of diffuse overland runoff that enters the streamflow routing reach. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value. If the volumetric runoff rate for a reach is negative and exceeds inflows to the reach (upstream and specified inflows, and rainfall but excluding groundwater leakage into the reach) the volumetric runoff rate is limited to inflows to the reach and the volumetric evaporation rate for the reach is set to zero. By default, runoff rates are zero for each reach."
  reader = "urword"
  time_series = true
  longname = "runoff rate"
  type = "string"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.sfrsetting.children.diversionrecord]
  block = "period"
  reader = "urword"
  type = "record"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.sfrsetting.children.diversionrecord.children.diversion]
  block = "period"
  description = "keyword to indicate diversion record."
  reader = "urword"
  longname = "diversion keyword"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.sfrsetting.children.diversionrecord.children.idv]
  block = "diversions"
  description = "integer value that defines the downstream diversion number for the diversion for reach IFNO. IDV must be greater than zero and less than or equal to NDV for reach IFNO."
  reader = "urword"
  longname = "downstream diversion number"
  numeric_index = true
  type = "integer"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.sfrsetting.children.diversionrecord.children.divflow]
  block = "period"
  description = "real or character value that defines the volumetric diversion (DIVFLOW) rate for the streamflow routing reach. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "volumetric diversion flow rate"
  type = "double"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.sfrsetting.children.upstream_fraction]
  block = "period"
  description = "real value that defines the fraction of upstream flow (USTRF) from each upstream reach that is applied as upstream inflow to the reach. The sum of all USTRF values for all reaches connected to the same upstream reach must be equal to one."
  reader = "urword"
  longname = "fraction of upstream flow"
  type = "double"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.sfrsetting.children.cross_sectionrecord]
  block = "period"
  reader = "urword"
  type = "record"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.sfrsetting.children.cross_sectionrecord.children.cross_section]
  block = "period"
  description = "keyword to specify that record corresponds to a reach cross-section."
  reader = "urword"
  optional = false
  longname = "cross_section keyword"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.sfrsetting.children.cross_sectionrecord.children.tab6]
  block = "crosssections"
  description = "keyword to specify that record corresponds to a cross-section table file."
  reader = "urword"
  optional = false
  longname = "head keyword"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.sfrsetting.children.cross_sectionrecord.children.filein]
  block = "options"
  description = "keyword to specify that an input filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-sfr.blocks.period.sfrsetting.children.cross_sectionrecord.children.tab6_filename]
  block = "crosssections"
  description = "character string that defines the path and filename for the file containing cross-section table data for the reach. The TAB6_FILENAME file includes the number of entries in the file and the station elevation data in terms of the fractional width and the reach depth. Instructions for creating the TAB6_FILENAME input file are provided in SFR Reach Cross-Section Table Input File section."
  reader = "urword"
  optional = false
  longname = "table file name"
  type = "string"
  
