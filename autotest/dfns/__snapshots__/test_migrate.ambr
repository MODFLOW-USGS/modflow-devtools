  block = "options"
  description = "keyword to specify that the record corresponds to the comma separated values solver convergence output."
  reader = "urword"
  optional = false
  longname = "budget keyword"
  type = "keyword"
  
  [children.sln-pts.blocks.options.csv_inner_output_filerecord.children.fileout]
  block = "options"
  description = "keyword to specify that an output filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.sln-pts.blocks.options.csv_inner_output_filerecord.children.inner_csvfile]
  block = "options"
  description = "name of the ascii comma separated values output file to write solver convergence information. Comma separated values output includes maximum dependent-variable (for example, head) change and maximum residual convergence information for the solution and each model (if the solution includes more than one model) and linear acceleration information for each inner iteration."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "string"
  
  [children.sln-pts.blocks.options.csv_inner_output]
  block = "options"
  description = "keyword to specify that the record corresponds to the comma separated values solver convergence output."
  reader = "urword"
  optional = false
  longname = "budget keyword"
  type = "keyword"
  
  [children.sln-pts.blocks.options.inner_csvfile]
  block = "options"
  description = "name of the ascii comma separated values output file to write solver convergence information. Comma separated values output includes maximum dependent-variable (for example, head) change and maximum residual convergence information for the solution and each model (if the solution includes more than one model) and linear acceleration information for each inner iteration."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "string"
  
  [children.sln-pts.blocks.options.no_ptcrecord]
  block = "options"
  reader = "urword"
  optional = true
  longname = "no_ptc record"
  type = "record"
  
  [children.sln-pts.blocks.options.no_ptcrecord.children.no_ptc]
  block = "options"
  description = "is a flag that is used to disable pseudo-transient continuation (PTC). Option only applies to steady-state stress periods for models using the Newton-Raphson formulation. For many problems, PTC can significantly improve convergence behavior for steady-state simulations, and for this reason it is active by default.  In some cases, however, PTC can worsen the convergence behavior, especially when the initial conditions are similar to the solution.  When the initial conditions are similar to, or exactly the same as, the solution and convergence is slow, then the NO_PTC FIRST option should be used to deactivate PTC for the first stress period.  The NO_PTC ALL option should also be used in order to compare convergence behavior with other MODFLOW versions, as PTC is only available in MODFLOW 6."
  reader = "urword"
  optional = false
  longname = "no pseudo-transient continuation"
  type = "keyword"
  
  [children.sln-pts.blocks.options.no_ptcrecord.children.no_ptc_option]
  block = "options"
  description = "is an optional keyword that is used to define options for disabling pseudo-transient continuation (PTC). FIRST is an optional keyword to disable PTC for the first stress period, if steady-state and one or more model is using the Newton-Raphson formulation. ALL is an optional keyword to disable PTC for all steady-state stress periods for models using the Newton-Raphson formulation. If NO_PTC_OPTION is not specified, the NO_PTC ALL option is used."
  reader = "urword"
  optional = true
  longname = "no pseudo-transient continuation option"
  type = "string"
  
  [children.sln-pts.blocks.options.no_ptc]
  block = "options"
  description = "is a flag that is used to disable pseudo-transient continuation (PTC). Option only applies to steady-state stress periods for models using the Newton-Raphson formulation. For many problems, PTC can significantly improve convergence behavior for steady-state simulations, and for this reason it is active by default.  In some cases, however, PTC can worsen the convergence behavior, especially when the initial conditions are similar to the solution.  When the initial conditions are similar to, or exactly the same as, the solution and convergence is slow, then the NO_PTC FIRST option should be used to deactivate PTC for the first stress period.  The NO_PTC ALL option should also be used in order to compare convergence behavior with other MODFLOW versions, as PTC is only available in MODFLOW 6."
  reader = "urword"
  optional = false
  longname = "no pseudo-transient continuation"
  type = "keyword"
  
  [children.sln-pts.blocks.options.no_ptc_option]
  block = "options"
  description = "is an optional keyword that is used to define options for disabling pseudo-transient continuation (PTC). FIRST is an optional keyword to disable PTC for the first stress period, if steady-state and one or more model is using the Newton-Raphson formulation. ALL is an optional keyword to disable PTC for all steady-state stress periods for models using the Newton-Raphson formulation. If NO_PTC_OPTION is not specified, the NO_PTC ALL option is used."
  reader = "urword"
  optional = true
  longname = "no pseudo-transient continuation option"
  type = "string"
  
  [children.sln-pts.blocks.options.ats_outer_maximum_fraction]
  block = "options"
  description = "real value defining the fraction of the maximum allowable outer iterations used with the Adaptive Time Step (ATS) capability if it is active.  If this value is set to zero by the user, then this solution will have no effect on ATS behavior.  This value must be greater than or equal to zero and less than or equal to 0.5 or the program will terminate with an error.  If it is not specified by the user, then it is assigned a default value of one third.  When the number of outer iterations for this solution is less than the product of this value and the maximum allowable outer iterations, then ATS will increase the time step length by a factor of DTADJ in the ATS input file.  When the number of outer iterations for this solution is greater than the maximum allowable outer iterations minus the product of this value and the maximum allowable outer iterations, then the ATS (if active) will decrease the time step length by a factor of 1 / DTADJ."
  reader = "urword"
  optional = true
  longname = "fraction of outer maximum used with ats"
  type = "double"
  
  [children.sln-pts.blocks.nonlinear.outer_maximum]
  block = "nonlinear"
  description = "integer value defining the maximum number of outer (nonlinear) iterations -- that is, calls to the solution routine. For a linear problem OUTER_MAXIMUM should be 1."
  reader = "urword"
  optional = false
  longname = "outer maximum iterations"
  type = "integer"
  
  [children.utl-tvk]
  name = "utl-tvk"
  schema_version = "1.2"
  parent = "sim-nam"
  advanced = false
  multi = false
  ftype = "TVK"
  
  [children.utl-tvk.blocks.options.print_input]
  block = "options"
  description = "keyword to indicate that information for each change to the hydraulic conductivity in a cell will be written to the model listing file."
  reader = "urword"
  optional = true
  longname = "print input to listing file"
  type = "keyword"
  
  [children.utl-tvk.blocks.options.ts_filerecord]
  block = "options"
  reader = "urword"
  optional = true
  type = "record"
  
  [children.utl-tvk.blocks.options.ts_filerecord.children.ts6]
  block = "options"
  description = "keyword to specify that record corresponds to a time-series file."
  reader = "urword"
  optional = false
  longname = "head keyword"
  type = "keyword"
  
  [children.utl-tvk.blocks.options.ts_filerecord.children.filein]
  block = "options"
  description = "keyword to specify that an input filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.utl-tvk.blocks.options.ts_filerecord.children.ts6_filename]
  block = "options"
  description = "defines a time-series file defining time series that can be used to assign time-varying values. See the 'Time-Variable Input' section for instructions on using the time-series capability."
  reader = "urword"
  optional = false
  longname = "file name of time series information"
  type = "string"
  
  [children.utl-tvk.blocks.options.ts6]
  block = "options"
  description = "keyword to specify that record corresponds to a time-series file."
  reader = "urword"
  optional = false
  longname = "head keyword"
  type = "keyword"
  
  [children.utl-tvk.blocks.options.filein]
  block = "options"
  description = "keyword to specify that an input filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.utl-tvk.blocks.options.ts6_filename]
  block = "options"
  description = "defines a time-series file defining time series that can be used to assign time-varying values. See the 'Time-Variable Input' section for instructions on using the time-series capability."
  reader = "urword"
  optional = false
  longname = "file name of time series information"
  type = "string"
  
  [children.utl-tvk.blocks.period.iper]
  shape = "(nper, nnodes)"
  block = "period"
  description = "integer value specifying the starting stress period number for which the data specified in the PERIOD block apply.  IPER must be less than or equal to NPER in the TDIS Package and greater than zero.  The IPER value assigned to a stress period block must be greater than the IPER value assigned for the previous PERIOD block.  The information specified in the PERIOD block will continue to apply for all subsequent stress periods, unless the program encounters another PERIOD block."
  block_variable = true
  reader = "urword"
  optional = false
  longname = "stress period number"
  type = "integer"
  
  [children.utl-tvk.blocks.period.perioddata]
  shape = "(nper, nnodes)"
  block = "period"
  reader = "urword"
  type = "list"
  
  [children.utl-tvk.blocks.period.perioddata.children.perioddata]
  type = "record"
  block = "period"
  reader = "urword"
  
  [children.utl-tvk.blocks.period.perioddata.children.perioddata.children.cellid]
  shape = "(ncelldim)"
  block = "period"
  description = "is the cell identifier, and depends on the type of grid that is used for the simulation.  For a structured grid that uses the DIS input file, CELLID is the layer, row, and column.   For a grid that uses the DISV input file, CELLID is the layer and CELL2D number.  If the model uses the unstructured discretization (DISU) input file, CELLID is the node number for the cell."
  reader = "urword"
  longname = "cell identifier"
  type = "integer"
  
  [children.utl-tvk.blocks.period.perioddata.children.perioddata.children.tvksetting]
  block = "period"
  description = "line of information that is parsed into a property name keyword and values.  Property name keywords that can be used to start the TVKSETTING string include: K, K22, and K33."
  reader = "urword"
  type = "union"
  
  [children.utl-tvk.blocks.period.perioddata.children.perioddata.children.tvksetting.children.k]
  block = "period"
  description = "is the new value to be assigned as the cell's hydraulic conductivity from the start of the specified stress period, as per K in the NPF package.  If the OPTIONS block includes a TS6 entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "hydraulic conductivity (L/T)"
  type = "double"
  
  [children.utl-tvk.blocks.period.perioddata.children.perioddata.children.tvksetting.children.k22]
  block = "period"
  description = "is the new value to be assigned as the cell's hydraulic conductivity of the second ellipsoid axis (or the ratio of K22/K if the K22OVERK NPF package option is specified) from the start of the specified stress period, as per K22 in the NPF package.  For an unrotated case this is the hydraulic conductivity in the y direction.  If the OPTIONS block includes a TS6 entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "hydraulic conductivity of second ellipsoid axis (L/T)"
  type = "double"
  
  [children.utl-tvk.blocks.period.perioddata.children.perioddata.children.tvksetting.children.k33]
  block = "period"
  description = "is the new value to be assigned as the cell's hydraulic conductivity of the third ellipsoid axis (or the ratio of K33/K if the K33OVERK NPF package option is specified) from the start of the specified stress period, as per K33 in the NPF package.  For an unrotated case, this is the vertical hydraulic conductivity.  If the OPTIONS block includes a TS6 entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "hydraulic conductivity of third ellipsoid axis (L/T)"
  type = "double"
  
  [children.utl-tvk.blocks.period.tvksetting]
  shape = "(nper, nnodes)"
  block = "period"
  description = "line of information that is parsed into a property name keyword and values.  Property name keywords that can be used to start the TVKSETTING string include: K, K22, and K33."
  reader = "urword"
  type = "union"
  
  [children.utl-tvk.blocks.period.tvksetting.children.k]
  block = "period"
  description = "is the new value to be assigned as the cell's hydraulic conductivity from the start of the specified stress period, as per K in the NPF package.  If the OPTIONS block includes a TS6 entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "hydraulic conductivity (L/T)"
  type = "double"
  
  [children.utl-tvk.blocks.period.tvksetting.children.k22]
  block = "period"
  description = "is the new value to be assigned as the cell's hydraulic conductivity of the second ellipsoid axis (or the ratio of K22/K if the K22OVERK NPF package option is specified) from the start of the specified stress period, as per K22 in the NPF package.  For an unrotated case this is the hydraulic conductivity in the y direction.  If the OPTIONS block includes a TS6 entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "hydraulic conductivity of second ellipsoid axis (L/T)"
  type = "double"
  
  [children.utl-tvk.blocks.period.tvksetting.children.k33]
  block = "period"
  description = "is the new value to be assigned as the cell's hydraulic conductivity of the third ellipsoid axis (or the ratio of K33/K if the K33OVERK NPF package option is specified) from the start of the specified stress period, as per K33 in the NPF package.  For an unrotated case, this is the vertical hydraulic conductivity.  If the OPTIONS block includes a TS6 entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "hydraulic conductivity of third ellipsoid axis (L/T)"
  type = "double"
  
  [children.utl-tvk.blocks.period.k]
  shape = "(nper, nnodes)"
  block = "period"
  description = "is the new value to be assigned as the cell's hydraulic conductivity from the start of the specified stress period, as per K in the NPF package.  If the OPTIONS block includes a TS6 entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "hydraulic conductivity (L/T)"
  type = "double"
  
  [children.utl-tvk.blocks.period.k22]
  shape = "(nper, nnodes)"
  block = "period"
  description = "is the new value to be assigned as the cell's hydraulic conductivity of the second ellipsoid axis (or the ratio of K22/K if the K22OVERK NPF package option is specified) from the start of the specified stress period, as per K22 in the NPF package.  For an unrotated case this is the hydraulic conductivity in the y direction.  If the OPTIONS block includes a TS6 entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "hydraulic conductivity of second ellipsoid axis (L/T)"
  type = "double"
  
  [children.utl-tvk.blocks.period.k33]
  shape = "(nper, nnodes)"
  block = "period"
  description = "is the new value to be assigned as the cell's hydraulic conductivity of the third ellipsoid axis (or the ratio of K33/K if the K33OVERK NPF package option is specified) from the start of the specified stress period, as per K33 in the NPF package.  For an unrotated case, this is the vertical hydraulic conductivity.  If the OPTIONS block includes a TS6 entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "hydraulic conductivity of third ellipsoid axis (L/T)"
  type = "double"
  
  [children.olf-nam]
  name = "olf-nam"
  schema_version = "1.2"
  parent = "sim-nam"
  advanced = false
  multi = false
  ftype = "NAM"
  
  [children.olf-nam.blocks.options.list]
  block = "options"
  description = "is name of the listing file to create for this OLF model.  If not specified, then the name of the list file will be the basename of the OLF model name file and the '.lst' extension.  For example, if the OLF name file is called 'my.model.nam' then the list file will be called 'my.model.lst'."
  reader = "urword"
  optional = true
  longname = "name of listing file"
  type = "string"
  
  [children.olf-nam.blocks.options.print_input]
  block = "options"
  description = "keyword to indicate that the list of all model stress package information will be written to the listing file immediately after it is read."
  reader = "urword"
  optional = true
  longname = "print input to listing file"
  type = "keyword"
  
  [children.olf-nam.blocks.options.print_flows]
  block = "options"
  description = "keyword to indicate that the list of all model package flow rates will be printed to the listing file for every stress period time step in which 'BUDGET PRINT' is specified in Output Control.  If there is no Output Control option and 'PRINT_FLOWS' is specified, then flow rates are printed for the last time step of each stress period."
  reader = "urword"
  optional = true
  longname = "print calculated flows to listing file"
  type = "keyword"
  
  [children.olf-nam.blocks.options.save_flows]
  block = "options"
  description = "keyword to indicate that all model package flow terms will be written to the file specified with 'BUDGET FILEOUT' in Output Control."
  reader = "urword"
  optional = true
  longname = "save flows for all packages to budget file"
  type = "keyword"
  
  [children.olf-nam.blocks.options.newtonoptions]
  block = "options"
  description = "none"
  reader = "urword"
  optional = true
  longname = "newton keyword and options"
  type = "record"
  
  [children.olf-nam.blocks.options.newtonoptions.children.newton]
  block = "options"
  description = "keyword that activates the Newton-Raphson formulation for surface water flow between connected reaches and stress packages that support calculation of Newton-Raphson terms."
  reader = "urword"
  longname = "keyword to activate Newton-Raphson formulation"
  type = "keyword"
  
  [children.olf-nam.blocks.options.newtonoptions.children.under_relaxation]
  block = "options"
  description = "keyword that indicates whether the surface water stage in a reach will be under-relaxed when water levels fall below the bottom of the model below any given cell. By default, Newton-Raphson UNDER_RELAXATION is not applied."
  reader = "urword"
  optional = true
  longname = "keyword to activate Newton-Raphson UNDER_RELAXATION option"
  type = "keyword"
  
  [children.olf-nam.blocks.options.newton]
  block = "options"
  description = "keyword that activates the Newton-Raphson formulation for surface water flow between connected reaches and stress packages that support calculation of Newton-Raphson terms."
  reader = "urword"
  longname = "keyword to activate Newton-Raphson formulation"
  type = "keyword"
  
  [children.olf-nam.blocks.options.under_relaxation]
  block = "options"
  description = "keyword that indicates whether the surface water stage in a reach will be under-relaxed when water levels fall below the bottom of the model below any given cell. By default, Newton-Raphson UNDER_RELAXATION is not applied."
  reader = "urword"
  optional = true
  longname = "keyword to activate Newton-Raphson UNDER_RELAXATION option"
  type = "keyword"
  
  [children.olf-nam.blocks.packages.packages]
  block = "packages"
  reader = "urword"
  optional = false
  longname = "package list"
  type = "list"
  
  [children.olf-nam.blocks.packages.packages.children.packages]
  block = "packages"
  reader = "urword"
  optional = false
  longname = "package list"
  type = "record"
  
  [children.olf-nam.blocks.packages.packages.children.packages.children.ftype]
  block = "packages"
  description = "is the file type, which must be one of the following character values shown in table~ref{table:ftype-olf}. Ftype may be entered in any combination of uppercase and lowercase."
  reader = "urword"
  longname = "package type"
  type = "string"
  
  [children.olf-nam.blocks.packages.packages.children.packages.children.fname]
  block = "packages"
  description = "is the name of the file containing the package input.  The path to the file should be included if the file is not located in the folder where the program was run."
  reader = "urword"
  longname = "file name"
  type = "string"
  
  [children.olf-nam.blocks.packages.packages.children.packages.children.pname]
  block = "packages"
  description = "is the user-defined name for the package. PNAME is restricted to 16 characters.  No spaces are allowed in PNAME.  PNAME character values are read and stored by the program for stress packages only.  These names may be useful for labeling purposes when multiple stress packages of the same type are located within a single OLF Model.  If PNAME is specified for a stress package, then PNAME will be used in the flow budget table in the listing file; it will also be used for the text entry in the cell-by-cell budget file.  PNAME is case insensitive and is stored in all upper case letters."
  reader = "urword"
  optional = true
  longname = "user name for package"
  type = "string"
  
  [children.olf-nam.blocks.packages.ftype]
  block = "packages"
  description = "is the file type, which must be one of the following character values shown in table~ref{table:ftype-olf}. Ftype may be entered in any combination of uppercase and lowercase."
  reader = "urword"
  longname = "package type"
  type = "string"
  
  [children.olf-nam.blocks.packages.fname]
  block = "packages"
  description = "is the name of the file containing the package input.  The path to the file should be included if the file is not located in the folder where the program was run."
  reader = "urword"
  longname = "file name"
  type = "string"
  
  [children.olf-nam.blocks.packages.pname]
  block = "packages"
  description = "is the user-defined name for the package. PNAME is restricted to 16 characters.  No spaces are allowed in PNAME.  PNAME character values are read and stored by the program for stress packages only.  These names may be useful for labeling purposes when multiple stress packages of the same type are located within a single OLF Model.  If PNAME is specified for a stress package, then PNAME will be used in the flow budget table in the listing file; it will also be used for the text entry in the cell-by-cell budget file.  PNAME is case insensitive and is stored in all upper case letters."
  reader = "urword"
  optional = true
  longname = "user name for package"
  type = "string"
  
  [children.olf-nam.children.olf-disv2d]
  name = "olf-disv2d"
  schema_version = "1.2"
  parent = "olf-nam"
  advanced = false
  multi = false
  ftype = "DISV2D"
  
  [children.olf-nam.children.olf-disv2d.blocks.options.length_units]
  block = "options"
  description = "is the length units used for this model.  Values can be 'FEET', 'METERS', or 'CENTIMETERS'.  If not specified, the default is 'UNKNOWN'."
  reader = "urword"
  optional = true
  longname = "model length units"
  type = "string"
  
  [children.olf-nam.children.olf-disv2d.blocks.options.nogrb]
  block = "options"
  description = "keyword to deactivate writing of the binary grid file."
  reader = "urword"
  optional = true
  longname = "do not write binary grid file"
  type = "keyword"
  
  [children.olf-nam.children.olf-disv2d.blocks.options.grb_filerecord]
  block = "options"
  reader = "urword"
  optional = true
  type = "record"
  
  [children.olf-nam.children.olf-disv2d.blocks.options.grb_filerecord.children.grb6]
  block = "options"
  description = "keyword to specify that record corresponds to a binary grid file."
  reader = "urword"
  optional = false
  longname = "grb keyword"
  type = "keyword"
  
  [children.olf-nam.children.olf-disv2d.blocks.options.grb_filerecord.children.fileout]
  block = "options"
  description = "keyword to specify that an output filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.olf-nam.children.olf-disv2d.blocks.options.grb_filerecord.children.grb6_filename]
  block = "options"
  description = "defines a binary grid output file. If this option is not provided, the output file will have the same name as the discretization input file, plus extension '.grb'."
  reader = "urword"
  optional = false
  longname = "file name of GRB information"
  type = "string"
  
  [children.olf-nam.children.olf-disv2d.blocks.options.grb6]
  block = "options"
  description = "keyword to specify that record corresponds to a binary grid file."
  reader = "urword"
  optional = false
  longname = "grb keyword"
  type = "keyword"
  
  [children.olf-nam.children.olf-disv2d.blocks.options.fileout]
  block = "options"
  description = "keyword to specify that an output filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.olf-nam.children.olf-disv2d.blocks.options.grb6_filename]
  block = "options"
  description = "defines a binary grid output file. If this option is not provided, the output file will have the same name as the discretization input file, plus extension '.grb'."
  reader = "urword"
  optional = false
  longname = "file name of GRB information"
  type = "string"
  
  [children.olf-nam.children.olf-disv2d.blocks.options.xorigin]
  block = "options"
  description = "x-position of the lower-left corner of the model grid.  A default value of zero is assigned if not specified.  The value for XORIGIN does not affect the model simulation, but it is written to the binary grid file so that postprocessors can locate the grid in space."
  reader = "urword"
  optional = true
  longname = "x-position of the model grid origin"
  type = "double"
  
  [children.olf-nam.children.olf-disv2d.blocks.options.yorigin]
  block = "options"
  description = "y-position of the lower-left corner of the model grid.  If not specified, then a default value equal to zero is used.  The value for YORIGIN does not affect the model simulation, but it is written to the binary grid file so that postprocessors can locate the grid in space."
  reader = "urword"
  optional = true
  longname = "y-position of the model grid origin"
  type = "double"
  
  [children.olf-nam.children.olf-disv2d.blocks.options.angrot]
  block = "options"
  description = "counter-clockwise rotation angle (in degrees) of the lower-left corner of the model grid.  If not specified, then a default value of 0.0 is assigned.  The value for ANGROT does not affect the model simulation, but it is written to the binary grid file so that postprocessors can locate the grid in space."
  reader = "urword"
  optional = true
  longname = "rotation angle"
  type = "double"
  
  [children.olf-nam.children.olf-disv2d.blocks.options.export_array_ascii]
  block = "options"
  description = "keyword that specifies input griddata arrays should be written to layered ascii output files."
  reader = "urword"
  optional = true
  mf6internal = "export_ascii"
  longname = "export array variables to layered ascii files."
  type = "keyword"
  
  [children.olf-nam.children.olf-disv2d.blocks.options.crs]
  shape = "lenbigline"
  block = "options"
  description = "is a real-world coordinate reference system (CRS) for the model, for example, an EPSG integer code (e.g. 26915), authority string (i.e. epsg:26915), or Open Geospatial Consortium Well-Known Text (WKT) specification. Limited to 5000 characters. The entry for CRS does not affect the model simulation, but it is written to the binary grid file so that postprocessors can locate the grid in space."
  reader = "urword"
  optional = true
  developmode = true
  longname = "CRS user input string"
  type = "string"
  
  [children.olf-nam.children.olf-disv2d.blocks.dimensions.nodes]
  block = "dimensions"
  description = "is the number of cells per layer.  This is a constant value for the grid and it applies to all layers."
  reader = "urword"
  optional = false
  longname = "number of cells per layer"
  type = "integer"
  
  [children.olf-nam.children.olf-disv2d.blocks.dimensions.nvert]
  block = "dimensions"
  description = "is the total number of (x, y) vertex pairs used to characterize the horizontal configuration of the model grid."
  reader = "urword"
  optional = false
  longname = "number of columns"
  type = "integer"
  
  [children.olf-nam.children.olf-disv2d.blocks.griddata.bottom]
  shape = "(nodes)"
  block = "griddata"
  description = "is the bottom elevation for each cell."
  reader = "readarray"
  layered = false
  longname = "model bottom elevation"
  type = "double"
  
  [children.olf-nam.children.olf-disv2d.blocks.griddata.idomain]
  shape = "(nodes)"
  block = "griddata"
  description = "is an optional array that characterizes the existence status of a cell.  If the IDOMAIN array is not specified, then all model cells exist within the solution.  If the IDOMAIN value for a cell is 0, the cell does not exist in the simulation.  Input and output values will be read and written for the cell, but internal to the program, the cell is excluded from the solution.  If the IDOMAIN value for a cell is 1 or greater, the cell exists in the simulation.  If the IDOMAIN value for a cell is -1, the cell does not exist in the simulation.  Furthermore, the first existing cell above will be connected to the first existing cell below.  This type of cell is referred to as a 'vertical pass through' cell."
  reader = "readarray"
  layered = false
  optional = true
  longname = "idomain existence array"
  type = "integer"
  
  [children.olf-nam.children.olf-disv2d.blocks.vertices.vertices]
  shape = "(nvert)"
  block = "vertices"
  reader = "urword"
  optional = false
  longname = "vertices data"
  type = "list"
  
  [children.olf-nam.children.olf-disv2d.blocks.vertices.vertices.children.vertices]
  shape = "(nvert)"
  block = "vertices"
  reader = "urword"
  optional = false
  longname = "vertices data"
  type = "record"
  
  [children.olf-nam.children.olf-disv2d.blocks.vertices.vertices.children.vertices.children.iv]
  block = "vertices"
