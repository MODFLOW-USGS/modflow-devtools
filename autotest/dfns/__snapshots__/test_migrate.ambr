  [children.chf-nam.children.chf-flw.blocks.period.iper]
  shape = "(nper, nnodes)"
  block = "period"
  description = "integer value specifying the starting stress period number for which the data specified in the PERIOD block apply.  IPER must be less than or equal to NPER in the TDIS Package and greater than zero.  The IPER value assigned to a stress period block must be greater than the IPER value assigned for the previous PERIOD block.  The information specified in the PERIOD block will continue to apply for all subsequent stress periods, unless the program encounters another PERIOD block."
  block_variable = true
  reader = "urword"
  optional = false
  longname = "stress period number"
  type = "integer"
  
  [children.chf-nam.children.chf-flw.blocks.period.stress_period_data]
  shape = "(nper, nnodes)"
  block = "period"
  reader = "urword"
  mf6internal = "spd"
  type = "list"
  
  [children.chf-nam.children.chf-flw.blocks.period.stress_period_data.children.stress_period_data]
  shape = "(maxbound)"
  block = "period"
  reader = "urword"
  mf6internal = "spd"
  type = "record"
  
  [children.chf-nam.children.chf-flw.blocks.period.stress_period_data.children.stress_period_data.children.cellid]
  shape = "(ncelldim)"
  block = "period"
  description = "is the cell identifier, and depends on the type of grid that is used for the simulation.  For a structured grid that uses the DIS input file, CELLID is the layer, row, and column.   For a grid that uses the DISV input file, CELLID is the layer and CELL2D number.  If the model uses the unstructured discretization (DISU) input file, CELLID is the node number for the cell."
  reader = "urword"
  longname = "cell identifier"
  type = "integer"
  
  [children.chf-nam.children.chf-flw.blocks.period.stress_period_data.children.stress_period_data.children.q]
  block = "period"
  description = "is the volumetric inflow rate. A positive value indicates inflow to the stream.  Negative values are not allows. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "well rate"
  type = "double"
  
  [children.chf-nam.children.chf-flw.blocks.period.stress_period_data.children.stress_period_data.children.aux]
  shape = "(naux)"
  block = "period"
  description = "represents the values of the auxiliary variables for each inflow. The values of auxiliary variables must be present for each inflow. The values must be specified in the order of the auxiliary variables specified in the OPTIONS block.  If the package supports time series and the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  optional = true
  time_series = true
  longname = "auxiliary variables"
  type = "double"
  
  [children.chf-nam.children.chf-flw.blocks.period.stress_period_data.children.stress_period_data.children.boundname]
  block = "period"
  description = "name of the inflow cell.  BOUNDNAME is an ASCII character variable that can contain as many as 40 characters.  If BOUNDNAME contains spaces in it, then the entire name must be enclosed within single quotes."
  reader = "urword"
  optional = true
  longname = "inflow name"
  type = "string"
  
  [children.chf-nam.children.chf-flw.blocks.period.q]
  shape = "(nper, nnodes)"
  block = "period"
  description = "is the volumetric inflow rate. A positive value indicates inflow to the stream.  Negative values are not allows. If the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  time_series = true
  longname = "well rate"
  type = "double"
  
  [children.chf-nam.children.chf-flw.blocks.period.aux]
  shape = "(nper, nnodes, naux)"
  block = "period"
  description = "represents the values of the auxiliary variables for each inflow. The values of auxiliary variables must be present for each inflow. The values must be specified in the order of the auxiliary variables specified in the OPTIONS block.  If the package supports time series and the Options block includes a TIMESERIESFILE entry (see the 'Time-Variable Input' section), values can be obtained from a time series by entering the time-series name in place of a numeric value."
  reader = "urword"
  optional = true
  time_series = true
  longname = "auxiliary variables"
  type = "double"
  
  [children.chf-nam.children.chf-flw.blocks.period.boundname]
  shape = "(nper, nnodes)"
  block = "period"
  description = "name of the inflow cell.  BOUNDNAME is an ASCII character variable that can contain as many as 40 characters.  If BOUNDNAME contains spaces in it, then the entire name must be enclosed within single quotes."
  reader = "urword"
  optional = true
  longname = "inflow name"
  type = "string"
  
  [children.chf-nam.children.chf-pcp]
  name = "chf-pcp"
  schema_version = "1.2"
  parent = "chf-nam"
  advanced = false
  multi = true
  ftype = "PCP"
  
  [children.chf-nam.children.chf-pcp.blocks.options.auxiliary]
  shape = "(naux)"
  block = "options"
  description = "defines an array of one or more auxiliary variable names.  There is no limit on the number of auxiliary variables that can be provided on this line; however, lists of information provided in subsequent blocks must have a column of data for each auxiliary variable name defined here.   The number of auxiliary variables detected on this line determines the value for naux.  Comments cannot be provided anywhere on this line as they will be interpreted as auxiliary variable names.  Auxiliary variables may not be used by the package, but they will be available for use by other parts of the program.  The program will terminate with an error if auxiliary variables are specified on more than one line in the options block."
  reader = "urword"
  optional = true
  longname = "keyword to specify aux variables"
  type = "string"
  
  [children.chf-nam.children.chf-pcp.blocks.options.auxmultname]
  block = "options"
  description = "name of auxiliary variable to be used as multiplier of precipitation."
  reader = "urword"
  optional = true
  longname = "name of auxiliary variable for multiplier"
  type = "string"
  
  [children.chf-nam.children.chf-pcp.blocks.options.boundnames]
  block = "options"
  description = "keyword to indicate that boundary names may be provided with the list of precipitation cells."
  reader = "urword"
  optional = true
  type = "keyword"
  
  [children.chf-nam.children.chf-pcp.blocks.options.print_input]
  block = "options"
  description = "keyword to indicate that the list of precipitation information will be written to the listing file immediately after it is read."
  reader = "urword"
  optional = true
  longname = "print input to listing file"
  mf6internal = "iprpak"
  type = "keyword"
  
  [children.chf-nam.children.chf-pcp.blocks.options.print_flows]
  block = "options"
  description = "keyword to indicate that the list of precipitation flow rates will be printed to the listing file for every stress period time step in which 'BUDGET PRINT' is specified in Output Control.  If there is no Output Control option and 'PRINT_FLOWS' is specified, then flow rates are printed for the last time step of each stress period."
  reader = "urword"
  optional = true
  longname = "print precipitation rates to listing file"
  mf6internal = "iprflow"
  type = "keyword"
  
  [children.chf-nam.children.chf-pcp.blocks.options.save_flows]
  block = "options"
  description = "keyword to indicate that precipitation flow terms will be written to the file specified with 'BUDGET FILEOUT' in Output Control."
  reader = "urword"
  optional = true
  longname = "save precipitation to budget file"
  mf6internal = "ipakcb"
  type = "keyword"
  
  [children.chf-nam.children.chf-pcp.blocks.options.ts_filerecord]
  block = "options"
  reader = "urword"
  optional = true
  type = "record"
  
  [children.chf-nam.children.chf-pcp.blocks.options.ts_filerecord.children.ts6]
  block = "options"
  description = "keyword to specify that record corresponds to a time-series file."
  reader = "urword"
  optional = false
  longname = "head keyword"
  type = "keyword"
  
  [children.chf-nam.children.chf-pcp.blocks.options.ts_filerecord.children.filein]
  block = "options"
  description = "keyword to specify that an input filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.chf-nam.children.chf-pcp.blocks.options.ts_filerecord.children.ts6_filename]
