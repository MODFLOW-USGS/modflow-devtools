  reader = "urword"
  optional = false
  longname = "budget keyword"
  mf6internal = "csvinterbed"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-csub.blocks.options.fileout]
  block = "options"
  description = "keyword to specify that an output filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-csub.blocks.options.interbedstrain_filename]
  block = "options"
  description = "name of the comma-separated-values output file to write final interbed strain information."
  reader = "urword"
  optional = false
  longname = "file keyword"
  mf6internal = "interbedstrainfn"
  type = "string"
  
  [children.gwf-nam.children.gwf-csub.blocks.options.straincg_filerecord]
  block = "options"
  reader = "urword"
  optional = true
  mf6internal = "straincgfr"
  type = "record"
  
  [children.gwf-nam.children.gwf-csub.blocks.options.straincg_filerecord.children.strain_csv_coarse]
  block = "options"
  description = "keyword to specify the record that corresponds to final coarse-grained material strain output."
  reader = "urword"
  optional = false
  longname = "budget keyword"
  mf6internal = "csvcoarse"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-csub.blocks.options.straincg_filerecord.children.fileout]
  block = "options"
  description = "keyword to specify that an output filename is expected next."
  reader = "urword"
  optional = false
  longname = "file keyword"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-csub.blocks.options.straincg_filerecord.children.coarsestrain_filename]
  block = "options"
  description = "name of the comma-separated-values output file to write final coarse-grained material strain information."
  reader = "urword"
  optional = false
  longname = "file keyword"
  mf6internal = "coarsestrainfn"
  type = "string"
  
  [children.gwf-nam.children.gwf-csub.blocks.options.strain_csv_coarse]
  block = "options"
  description = "keyword to specify the record that corresponds to final coarse-grained material strain output."
  reader = "urword"
  optional = false
  longname = "budget keyword"
  mf6internal = "csvcoarse"
  type = "keyword"
  
  [children.gwf-nam.children.gwf-csub.blocks.options.coarsestrain_filename]
  block = "options"
  description = "name of the comma-separated-values output file to write final coarse-grained material strain information."
  reader = "urword"
  optional = false
  longname = "file keyword"
  mf6internal = "coarsestrainfn"
  type = "string"
  
  [children.gwf-nam.children.gwf-csub.blocks.options.compaction_filerecord]
